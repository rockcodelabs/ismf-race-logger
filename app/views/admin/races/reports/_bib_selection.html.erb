<% if report.bib_number.nil? %>
  <!-- Bib Number Selection Card (shown only when bib is NN) -->
  <div class="card border-2 border-orange-300 bg-orange-50">
    <div class="p-6">
      <div class="flex items-center gap-3 mb-4">
        <div class="w-10 h-10 rounded-full bg-orange-500 flex items-center justify-center">
          <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <div>
          <h3 class="text-lg font-semibold text-orange-900">Bib Number Not Set</h3>
          <p class="text-sm text-orange-700">Select the athlete's bib number below</p>
        </div>
      </div>

      <!-- Participant Grid -->
      <div class="bg-white rounded-lg p-4 max-h-96 overflow-y-auto">
        <div class="grid grid-cols-3 gap-2">
          <% participations.each do |participation| %>
            <%= form_with url: update_bib_admin_race_report_path(race, report),
                          method: :patch,
                          class: "contents" do |f| %>
              <%= f.hidden_field :race_participation_id, value: participation.id %>
              <%= f.hidden_field :bib_number, value: participation.bib_number %>

              <%= f.button type: :submit,
                           class: "flex flex-col items-center justify-center p-3 rounded-lg bg-white border-2 border-gray-200 transition-all hover:border-ismf-blue hover:shadow-md hover:scale-105 active:scale-95" do %>
                <span class="text-2xl font-black text-ismf-navy mb-1"><%= participation.bib_number %></span>
                <span class="text-xs text-gray-600 truncate w-full text-center font-medium">
                  <%= participation.athlete&.last_name || 'Unknown' %>
                </span>
                <% if participation.athlete&.country.present? %>
                  <span class="text-xs text-gray-400 mt-0.5">
                    <%= participation.athlete.country %>
                  </span>
                <% end %>
              <% end %>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
<% else %>
  <!-- Change Athlete Card (shown when bib is already set) -->
  <details class="card border border-gray-200 group">
    <summary class="p-4 cursor-pointer hover:bg-gray-50 transition-colors list-none">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-3">
          <div class="w-8 h-8 rounded-full bg-gray-100 flex items-center justify-center">
            <svg class="w-4 h-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" />
            </svg>
          </div>
          <div>
            <h3 class="text-sm font-semibold text-ismf-navy">Change Athlete</h3>
            <p class="text-xs text-ismf-gray">Currently assigned to Bib #<%= report.bib_number %></p>
          </div>
        </div>
        <svg class="w-5 h-5 text-gray-400 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
        </svg>
      </div>
    </summary>

    <div class="px-4 pb-4 pt-2 border-t border-gray-100">
      <p class="text-xs text-amber-700 bg-amber-50 border border-amber-200 rounded-md px-3 py-2 mb-3">
        Select a different athlete to reassign this report.
      </p>

      <div class="bg-white rounded-lg max-h-72 overflow-y-auto border border-gray-100">
        <div class="grid grid-cols-3 gap-2 p-3">
          <% participations.each do |participation| %>
            <% is_current = participation.bib_number == report.bib_number %>
            <%= form_with url: update_bib_admin_race_report_path(race, report),
                          method: :patch,
                          class: "contents" do |f| %>
              <%= f.hidden_field :race_participation_id, value: participation.id %>
              <%= f.hidden_field :bib_number, value: participation.bib_number %>

              <%= f.button type: :submit,
                           disabled: is_current,
                           class: "flex flex-col items-center justify-center p-3 rounded-lg border-2 transition-all #{is_current ? 'border-ismf-blue bg-blue-50 cursor-default opacity-75' : 'border-gray-200 bg-white hover:border-ismf-blue hover:shadow-md hover:scale-105 active:scale-95'}" do %>
                <span class="text-2xl font-black mb-1 <%= is_current ? 'text-ismf-blue' : 'text-ismf-navy' %>"><%= participation.bib_number %></span>
                <span class="text-xs truncate w-full text-center font-medium <%= is_current ? 'text-ismf-blue' : 'text-gray-600' %>">
                  <%= participation.athlete&.last_name || 'Unknown' %>
                </span>
                <% if participation.athlete&.country.present? %>
                  <span class="text-xs mt-0.5 <%= is_current ? 'text-blue-400' : 'text-gray-400' %>">
                    <%= participation.athlete.country %>
                  </span>
                <% end %>
                <% if is_current %>
                  <span class="text-[10px] font-bold text-ismf-blue mt-1 uppercase tracking-wide">Current</span>
                <% end %>
              <% end %>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  </details>
<% end %>

<!-- Change Race Location Card (always available) -->
<% if defined?(race_locations) && race_locations.present? %>
  <details class="card border border-gray-200 group">
    <summary class="p-4 cursor-pointer hover:bg-gray-50 transition-colors list-none">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-3">
          <div class="w-8 h-8 rounded-full bg-gray-100 flex items-center justify-center">
            <svg class="w-4 h-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </div>
          <div>
            <h3 class="text-sm font-semibold text-ismf-navy">Change Location</h3>
            <p class="text-xs text-ismf-gray">Currently: <%= report.location_name %></p>
          </div>
        </div>
        <svg class="w-5 h-5 text-gray-400 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
        </svg>
      </div>
    </summary>

    <div class="px-4 pb-4 pt-2 border-t border-gray-100">
      <p class="text-xs text-amber-700 bg-amber-50 border border-amber-200 rounded-md px-3 py-2 mb-3">
        Select a different location to reassign this report.
      </p>

      <div class="bg-white rounded-lg max-h-48 overflow-y-auto border border-gray-100">
        <div class="grid grid-cols-2 gap-2 p-3">
          <% race_locations.each do |location| %>
            <% is_current = location.id == report.race_location_id %>
            <%= form_with url: update_location_admin_race_report_path(race, report),
                          method: :patch,
                          class: "contents" do |f| %>
              <%= f.hidden_field :race_location_id, value: location.id %>

              <%= f.button type: :submit,
                           disabled: is_current,
                           class: "flex flex-col items-center justify-center p-3 rounded-lg border-2 transition-all #{is_current ? 'border-ismf-blue bg-blue-50 cursor-default opacity-75' : 'border-gray-200 bg-white hover:border-ismf-blue hover:shadow-md hover:scale-105 active:scale-95'}" do %>
                <span class="text-sm font-semibold text-center <%= is_current ? 'text-ismf-blue' : 'text-ismf-navy' %>">
                  <%= location.name %>
                </span>
                <% if is_current %>
                  <span class="text-[10px] font-bold text-ismf-blue mt-1 uppercase tracking-wide">Current</span>
                <% end %>
              <% end %>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  </details>
<% end %>