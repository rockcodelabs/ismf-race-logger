<%# Merged Reports Section — shows secondary reports grouped into the same incident %>
<%# Locals: merged_reports (Array<Parts::Report>), race, report (current primary), incident %>

<% if merged_reports.any? %>
  <div class="card" id="merged-reports-section">
    <div class="p-6">
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-lg font-semibold text-ismf-navy flex items-center gap-2">
          <svg class="w-5 h-5 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
          Merged Reports
          <span class="text-sm font-normal text-ismf-gray">(<%= merged_reports.size %>)</span>
        </h3>
      </div>

      <div class="space-y-3">
        <% merged_reports.each do |merged| %>
          <div class="flex items-start gap-3 p-3 bg-purple-50 border border-purple-200 rounded-lg">
            <!-- Bib badge -->
            <span class="shrink-0 inline-flex items-center justify-center w-9 h-9 rounded-full bg-ismf-navy text-white font-bold text-sm">
              <%= merged.bib_badge %>
            </span>

            <!-- Report info -->
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2 flex-wrap">
                <span class="text-sm font-medium text-ismf-navy">
                  <%= merged.location_name %>
                </span>
                <span class="text-xs text-gray-500">
                  <%= merged.created_at_with_seconds %>
                </span>
              </div>

              <div class="flex items-center gap-3 mt-1">
                <!-- Reporter -->
                <span class="flex items-center gap-1 text-xs text-ismf-gray">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                  </svg>
                  <%= merged.reporter_name_display %>
                </span>

                <!-- Videos -->
                <% if merged.has_videos? %>
                  <span class="flex items-center gap-1 text-xs text-blue-700">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
                    </svg>
                    <%= merged.videos_count %> <%= merged.videos_count == 1 ? "video" : "videos" %>
                  </span>
                <% end %>
              </div>
            </div>

            <!-- Link to merged report -->
            <%= link_to admin_race_report_path(race, merged),
                        class: "shrink-0 inline-flex items-center justify-center w-8 h-8 rounded-lg text-gray-400 hover:text-purple-600 hover:bg-purple-100 transition-all",
                        title: "View Report ##{merged.id}" do %>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
<% end %>

<%# Add Another Report section — only when incident is still pending decision %>
<% if defined?(incident) && incident.present? && incident.pending? && defined?(available_for_merge) && available_for_merge.any? %>
  <div class="card" id="add-report-section">
    <div class="p-6">
      <h3 class="text-lg font-semibold text-ismf-navy mb-4 flex items-center gap-2">
        <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
        </svg>
        Add Another Report
      </h3>

      <%= form_with url: merge_admin_race_reports_path(race), method: :post, local: true do |f| %>
        <%= hidden_field_tag "report_ids[]", report.id %>

        <div class="space-y-3">
          <div>
            <label for="add_report_select" class="block text-sm font-medium text-ismf-gray mb-1">
              Select a report to merge into this incident
            </label>
            <select name="report_ids[]"
                    id="add_report_select"
                    required
                    class="block w-full rounded-md border-gray-300 shadow-sm focus:border-ismf-blue focus:ring-ismf-blue text-sm">
              <option value="">— choose a report —</option>
              <% available_for_merge.each do |avail| %>
                <option value="<%= avail.id %>">
                  #<%= avail.id %> · Bib <%= avail.bib_number || "NN" %> · <%= avail.location_name %> · <%= avail.created_at_with_seconds %> · by <%= avail.reporter_name_display %>
                </option>
              <% end %>
            </select>
          </div>

          <button type="submit"
                  class="w-full flex items-center justify-center gap-2 px-4 py-2.5 rounded-lg bg-green-500 hover:bg-green-600 text-white font-medium text-sm transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
            Merge Into This Incident
          </button>
        </div>
      <% end %>
    </div>
  </div>
<% end %>