<tr class="<%= report.row_class %> hover:bg-gray-50 transition-all duration-200 relative cursor-pointer"
    id="report_<%= report.id %>"
    data-report-selection-target="row"
    data-controller="video-upload"
    data-video-upload-report-id-value="<%= report.id %>"
    data-video-upload-race-id-value="<%= race.id %>"
    data-video-upload-direct-upload-url-value="<%= rails_direct_uploads_url %>"
    data-video-upload-attach-url-value="<%= admin_race_report_videos_path(race, report) %>"
    data-action="dragenter->video-upload#dragEnter
                 dragover->video-upload#dragOver
                 dragleave->video-upload#dragLeave
                 drop->video-upload#drop"
    onclick="if (!event.target.closest('a, button, input, select, textarea')) { Turbo.visit('<%= admin_race_report_path(race, report) %>'); }"
    title="Click to view report details">

  <% if policy(report).select? %>
    <td>
      <input type="checkbox"
             data-report-selection-target="checkbox"
             data-report-id="<%= report.id %>"
             data-incident-id="<%= report.incident_id %>"
             data-incident-status="<%= report.respond_to?(:incident_status) ? report.incident_status : '' %>"
             data-has-decision="<%= report.respond_to?(:incident_has_decision?) ? report.incident_has_decision? : false %>"
             data-action="change->report-selection#updateSelection"
             class="w-4 h-4 rounded border-gray-300 text-ismf-blue focus:ring-ismf-blue">
    </td>
  <% end %>

  <%# Bib %>
  <td>
    <span class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-ismf-navy text-white font-bold text-sm">
      <%= report.bib_badge %>
    </span>
    <% if report.respond_to?(:merged_reports_count) && report.merged_reports_count.to_i > 0 %>
      <div class="mt-1">
        <span class="inline-flex items-center px-1.5 py-0.5 rounded text-xs font-medium bg-purple-100 text-purple-700"
              title="<%= report.merged_reports_count %> additional report(s) merged into this incident">
          +<%= report.merged_reports_count %>
        </span>
      </div>
    <% end %>
  </td>

  <%# Athlete: name, gender badge, country flag %>
  <td>
    <div class="font-medium text-ismf-navy text-sm">
      <%= report.athlete_name_display %>
    </div>
    <div class="flex items-center gap-1.5 mt-1 flex-wrap">
      <% if report.respond_to?(:athlete_gender) && report.athlete_gender.present? %>
        <span class="inline-flex items-center px-1.5 py-0.5 rounded text-xs font-semibold <%= report.respond_to?(:gender_badge_class) ? report.gender_badge_class : 'bg-gray-100 text-gray-600' %>">
          <%= report.athlete_gender %>
        </span>
      <% end %>
      <% if report.respond_to?(:athlete_country) && report.athlete_country.present? %>
        <span class="text-xs text-gray-600 font-medium">
          <%= report.respond_to?(:country_flag) ? report.country_flag(report.athlete_country) : '' %>
          <%= report.athlete_country %>
        </span>
      <% end %>
    </div>
  </td>

  <%# Location / Time %>
  <td class="text-ismf-gray text-sm">
    <div><%= report.location_name %></div>
    <div class="text-xs text-gray-500">
      <%= report.created_at_with_seconds %>
      <span class="text-gray-400">(<%= report.time_ago %>)</span>
    </div>
  </td>

  <%# Reporter %>
  <td class="text-ismf-gray text-sm">
    <%= report.reporter_name_display %>
  </td>

  <%# Status %>
  <td>
    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= report.status_badge[:class] %>">
      <%= report.status_badge[:label] %>
    </span>
    <%# Show incident status badge when confirmed %>
    <% if report.linked_to_incident? && report.respond_to?(:incident_status) && report.incident_status.present? %>
      <div class="mt-1">
        <%
          incident_badge = case report.incident_status
          when "pending"   then { class: "bg-yellow-100 text-yellow-800", label: "Pending Jury" }
          when "approved"  then { class: "bg-green-100 text-green-800",   label: "Approved" }
          when "rejected"  then { class: "bg-red-100 text-red-800",       label: "Rejected" }
          else                  { class: "bg-gray-100 text-gray-800",     label: report.incident_status.titleize }
          end
        %>
        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium <%= incident_badge[:class] %>">
          <%= incident_badge[:label] %>
        </span>
      </div>
    <% end %>
  </td>

  <%# Videos %>
  <td>
    <% if report.has_videos? %>
      <div class="flex items-center gap-2">
        <div class="flex items-center gap-1 px-1.5 py-0.5 bg-blue-50 rounded-full">
          <svg class="w-3.5 h-3.5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
          </svg>
          <span class="text-xs font-semibold text-blue-700"><%= report.videos_count %></span>
        </div>
        <%= turbo_frame_tag "report_#{report.id}_video_thumbnails", src: video_thumbnails_admin_race_report_path(race, report), loading: :lazy do %>
          <div class="flex gap-1">
            <% 2.times do %>
              <div class="inline-block w-10 h-10 rounded border border-gray-200 overflow-hidden bg-gradient-to-br from-gray-100 to-gray-200 animate-pulse">
                <div class="w-full h-full flex items-center justify-center">
                  <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
                  </svg>
                </div>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="flex items-center gap-2 text-gray-400">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
        </svg>
        <span class="text-xs italic">Drop videos here</span>
      </div>
    <% end %>
  </td>

  <%# Actions %>
  <td class="text-right">
    <div class="flex items-center justify-end gap-0.5">
      <%= link_to admin_race_report_path(race, report), class: "inline-flex items-center justify-center w-8 h-8 rounded-lg text-gray-500 hover:text-ismf-blue hover:bg-blue-50 transition-all", title: "View" do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
        </svg>
      <% end %>
      <% if report.can_confirm? && policy(report).confirm? %>
        <%= button_to confirm_admin_race_report_path(race, report), method: :post, class: "inline-flex items-center justify-center w-8 h-8 rounded-lg text-gray-500 hover:text-green-600 hover:bg-green-50 transition-all", title: "Confirm" do %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
          </svg>
        <% end %>
      <% end %>
      <% if report.can_confirm? && policy(report).reject? %>
        <%= button_to reject_admin_race_report_path(race, report), method: :post, class: "inline-flex items-center justify-center w-8 h-8 rounded-lg text-gray-500 hover:text-red-600 hover:bg-red-50 transition-all", title: "Reject" do %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        <% end %>
      <% end %>
      <% if report.can_reopen? %>
        <%= button_to reopen_admin_race_report_path(race, report), method: :post, class: "inline-flex items-center justify-center w-8 h-8 rounded-lg text-gray-500 hover:text-yellow-600 hover:bg-yellow-50 transition-all", title: "Reopen" do %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
          </svg>
        <% end %>
      <% end %>
    </div>
  </td>
</tr>