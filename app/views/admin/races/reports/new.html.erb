<div class="h-[calc(100vh-4rem)] flex flex-col bg-gray-50" data-controller="report-form">
  <!-- Header -->
  <div class="shrink-0 bg-white border-b border-gray-200 px-6 py-4">
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-4">
        <%= link_to admin_race_reports_path(@race), class: "p-2 hover:bg-gray-100 rounded-lg transition-colors" do %>
          <svg class="w-6 h-6 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
        <% end %>
        <div>
          <h1 class="text-2xl font-bold text-ismf-navy">Reports</h1>
          <p class="text-sm text-gray-500"><%= @race.name %></p>
        </div>
      </div>
      <div class="flex items-center gap-4">
        <%= link_to admin_race_incidents_path(@race), class: "flex items-center gap-2 px-4 py-2 bg-orange-100 text-orange-700 rounded-lg font-semibold hover:bg-orange-200 transition-colors" do %>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
          </svg>
          Incidents
        <% end %>
      </div>
    </div>
  </div>

  <!-- Status Banner -->
  <div class="shrink-0 bg-gray-200 px-6 py-3 border-b border-gray-300" data-report-form-target="banner">
    <p class="text-sm font-medium text-gray-600">
      <span class="text-gray-400" data-report-form-target="bannerText">Select a location first</span>
    </p>
  </div>

  <!-- Main Content: Split Screen -->
  <div class="flex-1 flex overflow-hidden">
    
    <!-- Left: Location Sidebar -->
    <div class="w-64 shrink-0 bg-white border-r border-gray-200 flex flex-col">
      <div class="px-4 py-3 border-b border-gray-200 bg-gray-50">
        <h2 class="text-sm font-bold text-gray-700 uppercase tracking-wide">Select Location</h2>
      </div>
      <div class="flex-1 overflow-y-auto p-3 space-y-2">
        <!-- NN Unknown Location Button -->
        <button type="button"
                class="location-btn w-full px-4 py-3 rounded-lg font-bold transition-all border-2 border-dashed border-gray-400 bg-gray-100 hover:border-orange-500 hover:bg-orange-50 hover:scale-105 text-center"
                data-action="click->report-form#selectLocation"
                data-report-form-location-id-param="nn"
                data-report-form-location-name-param="Unknown Location"
                data-location-id="nn">
          <span class="text-xl font-black text-orange-600">NN</span>
          <span class="block text-xs text-gray-500 font-medium mt-0.5">Unknown Location</span>
        </button>

        <% @race_locations.each_with_index do |location, index| %>
          <button type="button"
                  class="location-btn w-full px-4 py-3 rounded-lg font-bold transition-all border-2 hover:scale-105 text-center"
                  style="background-color: <%= location.hex_color %>; border-color: <%= location.hex_color %>; color: white;"
                  data-action="click->report-form#selectLocation"
                  data-report-form-location-id-param="<%= location.id %>"
                  data-report-form-location-name-param="<%= location.name %>"
                  data-location-id="<%= location.id %>"
                  title="<%= location.name %> (<%= location.course_segment.titleize %> <%= location.segment_position.titleize %>)">
            <%= location.name %>
          </button>
        <% end %>
        <% if @race_locations.empty? %>
          <div class="text-center py-12 text-gray-400">
            <svg class="w-12 h-12 mx-auto mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            </svg>
            <p class="text-sm">No locations defined</p>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Right: Participant Grid -->
    <div class="flex-1 flex flex-col bg-gray-50">
      <!-- Grid Header -->
      <div class="shrink-0 px-6 py-3 bg-white border-b border-gray-200 flex items-center justify-between">
        <h2 class="text-sm font-bold text-gray-700 uppercase tracking-wide">Select Athlete</h2>
        <span class="text-sm text-gray-500"><%= @participations.size %> participants</span>
      </div>

      <!-- Participant Grid -->
      <div class="flex-1 overflow-y-auto p-4" data-report-form-target="gridContainer">
        <div class="grid grid-cols-4 gap-3">
          <!-- Number NN Option (Unknown Bib) -->
          <button type="button"
                  class="bib-btn flex flex-col items-center justify-center p-4 rounded-xl bg-gray-100 border-2 border-gray-300 transition-all hover:border-orange-500 hover:shadow-md opacity-40"
                  data-action="click->report-form#selectUnknownBib"
                  data-report-form-target="bibButton"
                  disabled>
            <span class="text-3xl font-black text-orange-600 mb-1">NN</span>
            <span class="text-xs text-gray-500 truncate w-full text-center font-medium">
              Unknown Number
            </span>
          </button>
          
          <% @participations.each do |participation| %>
            <% is_team = participation.team_id.present? %>
            <% team = participation.team %>
            <% male   = team&.athlete_1 %>
            <% female = team&.athlete_2 %>
            <% country = is_team ? male&.country : participation.athlete&.country %>
            <% athlete_param = is_team ? "#{male&.last_name} / #{female&.last_name}" : (participation.athlete&.display_name || 'Unknown') %>
            <button type="button"
                    class="bib-btn flex flex-col items-center justify-center p-4 rounded-xl bg-white border-2 border-gray-200 transition-all hover:border-ismf-blue hover:shadow-md opacity-40"
                    data-action="click->report-form#selectBib"
                    data-report-form-participation-id-param="<%= participation.id %>"
                    data-report-form-bib-param="<%= participation.bib_number %>"
                    data-report-form-athlete-param="<%= athlete_param %>"
                    data-report-form-is-team-param="<%= is_team %>"
                    data-report-form-male-name-param="<%= male&.last_name %>"
                    data-report-form-female-name-param="<%= female&.last_name %>"
                    data-report-form-target="bibButton"
                    disabled>
              <span class="text-3xl font-black text-ismf-navy mb-1"><%= participation.bib_number %></span>
              <% if is_team && male && female %>
                <span class="text-xs text-gray-700 font-semibold truncate w-full text-center leading-tight">
                  <span class="text-blue-500">M</span><span class="text-gray-400">/A</span> <%= male.last_name&.truncate(9) %>
                </span>
                <span class="text-xs text-pink-600 font-semibold truncate w-full text-center leading-tight">
                  <span class="text-pink-400">F</span><span class="text-gray-400">/B</span> <%= female.last_name&.truncate(9) %>
                </span>
              <% else %>
                <span class="text-xs text-gray-500 truncate w-full text-center font-medium">
                  <%= participation.athlete&.last_name || 'Unknown' %>
                </span>
              <% end %>
              <% if country.present? %>
                <span class="text-xs text-gray-400 mt-0.5">
                  <%= country_flag_emoji(country) %> <%= country %>
                </span>
              <% end %>
            </button>
          <% end %>
        </div>
        <% if @participations.empty? %>
          <div class="flex flex-col items-center justify-center py-20 text-gray-400">
            <svg class="w-16 h-16 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
            </svg>
            <p class="text-sm">No participants in this race</p>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Athlete Position Selector Overlay (for relay teams) -->
  <div data-report-form-target="athleteSelector" class="hidden fixed inset-0 bg-black/60 z-50 flex items-center justify-center">
    <div class="w-full bg-white rounded-3xl p-8 shadow-xl max-w-lg mx-auto">
      <div class="text-center mb-6">
        <span class="inline-block px-4 py-1 bg-ismf-navy text-white rounded-full text-2xl font-black mb-2" data-report-form-target="athleteSelectorBib">?</span>
        <p class="text-sm text-gray-500 font-medium">Select athlete to report</p>
      </div>
      <div class="grid grid-cols-2 gap-4 mb-4">
        <button type="button"
                data-action="click->report-form#selectMale"
                class="flex flex-col items-center justify-center p-6 rounded-2xl bg-blue-50 border-2 border-blue-300 hover:bg-blue-100 transition-all cursor-pointer">
          <span class="text-4xl font-black text-blue-700 leading-none">M<span class="text-2xl text-gray-400">/A</span></span>
          <span class="text-sm font-bold text-blue-600 mt-2 truncate max-w-full" data-report-form-target="maleNameDisplay">—</span>
        </button>
        <button type="button"
                data-action="click->report-form#selectFemale"
                class="flex flex-col items-center justify-center p-6 rounded-2xl bg-pink-50 border-2 border-pink-300 hover:bg-pink-100 transition-all cursor-pointer">
          <span class="text-4xl font-black text-pink-600 leading-none">F<span class="text-2xl text-gray-400">/B</span></span>
          <span class="text-sm font-bold text-pink-600 mt-2 truncate max-w-full" data-report-form-target="femaleNameDisplay">—</span>
        </button>
      </div>
      <button type="button"
              data-action="click->report-form#cancelAthleteSelector"
              class="w-full py-3 text-gray-500 font-semibold text-sm rounded-xl bg-gray-100 hover:bg-gray-200 transition-all">
        Cancel
      </button>
    </div>
  </div>

  <!-- Hidden Form -->
  <%= form_with scope: :report,
                url: admin_race_reports_path(@race), 
                method: :post,
                data: { 
                  report_form_target: "form",
                  turbo_frame: "_top"
                },
                id: "report-form",
                class: "hidden" do |f| %>
    <%= f.hidden_field :race_location_id, data: { report_form_target: "locationInput" } %>
    <%= f.hidden_field :race_participation_id, data: { report_form_target: "participationInput" } %>
    <%= f.hidden_field :bib_number, data: { report_form_target: "bibInput" } %>
    <%= f.hidden_field :client_uuid, value: SecureRandom.uuid, data: { report_form_target: "clientUuidInput" } %>
    <%= f.hidden_field :athlete_position, value: "", data: { report_form_target: "athletePositionInput" } %>
  <% end %>
</div>

<style>
  .location-btn.active {
    box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.5);
    transform: scale(1.02);
  }
  
  .bib-btn.selected {
    border-color: #1a56db;
    background-color: #eff6ff;
    box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.3);
    transform: scale(1.05);
  }
</style>

