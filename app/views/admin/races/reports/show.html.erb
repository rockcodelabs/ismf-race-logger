<!-- Video Player Modal -->
<%= render "shared/video_player_modal" %>

<div class="space-y-6" data-controller="video-trigger">
  <!-- Page header -->
  <div class="flex items-center justify-between">
    <div>
      <nav class="flex items-center text-sm text-gray-500 mb-2">
        <%= link_to "Races", admin_competitions_path, class: "hover:text-ismf-blue" %>
        <svg class="w-4 h-4 mx-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
        <%= link_to @race.name, admin_race_reports_path(@race), class: "hover:text-ismf-blue" %>
        <svg class="w-4 h-4 mx-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
        <span class="text-ismf-navy">Report #<%= @report.id %></span>
      </nav>
      <h1 class="text-2xl font-bold text-ismf-navy">Report #<%= @report.id %></h1>
      <p class="mt-1 text-sm text-ismf-gray">Created <%= @report.created_at_full %></p>
    </div>
    <div class="flex items-center gap-3">
      <%= link_to admin_race_reports_path(@race), class: "btn-secondary whitespace-nowrap" do %>
        <svg class="w-5 h-5 mr-2 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        <span>Back to Reports</span>
      <% end %>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Main content -->
    <div class="lg:col-span-2 space-y-6">
      <!-- Report details card -->
      <div class="card">
        <div class="p-6">
          <div class="flex items-start justify-between">
            <div class="flex items-center gap-4">
              <span class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-ismf-navy text-white font-bold text-2xl">
                <%= @report.bib_badge %>
              </span>
              <div>
                <h2 class="text-xl font-semibold text-ismf-navy"><%= @report.athlete_name_display %></h2>
                <p class="text-ismf-gray">Bib #<%= @report.bib_number %></p>
              </div>
            </div>
            <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium <%= @report.status_badge[:class] %>">
              <%= @report.status_badge[:label] %>
            </span>
          </div>

          <div class="mt-6 grid grid-cols-2 gap-6">
            <div>
              <dt class="text-sm font-medium text-ismf-gray">Location</dt>
              <dd class="mt-1 text-sm text-ismf-navy"><%= @report.location_name %></dd>
            </div>
            <div>
              <dt class="text-sm font-medium text-ismf-gray">Time</dt>
              <dd class="mt-1 text-sm text-ismf-navy"><%= @report.created_at_full %></dd>
            </div>
            <% if @report.athlete_position.present? && @report.athlete_position > 0 %>
              <div>
                <dt class="text-sm font-medium text-ismf-gray">Athlete Position (Team)</dt>
                <dd class="mt-1 text-sm text-ismf-navy">Athlete <%= @report.athlete_position == 1 ? "A" : "B" %></dd>
              </div>
            <% end %>
            <% if @report.linked_to_incident? %>
              <div>
                <dt class="text-sm font-medium text-ismf-gray">Linked Incident</dt>
                <dd class="mt-1">
                  <%= link_to admin_race_incident_path(@race, @report.incident_id), class: "text-ismf-blue hover:underline" do %>
                    Incident #<%= @report.incident_id %>
                  <% end %>
                </dd>
              </div>
            <% end %>
          </div>

          <% if @report.description.present? %>
            <div class="mt-6">
              <dt class="text-sm font-medium text-ismf-gray">Description</dt>
              <dd class="mt-1 text-sm text-ismf-navy"><%= @report.description %></dd>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Videos card -->
      <% if @report.has_videos? %>
        <div class="card">
          <div class="p-6">
            <div class="flex items-center justify-between mb-4">
              <h3 class="text-lg font-semibold text-ismf-navy">Videos (<%= @report.videos_count %>)</h3>
            </div>
            
            <div class="grid grid-cols-2 gap-4">
              <% @report.videos.each do |video| %>
                <button data-action="click->video-trigger#open"
                        data-video-url="<%= rails_blob_path(video, disposition: "inline") %>"
                        data-video-blob-id="<%= video.id %>"
                        class="group relative aspect-video rounded-lg border-2 border-gray-200 overflow-hidden hover:border-blue-400 hover:shadow-lg transition-all cursor-pointer">
                  <% if video.previewable? %>
                    <% begin %>
                      <%= image_tag video.preview(resize_to_limit: [400, 300]), class: "w-full h-full object-cover", alt: video.filename.to_s %>
                      <div class="absolute inset-0 bg-black bg-opacity-0 group-hover:bg-opacity-40 transition-all flex items-center justify-center">
                        <svg class="w-12 h-12 text-white opacity-0 group-hover:opacity-100 transition-opacity drop-shadow-lg" fill="currentColor" viewBox="0 0 20 20">
                          <path d="M6.3 2.841A1.5 1.5 0 004 4.11V15.89a1.5 1.5 0 002.3 1.269l9.344-5.89a1.5 1.5 0 000-2.538L6.3 2.84z"/>
                        </svg>
                      </div>
                      <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black to-transparent p-2">
                        <p class="text-white text-xs truncate"><%= video.filename.to_s %></p>
                      </div>
                    <% rescue => e %>
                      <div class="w-full h-full bg-gradient-to-br from-blue-100 to-blue-200 flex flex-col items-center justify-center p-4">
                        <svg class="w-12 h-12 text-blue-600 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
                        </svg>
                        <span class="text-xs text-blue-700 font-medium text-center"><%= video.filename.to_s %></span>
                      </div>
                    <% end %>
                  <% else %>
                    <div class="w-full h-full bg-gradient-to-br from-blue-100 to-blue-200 flex flex-col items-center justify-center p-4">
                      <svg class="w-12 h-12 text-blue-600 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
                      </svg>
                      <span class="text-xs text-blue-700 font-medium text-center"><%= video.filename.to_s %></span>
                    </div>
                  <% end %>
                </button>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <!-- Sidebar -->
    <div class="space-y-6">
      <!-- Actions card -->
      <div class="card">
        <div class="p-6">
          <h3 class="text-lg font-semibold text-ismf-navy mb-4">Actions</h3>
          
          <div class="space-y-3">
            <% if @report.can_confirm? %>
              <%= button_to confirm_admin_race_report_path(@race, @report), method: :post, class: "w-full btn-success" do %>
                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                Confirm Report
              <% end %>
              
              <%= button_to reject_admin_race_report_path(@race, @report), method: :post, class: "w-full btn-danger" do %>
                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
                Reject Report
              <% end %>
            <% end %>

            <% if @report.can_reopen? %>
              <%= button_to reopen_admin_race_report_path(@race, @report), method: :post, class: "w-full btn-warning" do %>
                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                </svg>
                Reopen Report
              <% end %>
            <% end %>

            <% if @report.can_merge? %>
              <%= link_to new_admin_race_incident_path(@race, report_ids: [@report.id]), class: "w-full btn-primary" do %>
                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                </svg>
                Create Incident
              <% end %>
            <% end %>
          </div>
        </div>
      </div>

      <!-- Status info card -->
      <div class="card">
        <div class="p-6">
          <h3 class="text-lg font-semibold text-ismf-navy mb-4">Status History</h3>
          
          <div class="space-y-4">
            <div class="flex items-center gap-3">
              <div class="w-8 h-8 rounded-full bg-green-100 flex items-center justify-center">
                <svg class="w-4 h-4 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
                </svg>
              </div>
              <div>
                <p class="text-sm font-medium text-ismf-navy">Created</p>
                <p class="text-xs text-ismf-gray"><%= @report.created_at_full %></p>
              </div>
            </div>

            <% if @report.status != "pending_review" %>
              <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-full <%= @report.status == 'confirmed' ? 'bg-blue-100' : 'bg-red-100' %> flex items-center justify-center">
                  <% if @report.status == "confirmed" %>
                    <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                  <% else %>
                    <svg class="w-4 h-4 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                  <% end %>
                </div>
                <div>
                  <p class="text-sm font-medium text-ismf-navy"><%= @report.status_badge[:label] %></p>
                  <p class="text-xs text-ismf-gray"><%= @report.time_ago %></p>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>