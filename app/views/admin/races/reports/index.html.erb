<%= turbo_stream_from "race_#{@race.id}_reports" %>

<!-- Video Player Modal -->
<%= render "shared/video_player_modal" %>

<div class="space-y-6" 
     data-controller="report-selection upload-queue upload-progress video-prefetch" 
     data-report-selection-race-id-value="<%= @race.id %>"
     data-race-id="<%= @race.id %>"
     data-video-prefetch-race-id-value="<%= @race.id %>"
     data-video-prefetch-videos-value="<%= @race_videos.to_json %>"
     data-video-prefetch-auto-start-value="true">
  <!-- Page header -->
  <div class="flex items-center justify-between">
    <div>
      <nav class="flex items-center text-sm text-gray-500 mb-2">
        <%= link_to "Races", admin_competitions_path, class: "hover:text-ismf-blue" %>
        <svg class="w-4 h-4 mx-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
        <%= link_to @race.name, admin_competition_race_path(@race.competition_id, @race), class: "hover:text-ismf-blue" %>
        <svg class="w-4 h-4 mx-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
        <span class="text-ismf-navy">Reports</span>
      </nav>
      <h1 class="text-2xl font-bold text-ismf-navy">Reports</h1>
      <p class="mt-1 text-sm text-ismf-gray">Manage reports for <%= @race.name %>.</p>
      
      <!-- Video Cache Status -->
      <div class="mt-2" data-video-prefetch-target="status"></div>
    </div>
    <div class="flex items-center gap-3">
      <%= link_to admin_race_incidents_path(@race), class: "btn-secondary whitespace-nowrap" do %>
        <svg class="w-5 h-5 mr-2 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
        <span>View Incidents</span>
      <% end %>
      <% if @race.status == "in_progress" %>
        <%= button_to complete_admin_competition_race_path(@race.competition_id, @race), method: :post, class: "btn-secondary whitespace-nowrap", data: { turbo_confirm: "Are you sure you want to mark this race as completed? This action cannot be undone." } do %>
          <svg class="w-5 h-5 mr-2 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span>Complete Race</span>
        <% end %>
        <%= link_to new_admin_race_report_path(@race), class: "btn-primary whitespace-nowrap" do %>
          <svg class="w-5 h-5 mr-2 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
          </svg>
          <span>New Report</span>
        <% end %>
      <% end %>
    </div>
  </div>

  <!-- Upload Queue Context (hidden) -->
  <div class="hidden" 
       data-upload-queue-direct-upload-url-value="<%= rails_direct_uploads_url %>"
       data-upload-queue-attach-url-value="<%= admin_race_report_videos_path(@race, ':report_id') %>">
  </div>

  <!-- Upload Progress Bar -->
  <div data-upload-progress-target="container" 
       class="hidden fixed bottom-6 right-6 z-50 bg-white rounded-lg shadow-2xl border border-gray-200 max-w-md">
    <!-- Expanded View -->
    <div data-upload-progress-target="expanded" class="p-4">
      <div class="flex items-center justify-between mb-3">
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5 text-blue-600 animate-spin" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
          </svg>
          <span class="font-semibold text-gray-900">Uploading</span>
        </div>
        <div class="flex items-center gap-2">
          <button data-action="click->upload-progress#toggleMinimize" 
                  class="text-gray-400 hover:text-gray-600"
                  title="Minimize">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12H4" />
            </svg>
          </button>
          <button data-action="click->upload-progress#close" 
                  class="text-gray-400 hover:text-gray-600"
                  title="Cancel">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
      </div>
      <div class="mb-2">
        <div class="flex justify-between text-sm text-gray-600 mb-1">
          <span>
            Uploading to <span data-upload-progress-target="batchCount">0 reports</span>
            (<span data-upload-progress-target="fileCount">0 files</span>)
          </span>
          <span data-upload-progress-target="progressText" class="font-medium">0%</span>
        </div>
        <div class="w-full bg-gray-200 rounded-full h-2.5">
          <div data-upload-progress-target="progressBar" 
               class="bg-blue-600 h-2.5 rounded-full transition-all duration-300" 
               style="width: 0%"
               role="progressbar"
               aria-valuenow="0"
               aria-valuemin="0"
               aria-valuemax="100"></div>
        </div>
      </div>
    </div>
    
    <!-- Minimized View -->
    <div data-upload-progress-target="minimized" class="hidden p-3 cursor-pointer" data-action="click->upload-progress#toggleMinimize">
      <div class="flex items-center gap-2">
        <svg class="w-5 h-5 text-blue-600 animate-spin" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
        </svg>
        <span class="text-sm font-medium">
          📤 <span data-upload-progress-target="fileCount">0</span>
          <span data-upload-progress-target="progressText">0%</span>
        </span>
      </div>
    </div>
  </div>

  <!-- Status filter tabs -->
  <div class="flex items-center gap-2">
    <%= link_to admin_race_reports_path(@race, status: 'all'), class: "px-3 py-1.5 rounded-full text-sm font-medium transition-colors #{params[:status] == 'all' ? 'bg-gray-700 text-white' : 'bg-gray-100 text-gray-700 hover:bg-gray-200'}" do %>
      All (<%= @status_counts.values.sum %>)
    <% end %>
    <%= link_to admin_race_reports_path(@race, status: 'pending_review'), class: "px-3 py-1.5 rounded-full text-sm font-medium transition-colors #{params[:status].blank? || params[:status] == 'pending_review' ? 'bg-yellow-600 text-white' : 'bg-yellow-100 text-yellow-800 hover:bg-yellow-200'}" do %>
      Pending (<span id="pending-count-badge"><%= @status_counts["pending_review"] || 0 %></span>)
    <% end %>
    <%= link_to admin_race_reports_path(@race, status: 'confirmed'), class: "px-3 py-1.5 rounded-full text-sm font-medium transition-colors #{params[:status] == 'confirmed' ? 'bg-blue-600 text-white' : 'bg-blue-100 text-blue-800 hover:bg-blue-200'}" do %>
      Confirmed (<span id="confirmed-count"><%= @status_counts["confirmed"] || 0 %></span>)
    <% end %>
    <%= link_to admin_race_reports_path(@race, status: 'rejected'), class: "px-3 py-1.5 rounded-full text-sm font-medium transition-colors #{params[:status] == 'rejected' ? 'bg-red-600 text-white' : 'bg-red-100 text-red-800 hover:bg-red-200'}" do %>
      Rejected (<span id="rejected-count"><%= @status_counts["rejected"] || 0 %></span>)
    <% end %>
  </div>

  <!-- Sticky action bar for selected reports -->
  <div data-report-selection-target="actionBar" class="hidden fixed bottom-6 left-1/2 transform -translate-x-1/2 z-50 bg-ismf-navy text-white px-6 py-4 rounded-lg shadow-2xl">
    <div class="flex items-center gap-4">
      <div class="flex items-center gap-2">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span data-report-selection-target="selectedCount" class="font-semibold">0 reports selected</span>
      </div>
      <button data-action="click->report-selection#createIncident" class="btn-primary bg-white text-ismf-navy hover:bg-gray-100">
        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
        Create Incident from Selected
      </button>
      <button data-action="click->report-selection#deleteSelected" data-report-selection-target="deleteButton" class="btn-danger bg-red-600 text-white hover:bg-red-700">
        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
        </svg>
        Delete Selected Reports
      </button>
      <button data-action="click->report-selection#clearSelection" class="text-white hover:text-gray-300" title="Clear selection">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Hidden form for creating incident -->
  <%= form_with url: admin_race_incidents_path(@race), method: :post, data: { report_selection_target: "form" }, class: "hidden" do |f| %>
    <div data-report-selection-target="hiddenInputs"></div>
  <% end %>

  <!-- Hidden form for deleting reports -->
  <%= form_with url: delete_multiple_admin_race_reports_path(@race), method: :delete, data: { report_selection_target: "deleteForm" }, class: "hidden" do |f| %>
    <div data-report-selection-target="deleteHiddenInputs"></div>
  <% end %>

  <!-- Reports table -->
  <div class="card">
    <div class="table-container border-0 rounded-none">
      <table class="table">
        <thead>
          <tr>
            <% if policy(Report).select? %>
              <th class="w-12">
                <input type="checkbox" 
                       data-action="change->report-selection#toggleAll" 
                       data-report-selection-target="selectAll" 
                       class="w-4 h-4 rounded border-gray-300 text-ismf-blue focus:ring-ismf-blue"
                       title="Select all">
              </th>
            <% end %>
            <th>Bib</th>
            <th>Location / Time</th>
            <th>Reporter</th>
            <th>Athlete</th>
            <th>Status</th>
            <th>Videos</th>
            <th class="text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200 bg-white" id="reports-table-body">
          <% if @reports.any? %>
            <% @reports.each do |report| %>
              <%= render "report_row", report: report, race: @race %>
            <% end %>
          <% else %>
            <tr>
              <td colspan="<%= policy(Report).select? ? 8 : 7 %>" class="text-center py-12">
                <svg class="mx-auto h-12 w-12 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
                <h3 class="mt-2 text-sm font-medium text-ismf-navy">No reports</h3>
                <p class="mt-1 text-sm text-ismf-gray">No reports have been created for this race yet.</p>
                <% if @race.can_report? %>
                  <div class="mt-6">
                    <%= link_to new_admin_race_report_path(@race), class: "btn-primary whitespace-nowrap" do %>
                      <svg class="w-5 h-5 mr-2 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
                      </svg>
                      <span>Create First Report</span>
                    <% end %>
                  </div>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
