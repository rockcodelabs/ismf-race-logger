<% content_for :page_title, "Reports - #{@race.name}" %>

<%= turbo_stream_from "race_#{@race.id}_reports" %>

<div class="h-screen overflow-hidden flex flex-col bg-gray-100">
  <!-- Header -->
  <div class="shrink-0 px-4 py-3 bg-white border-b border-gray-200">
    <div class="flex items-center justify-between gap-3 mb-3">
      <%= link_to admin_competition_race_path(@race.competition, @race), 
          class: "flex items-center gap-2 text-ismf-gray hover:text-ismf-navy" do %>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
      <% end %>
      <div class="flex-1 min-w-0">
        <h1 class="text-lg font-bold text-ismf-navy truncate">Reports</h1>
        <p class="text-xs text-ismf-gray truncate"><%= @race.name %></p>
      </div>
    </div>

    <!-- Status Filter Tabs -->
    <div class="flex gap-2 overflow-x-auto pb-2 -mx-4 px-4">
      <%= link_to admin_race_reports_path(@race, status: 'all'), 
          class: "px-3 py-1.5 rounded-full text-xs font-medium whitespace-nowrap transition-colors #{params[:status] == 'all' ? 'bg-gray-700 text-white' : 'bg-gray-200 text-gray-700'}" do %>
        All (<%= @status_counts.values.sum %>)
      <% end %>
      
      <%= link_to admin_race_reports_path(@race, status: 'pending_review'),
          class: "px-3 py-1.5 rounded-full text-xs font-medium whitespace-nowrap transition-colors #{params[:status].blank? || params[:status] == 'pending_review' ? 'bg-yellow-500 text-white' : 'bg-yellow-100 text-yellow-800'}" do %>
        Pending (<%= @status_counts["pending_review"] || 0 %>)
      <% end %>
      
      <%= link_to admin_race_reports_path(@race, status: 'confirmed'),
          class: "px-3 py-1.5 rounded-full text-xs font-medium whitespace-nowrap transition-colors #{params[:status] == 'confirmed' ? 'bg-green-500 text-white' : 'bg-green-100 text-green-800'}" do %>
        Confirmed (<%= @status_counts["confirmed"] || 0 %>)
      <% end %>
      
      <%= link_to admin_race_reports_path(@race, status: 'rejected'),
          class: "px-3 py-1.5 rounded-full text-xs font-medium whitespace-nowrap transition-colors #{params[:status] == 'rejected' ? 'bg-red-500 text-white' : 'bg-red-100 text-red-800'}" do %>
        Rejected (<%= @status_counts["rejected"] || 0 %>)
      <% end %>
    </div>
  </div>

  <!-- Reports List -->
  <div class="flex-1 overflow-y-auto">
    <% if @reports.any? %>
      <div class="divide-y divide-gray-200">
        <% @reports.each do |report| %>
          <% report_model = Report.includes(videos_attachments: :blob).find(report.id) %>
          <div class="bg-white p-4 hover:bg-gray-50 transition-colors">
            <div class="flex gap-4 items-start">
              <!-- Bib Badge -->
              <div class="shrink-0 w-14 h-14 flex items-center justify-center rounded-lg bg-ismf-navy text-white font-black text-xl">
                <%= report.bib_badge %>
              </div>

              <!-- Info -->
              <div class="flex-1 min-w-0">
                <h3 class="font-bold text-gray-900">
                  <%= report.athlete_name_display %>
                </h3>
                <p class="text-sm text-gray-600 mt-1">
                  <%= report.location_name %> • <%= report.time_ago %>
                </p>
                <div class="mt-2">
                  <span class="inline-block px-2 py-0.5 text-xs font-bold rounded-full <%= report.status_badge[:class] %>">
                    <%= report.status_badge[:label] %>
                  </span>
                </div>
              </div>

              <!-- Video Button/Indicator -->
              <div class="shrink-0 flex flex-col items-center">
                <% if report_model.videos.any? %>
                  <div class="flex flex-col items-center">
                    <div class="w-12 h-12 flex items-center justify-center rounded-lg bg-blue-50 border-2 border-blue-300">
                      <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
                      </svg>
                    </div>
                    <span class="text-xs font-bold text-blue-600 mt-1"><%= report_model.videos.count %> video<%= report_model.videos.count == 1 ? '' : 's' %></span>
                  </div>
                <% else %>
                  <div class="w-12 h-12 flex items-center justify-center rounded-lg bg-gray-100 border-2 border-gray-300">
                    <svg class="w-6 h-6 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
                    </svg>
                  </div>
                <% end %>
              </div>
            </div>

            <!-- Video Thumbnails -->
            <% if report_model.videos.any? %>
              <div class="mt-3 flex gap-2 overflow-x-auto">
                <% report_model.videos.first(3).each do |video| %>
                  <button type="button"
                          class="shrink-0 relative w-14 h-14 rounded-lg border-2 border-gray-200 overflow-hidden hover:border-blue-400 transition-all active:scale-95"
                          onclick="openPhoneVideoPlayer('<%= rails_blob_path(video, disposition: 'inline') %>', '<%= video.id %>')"
                          title="<%= video.filename.to_s %>">
                    <% if video.previewable? %>
                      <% begin %>
                        <%= image_tag video.preview(resize_to_limit: [100, 100]), class: "w-full h-full object-cover", alt: video.filename.to_s %>
                      <% rescue => _ %>
                        <div class="w-full h-full bg-gray-200 flex items-center justify-center">
                          <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
                          </svg>
                        </div>
                      <% end %>
                    <% else %>
                      <div class="w-full h-full bg-gray-200 flex items-center justify-center">
                        <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
                        </svg>
                      </div>
                    <% end %>
                  </button>
                <% end %>
                <% if report_model.videos.count > 3 %>
                  <div class="shrink-0 w-14 h-14 rounded-lg bg-gray-300 flex items-center justify-center text-xs font-bold text-gray-600">
                    +<%= report_model.videos.count - 3 %>
                  </div>
                <% end %>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    <% else %>
      <!-- Empty State -->
      <div class="flex flex-col items-center justify-center h-full px-6 text-center">
        <svg class="w-16 h-16 text-gray-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
        <h3 class="text-lg font-bold text-gray-900">No reports found</h3>
        <p class="text-sm text-gray-600 mt-1">
          <% if params[:status].blank? || params[:status] == 'pending_review' %>
            No pending reports to review
          <% else %>
            No <%= params[:status].humanize.downcase %> reports
          <% end %>
        </p>
      </div>
    <% end %>
  </div>
</div>