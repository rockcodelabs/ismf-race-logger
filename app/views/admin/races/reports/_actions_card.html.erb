<!-- Actions card for report show page -->
<div class="card" id="report-actions-card">
  <div class="p-6">
    <h3 class="text-lg font-semibold text-ismf-navy mb-4">Actions</h3>
    
    <div class="space-y-3">
      <% if report.can_confirm? %>
        <%= button_to confirm_admin_race_report_path(race, report), method: :post, class: "w-full btn-success" do %>
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
          </svg>
          Confirm Report
        <% end %>
        
        <%= button_to reject_admin_race_report_path(race, report), method: :post, class: "w-full btn-danger" do %>
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
          Reject Report
        <% end %>
      <% end %>

      <% if report.can_reopen? %>
        <%= button_to reopen_admin_race_report_path(race, report), method: :post, class: "w-full btn-warning" do %>
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
          </svg>
          Reopen Report
        <% end %>
      <% end %>

      <% if report.can_merge? %>
        <%= link_to new_admin_race_incident_path(race, report_ids: [report.id]), class: "w-full btn-primary" do %>
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
          </svg>
          Create Incident
        <% end %>
      <% end %>
    </div>
  </div>
</div>
