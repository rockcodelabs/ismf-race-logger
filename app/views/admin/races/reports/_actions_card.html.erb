<%# Actions card for report show page %>
<%# Locals: report (Parts::Report), race, incident (Structs::Incident or nil), penalties (Array), attached_penalty_ids (Array) %>

<div class="card" id="report-actions-card">
  <div class="p-6">
    <h3 class="text-lg font-semibold text-ismf-navy mb-4">Actions</h3>

    <%# ────────────────────────────────────────────────────────────────────── %>
    <%# CASE 1 — Pending, no incident yet: Confirm or Reject                  %>
    <%# ────────────────────────────────────────────────────────────────────── %>
    <% if report.can_confirm? && !report.linked_to_incident? %>
      <div class="space-y-3">
        <% if policy(report).confirm? %>
          <%= button_to confirm_admin_race_report_path(race, report),
                        method: :post,
                        class: "w-full flex items-center justify-center gap-2 px-4 py-3 rounded-lg bg-green-500 hover:bg-green-600 text-white font-semibold transition-colors" do %>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            Confirm
          <% end %>
        <% end %>

        <% if policy(report).reject? %>
          <%= button_to reject_admin_race_report_path(race, report),
                        method: :post,
                        class: "w-full flex items-center justify-center gap-2 px-4 py-3 rounded-lg bg-red-500 hover:bg-red-600 text-white font-semibold transition-colors" do %>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
            Reject
          <% end %>
        <% end %>

        <p class="text-xs text-ismf-gray text-center">
          Confirming creates an incident and unlocks penalties &amp; notes.
        </p>
      </div>

    <%# ────────────────────────────────────────────────────────────────────── %>
    <%# CASE 2 — Confirmed + incident PENDING: penalties + remove             %>
    <%# ────────────────────────────────────────────────────────────────────── %>
    <% elsif report.linked_to_incident? && incident.present? && incident.pending? %>
      <div class="space-y-4">

        <%# Penalty selector %>
        <%= form_with url: attach_penalties_admin_race_incident_path(race, incident),
                      method: :post,
                      local: true,
                      class: "space-y-3" do |f| %>

          <div>
            <button type="button"
                    class="w-full flex items-center justify-between p-3 bg-gray-50 rounded-lg hover:bg-gray-100 transition-colors"
                    onclick="document.getElementById('penalty-selection-actions').classList.toggle('hidden');
                             document.getElementById('penalty-toggle-actions-icon').classList.toggle('rotate-180')">
              <span class="text-sm font-medium text-ismf-navy">Select Penalties (Optional)</span>
              <svg class="w-5 h-5 text-ismf-gray transform transition-transform"
                   id="penalty-toggle-actions-icon"
                   fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </button>

            <div id="penalty-selection-actions" class="hidden mt-3 space-y-2">
              <input type="text"
                     id="penalty-search-actions"
                     placeholder="Search penalties (e.g., C1, A.1)"
                     autocomplete="off"
                     class="block w-full px-3 py-2 text-sm rounded-md border-gray-300 shadow-sm focus:border-ismf-blue focus:ring-ismf-blue">

              <div class="space-y-1 max-h-44 overflow-y-auto border border-gray-200 rounded-lg p-2"
                   id="penalty-list-actions">
                <% if penalties.present? %>
                  <% penalties.group_by(&:category).each do |category, cat_penalties| %>
                    <div class="mb-2 penalty-category-actions" data-category="<%= category %>">
                      <p class="text-xs font-semibold text-ismf-gray px-1 mb-1">Category <%= category %></p>
                      <% cat_penalties.each do |penalty| %>
                        <label class="flex items-center gap-2 p-1.5 rounded hover:bg-gray-50 cursor-pointer penalty-item-actions text-xs"
                               data-penalty-number="<%= penalty.penalty_number.downcase %>"
                               data-penalty-name="<%= penalty.name.downcase %>">
                          <input type="checkbox"
                                 name="penalty_ids[]"
                                 value="<%= penalty.id %>"
                                 <%= 'checked' if attached_penalty_ids.include?(penalty.id) %>
                                 class="h-4 w-4 rounded border-gray-300 text-ismf-blue focus:ring-ismf-blue">
                          <span class="inline-flex items-center justify-center w-10 h-5 rounded bg-orange-100 text-orange-800 font-bold text-xs shrink-0">
                            <%= penalty.penalty_number %>
                          </span>
                          <span class="text-ismf-navy flex-1 truncate"><%= penalty.name %></span>
                        </label>
                      <% end %>
                    </div>
                  <% end %>
                <% end %>
              </div>
            </div>
          </div>

          <button type="submit"
                  class="w-full flex items-center justify-center gap-2 px-4 py-2.5 rounded-lg bg-orange-500 hover:bg-orange-600 text-white font-semibold text-sm transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            Save Penalties
          </button>
        <% end %>

        <%# Divider %>
        <div class="border-t border-gray-200"></div>

        <%# Remove incident + all linked reports %>
        <%= button_to admin_race_incident_path(race, incident),
                      method: :delete,
                      data: { turbo_confirm: "This will permanently delete the incident and all its linked reports. Are you sure?" },
                      class: "w-full flex items-center justify-center gap-2 px-4 py-2.5 rounded-lg bg-red-50 hover:bg-red-100 text-red-700 font-medium text-sm border border-red-200 transition-colors" do %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
          </svg>
          Remove Incident &amp; Reports
        <% end %>

      </div>

    <%# ────────────────────────────────────────────────────────────────────── %>
    <%# CASE 3 — Confirmed + incident APPROVED or REJECTED → Reopen          %>
    <%# ────────────────────────────────────────────────────────────────────── %>
    <% elsif report.linked_to_incident? && incident.present? && !incident.pending? %>
      <div class="space-y-3">
        <%
          decided_badge = incident.approved? ?
            { class: "bg-green-100 text-green-800", label: "Approved" } :
            { class: "bg-red-100 text-red-800",     label: "Rejected" }
        %>
        <div class="flex items-center justify-center gap-2 p-3 rounded-lg <%= decided_badge[:class] %>">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <% if incident.approved? %>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            <% else %>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" />
            <% end %>
          </svg>
          <span class="font-semibold">Incident <%= decided_badge[:label] %></span>
        </div>

        <%= button_to reopen_admin_race_incident_path(race, incident),
                      method: :post,
                      class: "w-full flex items-center justify-center gap-2 px-4 py-3 rounded-lg bg-yellow-500 hover:bg-yellow-600 text-white font-semibold transition-colors" do %>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
          </svg>
          Reopen Incident
        <% end %>
      </div>

    <%# ────────────────────────────────────────────────────────────────────── %>
    <%# CASE 4 — Rejected report (no incident)                               %>
    <%# ────────────────────────────────────────────────────────────────────── %>
    <% elsif report.can_reopen? && !report.linked_to_incident? %>
      <div class="space-y-3">
        <div class="flex items-center justify-center gap-2 p-3 rounded-lg bg-red-100 text-red-800">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
          <span class="font-semibold">Report Rejected</span>
        </div>

        <% if policy(report).reopen? %>
          <%= button_to reopen_admin_race_report_path(race, report),
                        method: :post,
                        class: "w-full flex items-center justify-center gap-2 px-4 py-3 rounded-lg bg-yellow-500 hover:bg-yellow-600 text-white font-semibold transition-colors" do %>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
            </svg>
            Reopen Report
          <% end %>
        <% end %>
      </div>

    <%# FALLBACK — edge case %>
    <% else %>
      <p class="text-sm text-ismf-gray">No actions available for this report's current state.</p>
    <% end %>
  </div>
</div>

<% if report.linked_to_incident? && incident.present? && incident.pending? %>
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      var searchInput = document.getElementById('penalty-search-actions');
      if (searchInput) {
        searchInput.addEventListener('input', function () {
          var query = this.value.toLowerCase().trim();
          document.querySelectorAll('.penalty-item-actions').forEach(function (item) {
            var num  = item.getAttribute('data-penalty-number');
            var name = item.getAttribute('data-penalty-name');
            item.style.display = (query === '' || num.includes(query) || name.includes(query)) ? '' : 'none';
          });
          document.querySelectorAll('.penalty-category-actions').forEach(function (cat) {
            var visible = cat.querySelectorAll('.penalty-item-actions:not([style*="display: none"])');
            cat.style.display = visible.length > 0 ? '' : 'none';
          });
        });
      }
    });
  </script>
<% end %>