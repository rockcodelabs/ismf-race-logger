<!-- Actions card for report show page -->
<div class="card" id="report-actions-card">
  <div class="p-6">
    <h3 class="text-lg font-semibold text-ismf-navy mb-4">Actions</h3>
    
    <% if report.incident_id.present? && defined?(@incident) && @incident.present? %>
      <!-- Report is linked to an incident - show incident management -->
      <div class="mb-4 p-3 bg-blue-50 border border-blue-200 rounded-lg">
        <div class="flex items-center gap-2 text-sm">
          <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span class="text-blue-800">
            Linked to 
            <%= link_to "Incident ##{@incident.id}", admin_race_incident_path(race, @incident), class: "font-semibold underline hover:text-blue-900" %>
          </span>
        </div>
      </div>

      <% if @incident.pending? %>
        <!-- Incident Decision Form -->
        <div class="space-y-4">
          <!-- Approve Form -->
          <%= form_with url: decide_admin_race_incident_path(race, @incident), method: :post, local: true, class: "space-y-4", id: "approve-incident-form" do |form| %>
            
            <!-- Hidden fields -->
            <%= hidden_field_tag :redirect_to_reports, "true" %>
            <%= hidden_field_tag :report_id, report.id %>
            <%= hidden_field_tag :status, "approved" %>
            
            <!-- Attach Penalties (Optional) -->
            <div>
              <button type="button" 
                      class="w-full flex items-center justify-between p-3 bg-gray-50 rounded-lg hover:bg-gray-100 transition-colors"
                      onclick="document.getElementById('penalty-selection').classList.toggle('hidden'); document.getElementById('penalty-toggle-icon').classList.toggle('rotate-180')">
                <span class="text-sm font-medium text-ismf-navy">
                  Select Penalties (Optional)
                </span>
                <svg class="w-5 h-5 text-ismf-gray transform transition-transform" id="penalty-toggle-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </button>
              
              <div id="penalty-selection" class="hidden mt-3 space-y-3">
                <!-- Search filter -->
                <input type="text" 
                       id="penalty-search-report" 
                       placeholder="Search penalties (e.g., C1, A.1)"
                       autocomplete="off"
                       class="block w-full px-4 py-2 text-base rounded-md border-gray-300 shadow-sm focus:border-ismf-blue focus:ring-ismf-blue">
                
                <!-- Penalty list -->
                <div class="space-y-2 max-h-48 overflow-y-auto border border-gray-200 rounded-lg p-3" id="penalty-list-report">
                  <% @penalties.group_by(&:category).each do |category, penalties| %>
                    <div class="mb-3 penalty-category-report" data-category="<%= category %>">
                      <h4 class="text-xs font-semibold text-ismf-gray mb-1">Category <%= category %></h4>
                      <% penalties.each do |penalty| %>
                        <label class="flex items-center gap-2 p-2 rounded hover:bg-gray-50 cursor-pointer transition-colors penalty-item-report text-xs" 
                               data-penalty-number="<%= penalty.penalty_number.downcase %>"
                               data-penalty-name="<%= penalty.name.downcase %>">
                          <input type="checkbox" 
                                 name="penalty_ids[]" 
                                 value="<%= penalty.id %>"
                                 <%= 'checked' if @attached_penalty_ids.include?(penalty.id) %>
                                 class="h-4 w-4 rounded border-gray-300 text-ismf-blue focus:ring-ismf-blue">
                          <span class="inline-flex items-center justify-center w-10 h-6 rounded bg-orange-100 text-orange-800 font-bold text-xs shrink-0">
                            <%= penalty.penalty_number %>
                          </span>
                          <span class="text-ismf-navy flex-1 text-xs"><%= penalty.name %></span>
                        </label>
                      <% end %>
                    </div>
                  <% end %>
                </div>
              </div>
            </div>

            <!-- Decision Notes -->
            <div>
              <label for="description" class="block text-sm font-medium text-ismf-navy mb-2">
                Decision Notes
                <span class="text-xs text-ismf-gray">(Penalty or description required)</span>
              </label>
              <textarea name="description" id="description" rows="2"
                        class="block w-full rounded-md border-gray-300 shadow-sm focus:border-ismf-blue focus:ring-ismf-blue text-sm"
                        placeholder="Add notes about your decision..."><%= @incident.description %></textarea>
            </div>

            <!-- Approve Button -->
            <div>
              <button type="submit" 
                      id="approve-incident-btn"
                      class="w-full flex items-center justify-center gap-2 px-4 py-3 rounded-lg bg-green-500 hover:bg-green-600 text-white font-semibold transition-colors">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                Approve
              </button>
            </div>
          <% end %>
          
          <!-- Reject Both Button (Separate Form) -->
          <%= button_to reject_with_incident_admin_race_report_path(race, report), 
                        method: :post,
                        class: "w-full flex items-center justify-center gap-2 px-4 py-3 rounded-lg bg-red-500 hover:bg-red-600 text-white font-semibold transition-colors" do %>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
            Reject Both
          <% end %>
          
          <div class="pt-3 border-t border-gray-200 text-xs text-ismf-gray">
            <p><strong>Approve:</strong> Confirms incident and all pending reports (requires penalty or description)</p>
            <p><strong>Reject Both:</strong> Rejects both the report and incident</p>
          </div>
        </div>
      <% else %>
        <!-- Incident already decided -->
        <div class="text-center py-4">
          <p class="text-sm text-ismf-gray mb-3">Incident has been <%= @incident.status %>.</p>
          <%= button_to reopen_admin_race_incident_path(race, @incident), method: :post, class: "w-full btn-warning" do %>
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
            </svg>
            Reopen Incident
          <% end %>
        </div>
      <% end %>
    <% else %>
      <!-- No incident - show standard report actions -->
      <div class="space-y-3">
        <% if report.can_confirm? && policy(report).confirm? %>
          <%= button_to confirm_admin_race_report_path(race, report), method: :post, class: "w-full btn-success" do %>
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            Confirm Report
          <% end %>
        <% end %>
        
        <% if report.can_confirm? && policy(report).reject? %>
          <%= button_to reject_admin_race_report_path(race, report), method: :post, class: "w-full btn-danger" do %>
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
            Reject Report
          <% end %>
        <% end %>

        <% if report.can_reopen? %>
          <%= button_to reopen_admin_race_report_path(race, report), method: :post, class: "w-full btn-warning" do %>
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
            </svg>
            Reopen Report
          <% end %>
        <% end %>

        <% if report.can_merge? %>
          <%= link_to new_admin_race_incident_path(race, report_ids: [report.id]), class: "w-full btn-primary" do %>
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
            Create Incident
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>

<% if report.incident_id.present? && defined?(@incident) && @incident.present? && @incident.pending? %>
  <script>
    // Penalty search filter for report page
    document.addEventListener('DOMContentLoaded', function() {
      const searchInput = document.getElementById('penalty-search-report');
      const penaltyItems = document.querySelectorAll('.penalty-item-report');
      
      if (searchInput) {
        searchInput.addEventListener('input', function() {
          const query = this.value.toLowerCase().trim();
          
          penaltyItems.forEach(function(item) {
            const penaltyNumber = item.getAttribute('data-penalty-number');
            const penaltyName = item.getAttribute('data-penalty-name');
            
            if (query === '' || penaltyNumber.includes(query) || penaltyName.includes(query)) {
              item.style.display = '';
            } else {
              item.style.display = 'none';
            }
          });
          
          // Show/hide category headers based on visible items
          document.querySelectorAll('.penalty-category-report').forEach(function(category) {
            const visibleItems = category.querySelectorAll('.penalty-item-report:not([style*="display: none"])');
            category.style.display = visibleItems.length > 0 ? '' : 'none';
          });
        });
      }
      
      // Client-side validation for penalty or description
      const approveForm = document.getElementById('approve-incident-form');
      if (approveForm) {
        approveForm.addEventListener('submit', function(e) {
          const checkedPenalties = document.querySelectorAll('input[name="penalty_ids[]"]:checked');
          const description = document.getElementById('description').value.trim();
          
          if (checkedPenalties.length === 0 && description === '') {
            e.preventDefault();
            alert('Please select at least one penalty OR add a description before approving the incident.');
            
            // Focus on description field
            document.getElementById('description').focus();
            
            return false;
          }
        });
      }
    });
  </script>
<% end %>
