<div class="space-y-6">
  <!-- Page header -->
  <div class="flex items-center justify-between">
    <div>
      <nav class="flex items-center text-sm text-gray-500 mb-2">
        <%= link_to "Competitions", admin_competitions_path, class: "hover:text-ismf-blue" %>
        <svg class="w-4 h-4 mx-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
        <%= link_to @race.competition.name, admin_competition_path(@race.competition), class: "hover:text-ismf-blue" %>
        <svg class="w-4 h-4 mx-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
        <%= link_to @race.name, admin_race_incidents_path(@race), class: "hover:text-ismf-blue" %>
        <svg class="w-4 h-4 mx-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
        <%= link_to "Incident ##{@incident.id}", admin_race_incident_path(@race, @incident), class: "hover:text-ismf-blue" %>
        <svg class="w-4 h-4 mx-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
        <span class="text-ismf-navy">Decide</span>
      </nav>
      <h1 class="text-2xl font-bold text-ismf-navy">Decide Incident #<%= @incident.id %></h1>
      <p class="mt-1 text-sm text-ismf-gray">Make a decision and attach penalties.</p>
    </div>
    <div class="flex items-center gap-3">
      <%= link_to admin_race_incident_path(@race, @incident), class: "btn-secondary whitespace-nowrap" do %>
        <svg class="w-5 h-5 mr-2 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        <span>Cancel</span>
      <% end %>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Main content -->
    <div class="lg:col-span-2 space-y-6">
      <!-- Incident summary -->
      <div class="card <%= @incident.card_class %>">
        <div class="p-6">
          <div class="flex items-start justify-between">
            <div>
              <h2 class="text-lg font-semibold text-ismf-navy">Incident Summary</h2>
              <p class="mt-1 text-sm text-ismf-gray"><%= @incident.location_display %></p>
            </div>
            <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium <%= @incident.status_badge[:class] %>">
              <%= @incident.status_badge[:label] %>
            </span>
          </div>

          <div class="mt-4 flex items-center gap-4">
            <div class="flex items-center gap-2">
              <% @incident.bib_display.split(", ").each do |bib| %>
                <span class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-ismf-navy text-white font-bold text-sm">
                  <%= bib %>
                </span>
              <% end %>
            </div>
            <div class="text-sm text-ismf-gray">
              <%= @incident.reports_count_display %>
            </div>
          </div>
        </div>
      </div>

      <!-- Decision form -->
      <div class="card">
        <div class="p-6">
          <h3 class="text-lg font-semibold text-ismf-navy mb-6">Make Decision</h3>
          
          <%= form_with url: decide_admin_race_incident_path(@race, @incident), method: :post, local: true, class: "space-y-6" do |form| %>
            
            <!-- Attach Penalties -->
            <div>
              <label class="block text-sm font-medium text-ismf-navy mb-3">
                Attach Penalties
              </label>
              <p class="text-xs text-ismf-gray mb-4">Select penalties to apply to this incident. Search by penalty number (e.g., C1, A.1).</p>
              
              <!-- Search filter -->
              <div class="mb-4">
                <input type="text" 
                       id="penalty-search" 
                       placeholder="Search by penalty number (C1, A.1, etc.)"
                       class="block w-full rounded-md border-gray-300 shadow-sm focus:border-ismf-blue focus:ring-ismf-blue sm:text-sm">
              </div>
              
              <div class="space-y-2 max-h-64 overflow-y-auto border border-gray-200 rounded-lg p-4" id="penalty-list">
                <% @penalties.group_by(&:category).each do |category, penalties| %>
                  <div class="mb-4 penalty-category" data-category="<%= category %>">
                    <h4 class="text-sm font-semibold text-ismf-gray mb-2">Category <%= category %></h4>
                    <% penalties.each do |penalty| %>
                      <label class="flex items-center gap-3 p-2 rounded hover:bg-gray-50 cursor-pointer transition-colors penalty-item" 
                             data-penalty-number="<%= penalty.penalty_number.downcase %>"
                             data-penalty-name="<%= penalty.name.downcase %>">
                        <input type="checkbox" 
                               name="penalty_ids[]" 
                               value="<%= penalty.id %>"
                               <%= 'checked' if @attached_penalty_ids.include?(penalty.id) %>
                               class="h-4 w-4 rounded border-gray-300 text-ismf-blue focus:ring-ismf-blue">
                        <span class="inline-flex items-center justify-center w-12 h-8 rounded bg-orange-100 text-orange-800 font-bold text-xs shrink-0">
                          <%= penalty.penalty_number %>
                        </span>
                        <span class="text-sm text-ismf-navy flex-1"><%= penalty.name %></span>
                        <% if penalty.team_individual.present? %>
                          <span class="text-xs text-orange-600"><%= penalty.team_individual %></span>
                        <% end %>
                      </label>
                    <% end %>
                  </div>
                <% end %>
              </div>
            </div>

            <!-- Description -->
            <div>
              <label for="description" class="block text-sm font-medium text-ismf-navy">
                Decision Notes
              </label>
              <textarea name="description" id="description" rows="3"
                        class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-ismf-blue focus:ring-ismf-blue sm:text-sm"
                        placeholder="Optional: Add notes about your decision..."><%= @incident.description %></textarea>
            </div>

            <!-- Decision buttons -->
            <div class="pt-4 border-t border-gray-200">
              <label class="block text-sm font-medium text-ismf-navy mb-4">
                Decision <span class="text-red-500">*</span>
              </label>
              
              <div class="grid grid-cols-2 gap-4">
                <button type="submit" 
                        name="status" 
                        value="approved"
                        class="flex items-center justify-center gap-2 px-6 py-4 rounded-lg bg-green-500 hover:bg-green-600 text-white font-semibold transition-colors">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  Approve
                </button>
                
                <button type="submit" 
                        name="status" 
                        value="rejected"
                        class="flex items-center justify-center gap-2 px-6 py-4 rounded-lg bg-red-500 hover:bg-red-600 text-white font-semibold transition-colors">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                  </svg>
                  Reject
                </button>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Sidebar - Linked reports -->
    <div class="space-y-6">
      <div class="card">
        <div class="p-6">
          <h3 class="text-lg font-semibold text-ismf-navy mb-4">Linked Reports (<%= @reports.size %>)</h3>
          
          <% if @reports.any? %>
            <div class="space-y-3">
              <% @reports.each do |report| %>
                <div class="p-3 bg-gray-50 rounded-lg">
                  <div class="flex items-center gap-3">
                    <span class="inline-flex items-center justify-center w-8 h-8 rounded-full bg-ismf-navy text-white font-bold text-xs">
                      <%= report.bib_badge %>
                    </span>
                    <div class="flex-1 min-w-0">
                      <p class="text-sm font-medium text-ismf-navy truncate"><%= report.athlete_name_display %></p>
                      <p class="text-xs text-ismf-gray"><%= report.location_name %></p>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
          <% else %>
            <p class="text-sm text-ismf-gray">No reports linked.</p>
          <% end %>
        </div>
      </div>

      <!-- Help text -->
      <div class="card bg-blue-50 border-blue-200">
        <div class="p-6">
          <h3 class="text-lg font-semibold text-ismf-navy mb-2">Making a Decision</h3>
          <ul class="text-sm text-ismf-gray space-y-2">
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-green-500 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span><strong>Approve</strong> - Confirms the violation and applies selected penalties</span>
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-red-500 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
              </svg>
              <span><strong>Reject</strong> - Dismisses the incident (no penalty applied)</span>
            </li>
          </ul>
          <p class="mt-3 text-xs text-ismf-gray">Decisions can be reopened later if needed.</p>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  // Penalty search filter
  document.addEventListener('DOMContentLoaded', function() {
    const searchInput = document.getElementById('penalty-search');
    const penaltyItems = document.querySelectorAll('.penalty-item');
    
    if (searchInput) {
      searchInput.addEventListener('input', function() {
        const query = this.value.toLowerCase().trim();
        
        penaltyItems.forEach(function(item) {
          const penaltyNumber = item.getAttribute('data-penalty-number');
          const penaltyName = item.getAttribute('data-penalty-name');
          
          if (query === '' || penaltyNumber.includes(query) || penaltyName.includes(query)) {
            item.style.display = '';
          } else {
            item.style.display = 'none';
          }
        });
        
        // Show/hide category headers based on visible items
        document.querySelectorAll('.penalty-category').forEach(function(category) {
          const visibleItems = category.querySelectorAll('.penalty-item:not([style*="display: none"])');
          category.style.display = visibleItems.length > 0 ? '' : 'none';
        });
      });
    }
  });
</script>