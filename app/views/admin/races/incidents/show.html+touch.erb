<% content_for :page_title, "Incident ##{@incident.id}" %>

<div class="h-screen overflow-hidden flex flex-col bg-gray-50">
  <!-- Header -->
  <div class="shrink-0 px-4 py-3 bg-white shadow-sm touch-content-with-nav">
    <div class="flex items-center justify-between gap-3">
      <%= link_to admin_race_incidents_path(@race), class: "flex items-center gap-2 text-ismf-gray" do %>
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
      <% end %>
      <div class="flex-1 min-w-0">
        <h1 class="text-xl font-bold text-ismf-navy">Incident #<%= @incident.id %></h1>
      </div>
      <span class="px-3 py-1.5 text-sm font-bold rounded-full <%= @incident.status_badge[:class] %>">
        <%= @incident.status_badge[:label] %>
      </span>
    </div>
  </div>

  <!-- Main Content -->
  <div class="flex-1 overflow-y-auto touch-scrollable p-4">
    <!-- Bib Numbers Card -->
    <div class="bg-white rounded-2xl shadow-sm p-4 mb-4">
      <div class="flex items-center gap-3 flex-wrap">
        <% @incident.bib_display.split(", ").each do |bib| %>
          <span class="w-16 h-16 flex items-center justify-center rounded-2xl bg-ismf-navy text-white font-black text-2xl">
            <%= bib %>
          </span>
        <% end %>
        <div class="flex-1 min-w-0 ml-2">
          <p class="text-lg font-bold text-ismf-navy"><%= @incident.location_display %></p>
          <p class="text-sm text-gray-500"><%= @incident.time_ago_in_words %> ago</p>
        </div>
      </div>
    </div>

    <!-- Details Grid -->
    <div class="grid grid-cols-2 gap-3 mb-4">
      <div class="bg-white rounded-xl p-4">
        <p class="text-xs font-medium text-gray-500 uppercase tracking-wide mb-1">Reports</p>
        <p class="text-2xl font-bold text-ismf-navy"><%= @reports.size %></p>
      </div>
      <div class="bg-white rounded-xl p-4">
        <p class="text-xs font-medium text-gray-500 uppercase tracking-wide mb-1">Penalties</p>
        <% attached_penalties = Incident.find(@incident.id).penalties %>
        <p class="text-2xl font-bold <%= attached_penalties.any? ? 'text-orange-600' : 'text-gray-400' %>">
          <%= attached_penalties.count %>
        </p>
      </div>
      <% if @incident.decided_by_display %>
        <div class="bg-white rounded-xl p-4 col-span-2">
          <p class="text-xs font-medium text-gray-500 uppercase tracking-wide mb-1">Decided By</p>
          <p class="text-base font-semibold text-ismf-navy">
            <%= @incident.decided_by_display %> • <%= @incident.decided_at_formatted %>
          </p>
        </div>
      <% end %>
    </div>

    <% if @incident.description.present? %>
      <div class="bg-white rounded-xl p-4 mb-4">
        <p class="text-xs font-medium text-gray-500 uppercase tracking-wide mb-1">Description</p>
        <p class="text-base text-ismf-navy"><%= @incident.description %></p>
      </div>
    <% end %>

    <!-- Linked Reports Section -->
    <div class="bg-white rounded-2xl shadow-sm p-4 mb-4">
      <h3 class="text-sm font-bold text-gray-500 uppercase tracking-wide mb-3">
        Linked Reports (<%= @reports.size %>)
      </h3>
      <% if @reports.any? %>
        <div class="space-y-2">
          <% @reports.each do |report| %>
            <%= link_to admin_race_report_path(@race, report), class: "flex items-center gap-3 p-3 rounded-xl bg-gray-50 active:bg-gray-100 transition" do %>
              <span class="w-10 h-10 flex items-center justify-center rounded-full bg-ismf-navy text-white font-bold text-sm">
                <%= report.bib_badge %>
              </span>
              <div class="flex-1 min-w-0">
                <p class="text-sm font-semibold text-ismf-navy truncate"><%= report.athlete_name_display %></p>
                <p class="text-xs text-gray-500"><%= report.location_name %></p>
              </div>
              <span class="px-2 py-0.5 text-xs font-bold rounded-full <%= report.status_badge[:class] %>">
                <%= report.status_badge[:label] %>
              </span>
            <% end %>
          <% end %>
        </div>
      <% else %>
        <p class="text-sm text-gray-400 text-center py-4">No reports linked</p>
      <% end %>
    </div>

    <!-- Attached Penalties Section -->
    <% if attached_penalties.any? %>
      <div class="bg-white rounded-2xl shadow-sm p-4 mb-4">
        <h3 class="text-sm font-bold text-gray-500 uppercase tracking-wide mb-3">
          Attached Penalties
        </h3>
        <div class="space-y-2">
          <% attached_penalties.each do |penalty| %>
            <div class="flex items-center gap-3 p-3 rounded-xl bg-orange-50 border border-orange-200">
              <span class="w-10 h-10 flex items-center justify-center rounded-lg bg-orange-500 text-white font-bold text-sm">
                <%= penalty.penalty_number %>
              </span>
              <div class="flex-1 min-w-0">
                <p class="text-sm font-semibold text-ismf-navy"><%= penalty.name %></p>
                <p class="text-xs text-gray-500"><%= penalty.category_title %></p>
              </div>
              <% if penalty.team_individual.present? %>
                <span class="text-xs font-semibold text-orange-700"><%= penalty.team_individual %></span>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <!-- Notes Section -->
    <%= render "admin/notes/notes_section_touch", notable_type: "Incident", notable_id: @incident.id, notes: @notes %>
  </div>

  <!-- Action Buttons (fixed at bottom) -->
  <div class="shrink-0 px-4 py-4 bg-white border-t border-gray-200 space-y-3">
    <% if @incident.pending? %>
      <%= link_to edit_admin_race_incident_path(@race, @incident), 
          class: "w-full flex items-center justify-center gap-2 py-4 rounded-xl bg-ismf-blue text-white font-bold text-lg active:bg-blue-700 transition" do %>
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        Make Decision
      <% end %>
    <% else %>
      <%= button_to reopen_admin_race_incident_path(@race, @incident), 
          method: :post, 
          class: "w-full flex items-center justify-center gap-2 py-4 rounded-xl bg-yellow-500 text-white font-bold text-lg active:bg-yellow-600 transition" do %>
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
        </svg>
        Reopen Incident
      <% end %>
    <% end %>
  </div>
</div>