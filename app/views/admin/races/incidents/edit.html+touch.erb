<% content_for :page_title, "Decide Incident ##{@incident.id}" %>

<div class="h-screen overflow-hidden flex flex-col bg-gray-50" data-controller="touch-penalty-selector">
  <!-- Header -->
  <div class="shrink-0 px-4 py-3 bg-white shadow-sm touch-content-with-nav">
    <div class="flex items-center justify-between gap-3">
      <%= link_to admin_race_incident_path(@race, @incident), class: "flex items-center gap-2 text-ismf-gray" do %>
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      <% end %>
      <div class="flex-1 min-w-0">
        <h1 class="text-xl font-bold text-ismf-navy">Decide Incident</h1>
        <p class="text-xs text-ismf-gray truncate">#<%= @incident.id %> • <%= @incident.location_display %></p>
      </div>
      <div class="flex items-center gap-2">
        <% @incident.bib_display.split(", ").take(2).each do |bib| %>
          <span class="w-10 h-10 flex items-center justify-center rounded-full bg-ismf-navy text-white font-bold text-sm">
            <%= bib %>
          </span>
        <% end %>
        <% if @incident.bib_display.split(", ").size > 2 %>
          <span class="w-10 h-10 flex items-center justify-center rounded-full bg-gray-400 text-white font-bold text-xs">
            +<%= @incident.bib_display.split(", ").size - 2 %>
          </span>
        <% end %>
      </div>
    </div>
  </div>

  <%= form_with url: decide_admin_race_incident_path(@race, @incident), method: :post, local: true, id: "decision-form", class: "flex-1 flex flex-col overflow-hidden" do |form| %>
    <!-- Main Content -->
    <div class="flex-1 overflow-y-auto touch-scrollable p-4">
      
      <!-- Attached Penalties Section -->
      <div class="bg-white rounded-2xl shadow-sm p-4 mb-4">
        <div class="flex items-center justify-between mb-3">
          <h2 class="text-sm font-bold text-gray-500 uppercase tracking-wide">Penalties</h2>
          <button type="button"
                  class="px-3 py-1.5 rounded-lg bg-orange-100 text-orange-700 font-semibold text-sm active:bg-orange-200 transition"
                  data-action="click->touch-penalty-selector#openModal">
            + Add Penalty
          </button>
        </div>

        <!-- Selected Penalties Display -->
        <div data-touch-penalty-selector-target="selectedPenalties" class="space-y-2">
          <% @attached_penalty_ids.each do |penalty_id| %>
            <% penalty = @penalties.find { |p| p.id == penalty_id } %>
            <% if penalty %>
              <div class="flex items-center gap-3 p-3 rounded-xl bg-orange-50 border border-orange-200"
                   data-penalty-id="<%= penalty.id %>">
                <input type="hidden" name="penalty_ids[]" value="<%= penalty.id %>">
                <span class="w-10 h-10 flex items-center justify-center rounded-lg bg-orange-500 text-white font-bold text-sm shrink-0">
                  <%= penalty.penalty_number %>
                </span>
                <div class="flex-1 min-w-0">
                  <p class="text-sm font-semibold text-ismf-navy truncate"><%= penalty.name %></p>
                  <p class="text-xs text-gray-500"><%= penalty.category_title %></p>
                </div>
                <button type="button"
                        class="w-8 h-8 flex items-center justify-center rounded-full bg-red-100 text-red-600 active:bg-red-200 transition"
                        data-action="click->touch-penalty-selector#removePenalty"
                        data-penalty-id="<%= penalty.id %>">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                  </svg>
                </button>
              </div>
            <% end %>
          <% end %>
        </div>

        <% if @attached_penalty_ids.empty? %>
          <div data-touch-penalty-selector-target="emptyState" class="text-center py-6 text-gray-400">
            <svg class="w-10 h-10 mx-auto mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
            <p class="text-sm">No penalties attached</p>
            <p class="text-xs mt-1">Tap "Add Penalty" to attach penalties</p>
          </div>
        <% end %>
      </div>

      <!-- Description Section -->
      <div class="bg-white rounded-2xl shadow-sm p-4 mb-4">
        <label for="description" class="block text-sm font-bold text-gray-500 uppercase tracking-wide mb-2">
          Decision Notes (Optional)
        </label>
        <textarea name="description" 
                  id="description" 
                  rows="3"
                  class="w-full rounded-xl border-gray-300 text-base p-3 focus:border-ismf-blue focus:ring-ismf-blue"
                  placeholder="Add notes about your decision..."><%= @incident.description %></textarea>
      </div>

      <!-- Linked Reports Summary -->
      <div class="bg-white rounded-2xl shadow-sm p-4 mb-4">
        <h2 class="text-sm font-bold text-gray-500 uppercase tracking-wide mb-3">
          Linked Reports (<%= @reports.size %>)
        </h2>
        <div class="flex flex-wrap gap-2">
          <% @reports.each do |report| %>
            <div class="flex items-center gap-2 px-3 py-2 rounded-lg bg-gray-50">
              <span class="w-8 h-8 flex items-center justify-center rounded-full bg-ismf-navy text-white font-bold text-xs">
                <%= report.bib_badge %>
              </span>
              <span class="text-sm text-gray-700"><%= report.location_name %></span>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Decision Buttons (fixed at bottom) -->
    <div class="shrink-0 px-4 py-4 bg-white border-t border-gray-200">
      <div class="flex gap-3">
        <button type="submit" 
                name="status" 
                value="rejected"
                class="flex-1 flex items-center justify-center gap-2 py-4 rounded-xl bg-red-500 text-white font-bold text-lg active:bg-red-600 transition">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" />
          </svg>
          Reject
        </button>
        <button type="submit" 
                name="status" 
                value="approved"
                class="flex-1 flex items-center justify-center gap-2 py-4 rounded-xl bg-green-500 text-white font-bold text-lg active:bg-green-600 transition">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
          </svg>
          Approve
        </button>
      </div>
    </div>
  <% end %>

  <!-- Penalty Selection Modal -->
  <div data-touch-penalty-selector-target="modal"
       class="fixed inset-0 z-50 hidden">
    <!-- Backdrop -->
    <div class="absolute inset-0 bg-black/50" data-action="click->touch-penalty-selector#closeModal"></div>
    
    <!-- Modal Content -->
    <div class="absolute inset-x-4 top-20 bottom-20 bg-white rounded-2xl shadow-xl flex flex-col overflow-hidden">
      <!-- Modal Header -->
      <div class="shrink-0 px-4 py-3 border-b border-gray-200 flex items-center justify-between">
        <h3 class="text-lg font-bold text-ismf-navy">Select Penalty</h3>
        <button type="button"
                class="w-10 h-10 flex items-center justify-center rounded-full bg-gray-100 active:bg-gray-200 transition"
                data-action="click->touch-penalty-selector#closeModal">
          <svg class="w-5 h-5 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <!-- Search Input -->
      <div class="shrink-0 px-4 py-3 border-b border-gray-200">
        <input type="text"
               data-touch-penalty-selector-target="searchInput"
               data-action="input->touch-penalty-selector#filterPenalties"
               placeholder="Search by penalty number (C1, A.1, etc.)"
               class="w-full rounded-xl border-gray-300 text-base p-3 focus:border-ismf-blue focus:ring-ismf-blue">
      </div>

      <!-- Penalty List -->
      <div class="flex-1 overflow-y-auto touch-scrollable p-4" data-touch-penalty-selector-target="penaltyList">
        <% @penalties.group_by(&:category).each do |category, penalties| %>
          <div class="mb-4 penalty-category" data-category="<%= category %>">
            <h4 class="text-xs font-bold text-gray-500 uppercase tracking-wide mb-2 sticky top-0 bg-white py-1">
              Category <%= category %>
            </h4>
            <% penalties.each do |penalty| %>
              <button type="button"
                      class="w-full flex items-center gap-3 p-3 rounded-xl bg-gray-50 active:bg-gray-100 transition mb-2 penalty-item"
                      data-action="click->touch-penalty-selector#selectPenalty"
                      data-penalty-id="<%= penalty.id %>"
                      data-penalty-number="<%= penalty.penalty_number %>"
                      data-penalty-name="<%= penalty.name %>"
                      data-penalty-category="<%= penalty.category_title %>"
                      data-penalty-search="<%= penalty.penalty_number.downcase %> <%= penalty.name.downcase %>">
                <span class="w-12 h-12 flex items-center justify-center rounded-lg bg-orange-100 text-orange-800 font-bold text-sm shrink-0">
                  <%= penalty.penalty_number %>
                </span>
                <div class="flex-1 min-w-0 text-left">
                  <p class="text-base font-semibold text-ismf-navy truncate"><%= penalty.name %></p>
                  <p class="text-xs text-gray-500"><%= penalty.category_title %></p>
                </div>
                <% if penalty.team_individual.present? %>
                  <span class="text-xs font-semibold text-orange-600 shrink-0"><%= penalty.team_individual %></span>
                <% end %>
              </button>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>