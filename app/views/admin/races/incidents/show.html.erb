<div class="space-y-6">
  <!-- Page header -->
  <div class="flex items-center justify-between">
    <div>
      <nav class="flex items-center text-sm text-gray-500 mb-2">
        <%= link_to "Races", admin_competitions_path, class: "hover:text-ismf-blue" %>
        <svg class="w-4 h-4 mx-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
        <%= link_to @race.name, admin_race_incidents_path(@race), class: "hover:text-ismf-blue" %>
        <svg class="w-4 h-4 mx-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
        <span class="text-ismf-navy">Incident #<%= @incident.id %></span>
      </nav>
      <h1 class="text-2xl font-bold text-ismf-navy">Incident #<%= @incident.id %></h1>
      <p class="mt-1 text-sm text-ismf-gray">Created <%= @incident.created_at_formatted %></p>
    </div>
    <div class="flex items-center gap-3">
      <%= link_to admin_race_incidents_path(@race), class: "btn-secondary whitespace-nowrap" do %>
        <svg class="w-5 h-5 mr-2 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        <span>Back to Incidents</span>
      <% end %>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Main content -->
    <div class="lg:col-span-2 space-y-6">
      <!-- Incident details card with linked reports -->
      <div class="card <%= @incident.card_class %>">
        <div class="p-6">
          <div class="flex items-start justify-between mb-6">
            <div>
              <h2 class="text-xl font-semibold text-ismf-navy">Incident Details</h2>
              <p class="mt-1 text-sm text-ismf-gray"><%= @incident.location_display %></p>
            </div>
            <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium <%= @incident.status_badge[:class] %>">
              <%= @incident.status_badge[:label] %>
            </span>
          </div>

          <div class="grid grid-cols-2 gap-6 mb-6">
            <div>
              <dt class="text-sm font-medium text-ismf-gray">Bib Number(s)</dt>
              <dd class="mt-1 flex items-center gap-2">
                <% unique_bibs = @reports.map(&:bib_number).compact.uniq %>
                <% if unique_bibs.any? %>
                  <% unique_bibs.each do |bib| %>
                    <span class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-ismf-navy text-white font-bold text-sm">
                      <%= bib %>
                    </span>
                  <% end %>
                <% else %>
                  <span class="text-sm text-ismf-gray">—</span>
                <% end %>
              </dd>
            </div>
            <div>
              <dt class="text-sm font-medium text-ismf-gray">Reports</dt>
              <dd class="mt-1 text-sm text-ismf-navy"><%= @incident.reports_count_display %></dd>
            </div>
            <div>
              <dt class="text-sm font-medium text-ismf-gray">Created</dt>
              <dd class="mt-1 text-sm text-ismf-navy"><%= @incident.time_ago_in_words %> ago</dd>
            </div>
            <% if @incident.decided_by_display %>
              <div>
                <dt class="text-sm font-medium text-ismf-gray">Decided By</dt>
                <dd class="mt-1 text-sm text-ismf-navy"><%= @incident.decided_by_display %></dd>
              </div>
              <div>
                <dt class="text-sm font-medium text-ismf-gray">Decided At</dt>
                <dd class="mt-1 text-sm text-ismf-navy"><%= @incident.decided_at_formatted %></dd>
              </div>
            <% end %>
          </div>

          <% if @incident.description.present? %>
            <div class="mb-6 pb-6 border-b border-gray-200">
              <dt class="text-sm font-medium text-ismf-gray">Description</dt>
              <dd class="mt-1 text-sm text-ismf-navy"><%= @incident.description %></dd>
            </div>
          <% end %>

          <!-- Linked Reports Section -->
          <div>
            <h3 class="text-lg font-semibold text-ismf-navy mb-4">Linked Reports (<%= @reports.size %>)</h3>
            <% if @reports.any? %>
              <div class="space-y-3">
                <% @reports.each do |report| %>
                  <div class="flex items-center justify-between p-4 bg-gray-50 rounded-lg">
                    <div class="flex items-center gap-4">
                      <span class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-ismf-navy text-white font-bold text-sm">
                        <%= report.bib_badge %>
                      </span>
                      <div>
                        <p class="font-medium text-ismf-navy"><%= report.athlete_name_display %></p>
                        <p class="text-sm text-ismf-gray"><%= report.location_name %> • <%= report.created_at_formatted %></p>
                      </div>
                    </div>
                    <div class="flex items-center gap-2">
                      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= report.status_badge[:class] %>">
                        <%= report.status_badge[:label] %>
                      </span>
                      <%= link_to admin_race_report_path(@race, report), class: "text-ismf-blue hover:underline text-sm" do %>
                        View
                      <% end %>
                    </div>
                  </div>
                <% end %>
              </div>
            <% else %>
              <div class="text-center py-8">
                <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
                <h3 class="mt-2 text-sm font-medium text-ismf-navy">No reports linked</h3>
                <p class="mt-1 text-sm text-ismf-gray">This incident has no reports. You can add reports or delete this incident.</p>
                <div class="mt-6 flex items-center justify-center gap-3">
                  <%= link_to admin_race_reports_path(@race), class: "btn-secondary" do %>
                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                    </svg>
                    Go to Reports
                  <% end %>
                  <%= button_to admin_race_incident_path(@race, @incident), method: :delete, class: "btn-danger", data: { turbo_confirm: "Delete this empty incident? This action cannot be undone." } do %>
                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                    </svg>
                    Delete Empty Incident
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </div>

      <!-- Attached penalties -->
      <div class="card">
        <div class="p-6">
          <h3 class="text-lg font-semibold text-ismf-navy mb-4">Attached Penalties</h3>
          
          <% attached_penalties = Incident.find(@incident.id).penalties %>
          <% if attached_penalties.any? %>
            <div class="space-y-2">
              <% attached_penalties.each do |penalty| %>
                <div class="flex items-center justify-between p-3 bg-orange-50 rounded-lg border border-orange-200">
                  <div class="flex items-center gap-3">
                    <span class="inline-flex items-center justify-center w-10 h-10 rounded-lg bg-orange-500 text-white font-bold text-sm">
                      <%= penalty.penalty_number %>
                    </span>
                    <div>
                      <p class="font-medium text-ismf-navy"><%= penalty.name %></p>
                      <p class="text-xs text-ismf-gray"><%= penalty.category_title %></p>
                    </div>
                  </div>
                  <div class="text-right text-sm">
                    <% if penalty.team_individual.present? %>
                      <span class="text-orange-700 font-medium"><%= penalty.team_individual %></span>
                    <% end %>
                  </div>
                </div>
              <% end %>
            </div>
          <% else %>
            <p class="text-sm text-ismf-gray">No penalties attached to this incident.</p>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Sidebar -->
    <div class="space-y-6">
      <!-- Actions card -->
      <% if policy(@incident).update? %>
        <div class="card">
          <div class="p-6">
            <h3 class="text-lg font-semibold text-ismf-navy mb-4">Actions</h3>
            
            <div class="space-y-3">
              <% if @incident.pending? %>
                <%= link_to edit_admin_race_incident_path(@race, @incident), class: "w-full btn-primary" do %>
                  <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  Make Decision
                <% end %>
              <% end %>

              <% unless @incident.pending? %>
                <%= button_to reopen_admin_race_incident_path(@race, @incident), method: :post, class: "w-full btn-warning" do %>
                  <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                  </svg>
                  Reopen Incident
                <% end %>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>

      <!-- Manage Reports card -->
      <% if policy(@incident).update? %>
        <div class="card">
          <div class="p-6">
            <h3 class="text-lg font-semibold text-ismf-navy mb-4">Manage Reports</h3>
          
          <div class="space-y-3">
            <!-- Add Reports -->
            <%= form_with url: add_reports_admin_race_incident_path(@race, @incident), method: :post, class: "space-y-3" do |f| %>
              <div>
                <label class="block text-sm font-medium text-ismf-gray mb-2">Add Pending Reports</label>
                <% pending_reports = AppContainer["repos.report"].pending_without_incident(@race.id) %>
                <% pending_reports = AppContainer["parts.factory"].wrap_many(pending_reports) %>
                <% if pending_reports.any? %>
                  <select name="report_ids[]" multiple class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm" size="3">
                    <% pending_reports.each do |report| %>
                      <option value="<%= report.id %>">
                        Bib #<%= report.bib_number %> - <%= report.athlete_name_display %> (<%= report.created_at_formatted %>)
                      </option>
                    <% end %>
                  </select>
                  <p class="mt-1 text-xs text-ismf-gray">Hold Ctrl/Cmd to select multiple</p>
                  <%= f.submit "Add Selected Reports", class: "mt-2 w-full btn-secondary text-sm" %>
                <% else %>
                  <p class="text-xs text-ismf-gray">No pending reports available</p>
                <% end %>
              </div>
            <% end %>

            <!-- Remove Reports -->
            <% if @reports.any? %>
              <%= form_with url: remove_reports_admin_race_incident_path(@race, @incident), method: :post, class: "space-y-3" do |f| %>
                <div>
                  <label class="block text-sm font-medium text-ismf-gray mb-2">Remove Reports</label>
                  <select name="report_ids[]" multiple class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm" size="3">
                    <% @reports.each do |report| %>
                      <option value="<%= report.id %>">
                        Bib #<%= report.bib_number %> - <%= report.athlete_name_display %>
                      </option>
                    <% end %>
                  </select>
                  <p class="mt-1 text-xs text-ismf-gray">Hold Ctrl/Cmd to select multiple</p>
                  <%= f.submit "Remove Selected Reports", class: "mt-2 w-full btn-warning text-sm" %>
                </div>
              <% end %>
            <% end %>
          </div>
        </div>
      </div>
      <% end %>

      <!-- Merge Incidents card -->
      <% if policy(@incident).update? %>
        <div class="card">
        <div class="p-6">
          <h3 class="text-lg font-semibold text-ismf-navy mb-4">Merge Incidents</h3>
          
          <%= form_with url: merge_admin_race_incidents_path(@race), method: :post, class: "space-y-3" do |f| %>
            <%= hidden_field_tag :id, @incident.id %>
            <div>
              <label class="block text-sm font-medium text-ismf-gray mb-2">Merge From Incident</label>
              <% other_incidents = AppContainer["repos.incident"].for_race(@race.id).reject { |i| i.id == @incident.id } %>
              <% if other_incidents.any? %>
                <select name="source_incident_id" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm">
                  <option value="">Select incident to merge...</option>
                  <% other_incidents.each do |incident| %>
                    <option value="<%= incident.id %>">
                      Incident #<%= incident.id %> - <%= incident.reports_count %> report(s) - Bib <%= incident.bib_numbers.join(", ") %>
                    </option>
                  <% end %>
                </select>
                <div class="mt-2">
                  <label class="flex items-center text-sm text-ismf-gray">
                    <%= check_box_tag :merge_descriptions, "1", false, class: "mr-2" %>
                    Merge descriptions
                  </label>
                </div>
                <%= f.submit "Merge Incidents", class: "mt-3 w-full btn-danger text-sm", data: { confirm: "This will merge the selected incident into this one. The source incident will be deleted. Continue?" } %>
                <p class="mt-1 text-xs text-ismf-gray">Reports from selected incident will be moved here</p>
              <% else %>
                <p class="text-xs text-ismf-gray">No other incidents available to merge</p>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
      <% end %>

      <!-- Status info card -->
      <div class="card">
        <div class="p-6">
          <h3 class="text-lg font-semibold text-ismf-navy mb-4">Status History</h3>
          
          <div class="space-y-4">
            <div class="flex items-center gap-3">
              <div class="w-8 h-8 rounded-full bg-green-100 flex items-center justify-center">
                <svg class="w-4 h-4 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
                </svg>
              </div>
              <div>
                <p class="text-sm font-medium text-ismf-navy">Created</p>
                <p class="text-xs text-ismf-gray"><%= @incident.created_at_formatted %></p>
              </div>
            </div>

            <% unless @incident.pending? %>
              <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-full <%= @incident.approved? ? 'bg-green-100' : 'bg-red-100' %> flex items-center justify-center">
                  <% if @incident.approved? %>
                    <svg class="w-4 h-4 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                  <% else %>
                    <svg class="w-4 h-4 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                  <% end %>
                </div>
                <div>
                  <p class="text-sm font-medium text-ismf-navy"><%= @incident.status_badge[:label] %></p>
                  <p class="text-xs text-ismf-gray">
                    <% if @incident.decided_by_display %>
                      by <%= @incident.decided_by_display %>
                    <% end %>
                    <% if @incident.decided_at_formatted %>
                      on <%= @incident.decided_at_formatted %>
                    <% end %>
                  </p>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </div>

      <!-- Quick penalty info -->
      <div class="card">
        <div class="p-6">
          <h3 class="text-lg font-semibold text-ismf-navy mb-4">Quick Stats</h3>
          
          <dl class="space-y-3">
            <div class="flex justify-between">
              <dt class="text-sm text-ismf-gray">Total Reports</dt>
              <dd class="text-sm font-medium text-ismf-navy"><%= @reports.size %></dd>
            </div>
            <div class="flex justify-between">
              <dt class="text-sm text-ismf-gray">Penalties</dt>
              <dd class="text-sm font-medium text-ismf-navy"><%= Incident.find(@incident.id).penalties.count %></dd>
            </div>
            <div class="flex justify-between">
              <dt class="text-sm text-ismf-gray">Status</dt>
              <dd>
                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium <%= @incident.status_badge[:class] %>">
                  <%= @incident.status_badge[:label] %>
                </span>
              </dd>
            </div>
          </dl>
        </div>
      </div>

      <!-- Notes Section -->
      <%= render "admin/notes/notes_section", notable_type: "Incident", notable_id: @incident.id, notes: @notes %>
    </div>
  </div>
</div>
