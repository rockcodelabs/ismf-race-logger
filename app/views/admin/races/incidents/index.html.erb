<div class="space-y-6" data-controller="incident-selection" data-incident-selection-race-id-value="<%= @race.id %>">
  <!-- Page header -->
  <div class="flex items-center justify-between">
    <div>
      <nav class="flex items-center text-sm text-gray-500 mb-2">
        <%= link_to "Competitions", admin_competitions_path, class: "hover:text-ismf-blue" %>
        <svg class="w-4 h-4 mx-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
        <%= link_to @race.competition.name, admin_competition_path(@race.competition), class: "hover:text-ismf-blue" %>
        <svg class="w-4 h-4 mx-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
        <%= link_to @race.name, admin_competition_race_path(@race.competition, @race), class: "hover:text-ismf-blue" %>
        <svg class="w-4 h-4 mx-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
        <span class="text-ismf-navy">Incidents</span>
      </nav>
      <h1 class="text-2xl font-bold text-ismf-navy">Incidents</h1>
      <p class="mt-1 text-sm text-ismf-gray">Manage incidents for <%= @race.name %>.</p>
    </div>
    <div class="flex items-center gap-3">
      <%= link_to admin_race_reports_path(@race), class: "btn-secondary whitespace-nowrap" do %>
        <svg class="w-5 h-5 mr-2 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
        <span>View Reports</span>
      <% end %>
      <% if @race.status == "in_progress" %>
        <%= button_to complete_admin_competition_race_path(@race.competition_id, @race), method: :post, class: "btn-secondary whitespace-nowrap", data: { turbo_confirm: "Are you sure you want to mark this race as completed? This action cannot be undone." } do %>
          <svg class="w-5 h-5 mr-2 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span>Complete Race</span>
        <% end %>
      <% end %>
      <% if policy(Incident).create? %>
        <%= link_to new_admin_race_incident_path(@race), class: "btn-primary whitespace-nowrap" do %>
          <svg class="w-5 h-5 mr-2 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
          </svg>
          <span>New Incident</span>
        <% end %>
      <% end %>
    </div>
  </div>

  <!-- Status filter tabs -->
  <div class="flex items-center gap-2">
    <%= link_to admin_race_incidents_path(@race, status: "all"), class: "px-3 py-1.5 rounded-full text-sm font-medium transition-colors #{@status == 'all' ? 'bg-gray-700 text-white' : 'bg-gray-100 text-gray-700 hover:bg-gray-200'}" do %>
      All (<%= @status_counts.values.sum %>)
    <% end %>
    <%= link_to admin_race_incidents_path(@race, status: "pending"), class: "px-3 py-1.5 rounded-full text-sm font-medium transition-colors #{@status == 'pending' ? 'bg-yellow-500 text-white' : 'bg-yellow-100 text-yellow-800 hover:bg-yellow-200'}" do %>
      Pending (<%= @status_counts["pending"] || 0 %>)
    <% end %>
    <%= link_to admin_race_incidents_path(@race, status: "approved"), class: "px-3 py-1.5 rounded-full text-sm font-medium transition-colors #{@status == 'approved' ? 'bg-green-500 text-white' : 'bg-green-100 text-green-800 hover:bg-green-200'}" do %>
      Approved (<%= @status_counts["approved"] || 0 %>)
    <% end %>
    <%= link_to admin_race_incidents_path(@race, status: "rejected"), class: "px-3 py-1.5 rounded-full text-sm font-medium transition-colors #{@status == 'rejected' ? 'bg-red-500 text-white' : 'bg-red-100 text-red-800 hover:bg-red-200'}" do %>
      Rejected (<%= @status_counts["rejected"] || 0 %>)
    <% end %>
  </div>

  <!-- Sticky action bar for selected incidents -->
  <div data-incident-selection-target="actionBar" class="hidden fixed bottom-6 left-1/2 transform -translate-x-1/2 z-50 bg-ismf-navy text-white px-6 py-4 rounded-lg shadow-2xl">
    <div class="flex items-center gap-4">
      <div class="flex items-center gap-2">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span data-incident-selection-target="selectedCount" class="font-semibold">0 incidents selected</span>
      </div>
      <button data-action="click->incident-selection#deleteSelected" class="btn-danger bg-red-600 text-white hover:bg-red-700">
        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
        </svg>
        Delete Selected Incidents
      </button>
      <button data-action="click->incident-selection#clearSelection" class="text-white hover:text-gray-300" title="Clear selection">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Hidden form for deleting incidents -->
  <%= form_with url: delete_multiple_admin_race_incidents_path(@race), method: :delete, data: { incident_selection_target: "deleteForm" }, class: "hidden" do |f| %>
    <div data-incident-selection-target="deleteHiddenInputs"></div>
  <% end %>

  <!-- Incidents table -->
  <div class="card">
    <div class="table-container border-0 rounded-none">
      <table class="table">
        <thead>
          <tr>
            <% if policy(Incident).create? %>
              <th class="w-12">
                <input type="checkbox" data-action="change->incident-selection#toggleAll" data-incident-selection-target="selectAll" class="w-4 h-4 rounded border-gray-300 text-ismf-blue focus:ring-ismf-blue" title="Select all">
              </th>
            <% end %>
            <th>Bib(s)</th>
            <th>Name</th>
            <th>Location / Time / Reporter</th>
            <th>Reports</th>
            <th>Status</th>
            <th>Athletes</th>
            <th class="text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200 bg-white">
          <% if @incidents.any? %>
            <% @incidents.each do |incident| %>
              <tr class="<%= incident.card_class %>" data-incident-selection-target="row">
                <% if policy(Incident).create? %>
                  <td>
                    <input type="checkbox" 
                           data-incident-selection-target="checkbox" 
                           data-incident-id="<%= incident.id %>"
                           data-incident-status="<%= incident.status %>"
                           data-reports-count="<%= incident.reports_count || 0 %>"
                           data-action="change->incident-selection#updateSelection"
                           class="w-4 h-4 rounded border-gray-300 text-ismf-blue focus:ring-ismf-blue">
                  </td>
                <% end %>
                <td>
                  <%= link_to admin_race_incident_path(@race, incident), class: "block" do %>
                    <div class="flex items-center gap-1 flex-wrap">
                      <% bib_list = incident.bib_display.split(", ") %>
                      <% bib_list.first(3).each do |bib| %>
                        <span class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-ismf-navy text-white font-bold text-sm">
                          <%= bib %>
                        </span>
                      <% end %>
                      <% if bib_list.size > 3 %>
                        <span class="text-xs text-gray-500 ml-1">+<%= bib_list.size - 3 %> more</span>
                      <% end %>
                    </div>
                  <% end %>
                </td>
                <td data-controller="incident-name-edit" 
                    data-incident-name-edit-incident-id-value="<%= incident.id %>"
                    data-incident-name-edit-race-id-value="<%= @race.id %>"
                    data-incident-name-edit-current-name-value="<%= incident.respond_to?(:custom_name) ? incident.custom_name : '' %>">
                  
                  <!-- Display mode -->
                  <div data-incident-name-edit-target="display">
                    <a href="#" 
                       data-action="click->incident-name-edit#edit" 
                       class="font-medium text-ismf-navy hover:text-ismf-blue transition-colors">
                      <%= incident.display_name %>
                    </a>
                  </div>
                  
                  <!-- Edit mode (hidden by default) -->
                  <div data-incident-name-edit-target="form" 
                       class="hidden">
                    <div class="flex items-center gap-2">
                      <input type="text" 
                             data-incident-name-edit-target="input"
                             data-action="keydown->incident-name-edit#handleKeydown"
                             value="<%= incident.respond_to?(:custom_name) ? incident.custom_name : '' %>"
                             placeholder="Incident #<%= incident.id %>"
                             class="flex-1 px-2 py-1 text-sm border border-gray-300 rounded focus:ring-2 focus:ring-ismf-blue focus:border-transparent">
                      <button type="submit" 
                              class="px-2 py-1 text-xs bg-green-500 text-white rounded hover:bg-green-600 transition-colors">
                        Save
                      </button>
                      <button type="button" 
                              data-action="click->incident-name-edit#cancel"
                              class="px-2 py-1 text-xs bg-gray-300 text-gray-700 rounded hover:bg-gray-400 transition-colors">
                        Cancel
                      </button>
                    </div>
                  </div>
                  
                  <% if incident.has_penalties? %>
                    <div class="mt-1">
                      <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-orange-100 text-orange-800"
                            title="<%= incident.penalties_tooltip %>">
                        <%= incident.penalties_display %>
                      </span>
                    </div>
                  <% end %>
                </td>
                <td class="text-ismf-gray text-sm">
                  <%= link_to admin_race_incident_path(@race, incident), class: "block hover:text-ismf-blue transition-colors" do %>
                    <div class="font-medium"><%= incident.created_at_with_seconds %></div>
                    <div class="text-xs text-gray-500 mt-0.5">
                      <%= incident.location_display %> • by <%= incident.reporters_display %>
                    </div>
                  <% end %>
                </td>
                <td>
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                    <%= incident.reports_count_display %>
                  </span>
                </td>
                <td>
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= incident.status_badge[:class] %>">
                    <%= incident.status_badge[:label] %>
                  </span>
                </td>
                <td class="text-ismf-gray text-sm">
                  <%= incident.athletes_with_flags %>
                </td>

                <td class="text-right">
                  <div class="flex items-center justify-end gap-1">
                    <%= link_to admin_race_incident_path(@race, incident), class: "inline-flex items-center justify-center w-9 h-9 rounded-lg text-gray-500 hover:text-ismf-blue hover:bg-blue-50 transition-all", title: "View" do %>
                      <svg class="w-[18px] h-[18px]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                      </svg>
                    <% end %>
                    <% if incident.pending? && policy(incident).decide? %>
                      <%= link_to edit_admin_race_incident_path(@race, incident), class: "inline-flex items-center justify-center w-9 h-9 rounded-lg text-gray-500 hover:text-green-600 hover:bg-green-50 transition-all", title: "Decide" do %>
                        <svg class="w-[18px] h-[18px]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                      <% end %>
                    <% end %>
                    <% if !incident.pending? && policy(incident).reopen? %>
                      <%= button_to reopen_admin_race_incident_path(@race, incident), method: :post, class: "inline-flex items-center justify-center w-9 h-9 rounded-lg text-gray-500 hover:text-yellow-600 hover:bg-yellow-50 transition-all", title: "Reopen" do %>
                        <svg class="w-[18px] h-[18px]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                        </svg>
                      <% end %>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="<%= policy(Incident).create? ? 8 : 7 %>" class="text-center py-12">
                <svg class="mx-auto h-12 w-12 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                </svg>
                <h3 class="mt-2 text-sm font-medium text-ismf-navy">No incidents</h3>
                <p class="mt-1 text-sm text-ismf-gray">No incidents have been created for this race yet.</p>
                <p class="mt-1 text-sm text-ismf-gray">Create incidents by merging confirmed reports.</p>
                <% if policy(Incident).create? %>
                  <div class="mt-6">
                    <%= link_to new_admin_race_incident_path(@race), class: "btn-primary whitespace-nowrap" do %>
                      <svg class="w-5 h-5 mr-2 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
                      </svg>
                      <span>Create Incident</span>
                    <% end %>
                  </div>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
