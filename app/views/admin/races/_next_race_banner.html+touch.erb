<%# Reusable next race banner component for touch displays %>
<%# Usage: render 'admin/races/next_race_banner', next_race: next_race, competition: @competition %>

<% if next_race.present? %>
  <% is_in_progress = next_race.in_progress? %>
  <% bg_color = is_in_progress ? "bg-green-400" : "bg-yellow-400" %>
  <% icon_bg = is_in_progress ? "bg-green-900/20" : "bg-yellow-900/20" %>
  <% icon_color = is_in_progress ? "text-green-900" : "text-yellow-900" %>
  <% badge_bg = is_in_progress ? "bg-green-900" : "bg-yellow-900" %>
  <% badge_text = is_in_progress ? "text-green-100" : "text-yellow-100" %>
  <% text_color = is_in_progress ? "text-green-900" : "text-yellow-900" %>
  
  <%= link_to admin_competition_race_path(competition, next_race), class: "block" do %>
    <div class="<%= bg_color %> rounded-xl p-4 shadow-lg">
      <div class="flex items-center gap-3">
        <div class="w-12 h-12 <%= icon_bg %> rounded-full flex items-center justify-center">
          <svg class="w-7 h-7 <%= icon_color %>" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <% if is_in_progress %>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            <% else %>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            <% end %>
          </svg>
        </div>
        <div class="flex-1 min-w-0">
          <div class="flex items-center gap-2 mb-1">
            <span class="px-2 py-1 text-xs font-bold rounded <%= badge_bg %> <%= badge_text %> uppercase">
              <%= is_in_progress ? "Live" : "Next" %>
            </span>
            <% unless is_in_progress %>
              <span class="text-sm font-bold <%= text_color %>">
                in <%= next_race.minutes_until_start %> min
              </span>
            <% end %>
          </div>
          <h3 class="text-base font-bold <%= text_color %> truncate">
            <%= next_race.name %>
          </h3>
        </div>
        <svg class="w-6 h-6 <%= icon_color %> shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </div>
    </div>
  <% end %>
<% end %>