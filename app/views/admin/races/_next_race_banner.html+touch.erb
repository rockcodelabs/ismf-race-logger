<%# Reusable next race banner component for touch displays %>
<%# Compact left-accent style — matches desktop/phone banner pattern %>
<%# Locals: next_race (Race struct | nil), competition (Competition AR model) %>

<% if next_race.present? %>
  <% is_live        = next_race.in_progress? %>
  <% border_bg      = is_live ? "border-green-500 bg-green-50"    : "border-orange-400 bg-orange-50/70" %>
  <% badge_class    = is_live ? "bg-green-500 text-white"         : "bg-orange-400 text-orange-900" %>
  <% badge_text     = is_live ? "Live Now"                        : "Next Up" %>
  <% name_color     = is_live ? "text-green-900"                  : "text-ismf-navy" %>
  <% meta_color     = is_live ? "text-green-700"                  : "text-ismf-gray" %>
  <% chevron_color  = is_live ? "text-green-500"                  : "text-orange-400" %>

  <%= link_to admin_competition_race_path(competition, next_race),
        class: "flex items-center gap-3 px-4 py-3 rounded-xl border border-gray-200 border-l-4 #{border_bg} shadow-sm active:scale-95 transition-transform" do %>

    <%# Status badge %>
    <span class="px-2.5 py-1 text-xs font-bold rounded-full <%= badge_class %> uppercase tracking-wide shrink-0">
      <%= badge_text %>
      <% if is_live %>
        <span class="inline-block w-1.5 h-1.5 rounded-full bg-white/80 animate-pulse ml-0.5 -mb-0.5"></span>
      <% end %>
    </span>

    <%# Race name + meta %>
    <div class="flex-1 min-w-0">
      <p class="text-sm font-bold <%= name_color %> truncate"><%= next_race.name %></p>
      <p class="text-xs <%= meta_color %> mt-0.5 flex items-center gap-1 flex-wrap">
        <% if next_race.scheduled_at.present? %>
          <svg class="w-3 h-3 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span><%= next_race.formatted_scheduled_time %></span>
          <span class="opacity-40">·</span>
        <% end %>
        <span><%= next_race.stage_display %></span>
        <span class="opacity-40">·</span>
        <span><%= next_race.gender_category_display %></span>
      </p>
    </div>

    <%# Chevron %>
    <svg class="w-5 h-5 <%= chevron_color %> shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
    </svg>

  <% end %>
<% end %>