<% content_for :page_title, @race.name %>

<div class="h-screen overflow-hidden flex flex-col bg-gray-100">

  <!-- Header -->
  <div class="shrink-0 bg-ismf-navy px-4 pt-4 pb-5">
    <!-- Back link -->
    <%= link_to admin_competition_path(@competition), class: "inline-flex items-center gap-1.5 text-white/70 text-sm mb-3 active:text-white" do %>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
      </svg>
      <%= @competition.name.truncate(30) %>
    <% end %>

    <!-- Race Name -->
    <h1 class="text-xl font-bold text-white leading-tight"><%= @race.name %></h1>

    <!-- Race Meta Pills -->
    <div class="flex items-center gap-2 mt-2 overflow-x-auto overflow-y-hidden pb-2">
      <span class="shrink-0 px-2.5 py-1 text-xs font-bold rounded-full
        <%= case @race.status
          when 'in_progress' then 'bg-green-400 text-green-900'
          when 'completed'   then 'bg-gray-400 text-gray-900'
          when 'cancelled'   then 'bg-red-400 text-red-900'
          else 'bg-blue-400 text-blue-900'
          end %>">
        <%= @race.status.titleize %>
      </span>
      <span class="px-2 py-0.5 text-xs font-medium rounded-full bg-white/15 text-white/90">
        <%= @race.race_type_name %>
      </span>
      <span class="px-2 py-0.5 text-xs font-medium rounded-full bg-white/15 text-white/90">
        <%= @race.stage_name %>
      </span>
      <% if @race.gender_category_display.present? %>
        <span class="px-2 py-0.5 text-xs font-medium rounded-full bg-white/15 text-white/90">
          <%= @race.gender_category_display %>
        </span>
      <% end %>
      <% if @race.scheduled_at.present? %>
        <span class="px-2 py-0.5 text-xs font-medium rounded-full bg-white/15 text-white/90">
          🕐 <%= @race.formatted_scheduled_time %>
        </span>
      <% end %>
    </div>
  </div>

  <!-- Scrollable Content -->
  <div class="flex-1 overflow-y-auto px-4 py-4 space-y-3">

    <!-- Primary Actions: Reports & Incidents -->
    <% status_counts = AppContainer["repos.report"].visible_count_by_status(@race.id) rescue {} %>
    <% report_count  = status_counts.values.sum.to_i %>
    <% pending_count = status_counts["pending_review"].to_i %>
    <% incident_count = (AppContainer["repos.incident"].count_by_status(@race.id).values.sum rescue 0).to_i %>

    <!-- Reports Button Card -->
    <%= link_to admin_race_reports_path(@race),
        class: "flex items-center gap-4 w-full px-4 py-4 rounded-2xl font-bold text-white active:scale-95 transition-transform #{ @race.status == 'in_progress' ? 'bg-gray-600' : 'bg-gray-500' }" do %>
      <div class="w-12 h-12 rounded-xl bg-white/20 flex items-center justify-center shrink-0">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
      </div>
      <div class="flex-1 min-w-0">
        <p class="text-lg font-bold leading-none">View Reports</p>
        <p class="text-sm text-white/80 mt-0.5">
          <%= report_count %> total
          <% if pending_count > 0 %>
            • <span class="font-bold text-yellow-200"><%= pending_count %> pending</span>
          <% end %>
        </p>
      </div>
      <svg class="w-6 h-6 text-white/60 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
    <% end %>

    <!-- Divider -->
    <div class="border-t border-gray-300 pt-2 mt-2">
      <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-2 px-1">Race Management</p>
    </div>

    <!-- Secondary Actions Grid -->
    <div class="grid grid-cols-2 gap-3">

      <!-- Manage Locations -->
      <%= link_to admin_race_race_locations_path(@race),
          class: "flex flex-col items-center justify-center gap-2 px-3 py-4 bg-white rounded-xl text-ismf-navy font-semibold text-sm active:bg-gray-100 transition border border-gray-200" do %>
        <svg class="w-6 h-6 text-ismf-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
        Locations
      <% end %>

      <!-- Edit Race -->
      <% if @race.can_edit? %>
        <%= link_to edit_admin_competition_race_path(@competition, @race),
            class: "flex flex-col items-center justify-center gap-2 px-3 py-4 bg-white rounded-xl text-ismf-navy font-semibold text-sm active:bg-gray-100 transition border border-gray-200" do %>
          <svg class="w-6 h-6 text-ismf-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
          </svg>
          Edit Race
        <% end %>
      <% end %>

      <!-- Participants count (info tile) -->
      <div class="flex flex-col items-center justify-center gap-1 px-3 py-4 bg-white rounded-xl border border-gray-200">
        <span class="text-2xl font-black text-ismf-navy"><%= @participations.size %></span>
        <span class="text-xs font-semibold text-gray-500">Athletes</span>
      </div>
    </div>

    <!-- Race Status Actions -->
    <% if @race.status == 'in_progress' && policy(@race).update? %>
      <div class="pt-1">
        <%= button_to complete_admin_competition_race_path(@competition, @race),
            method: :post,
            class: "w-full flex items-center justify-center gap-2 px-4 py-3.5 rounded-xl bg-blue-600 text-white font-bold text-sm active:scale-95 transition-transform",
            data: { turbo_confirm: "Mark this race as completed? This cannot be undone." } do %>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          Mark Race as Completed
        <% end %>
      </div>
    <% end %>

  </div>
</div>