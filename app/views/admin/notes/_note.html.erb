<%# Individual note partial %>
<%# Usage: render "admin/notes/note", note: note %>

<% is_owner = note.user_id == Current.user&.id %>
<% editing = local_assigns[:editing] %>

<%= turbo_frame_tag "note_#{note.id}" do %>
  <div class="group rounded-lg border border-gray-100 bg-gray-50 p-3">
    <% if editing %>
      <!-- Edit Form -->
      <%= form_with url: admin_note_path(note.id), method: :patch, class: "space-y-3" do |f| %>
        <textarea
          name="body"
          rows="2"
          required
          autofocus
          class="w-full rounded-lg border-gray-300 shadow-sm text-sm focus:border-ismf-blue focus:ring-ismf-blue resize-none"
        ><%= note.body %></textarea>

        <div class="flex items-center gap-2 justify-end">
          <%= link_to "Cancel", request.url, class: "px-3 py-1.5 text-sm text-gray-600 hover:text-gray-800 transition-colors" %>
          <%= f.button type: :submit, class: "inline-flex items-center gap-1 px-3 py-1.5 text-sm font-medium text-white bg-ismf-blue rounded-lg hover:bg-blue-700 transition-colors" do %>
            Save
          <% end %>
        </div>
      <% end %>
    <% else %>
      <!-- Display -->
      <div class="flex items-start justify-between gap-2">
        <div class="flex-1 min-w-0">
          <p class="text-sm text-ismf-navy whitespace-pre-line break-words"><%= note.body %></p>
        </div>
        <% if is_owner %>
          <div class="flex items-center gap-1 shrink-0 opacity-0 group-hover:opacity-100 transition-opacity">
            <%= link_to edit_admin_note_path(note.id), class: "p-1 text-gray-400 hover:text-ismf-blue rounded transition-colors", title: "Edit" do %>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
              </svg>
            <% end %>
            <%= button_to admin_note_path(note.id), method: :delete,
                class: "p-1 text-gray-400 hover:text-red-600 rounded transition-colors",
                title: "Delete",
                data: { turbo_confirm: "Delete this note?" } do %>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
              </svg>
            <% end %>
          </div>
        <% end %>
      </div>
      <div class="mt-1.5 flex items-center gap-2 text-xs text-gray-400">
        <span class="font-medium text-gray-500"><%= note.user_name || "Unknown" %></span>
        <span>&middot;</span>
        <time datetime="<%= note.created_at.iso8601 %>" title="<%= note.created_at.strftime('%b %d, %Y %H:%M') %>">
          <%= time_ago_in_words(note.created_at) %> ago
        </time>
        <% if note.edited? %>
          <span>&middot;</span>
          <span class="italic">edited</span>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>