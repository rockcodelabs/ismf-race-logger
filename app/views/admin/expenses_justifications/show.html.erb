<% part = @parts_factory.wrap(@expenses_justification) %>

<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <!-- Back button -->
  <div class="mb-6">
    <%= link_to admin_expenses_justifications_path, class: "inline-flex items-center text-sm font-medium text-gray-700 hover:text-gray-900" do %>
      <svg class="mr-2 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
      </svg>
      Back to list
    <% end %>
  </div>

  <!-- Page header -->
  <div class="mb-8">
    <div class="flex items-start justify-between">
      <div>
        <h1 class="text-3xl font-bold text-gray-900">Expense Justification</h1>
        <p class="mt-2 text-sm text-gray-600">
          Submitted by <%= @expenses_justification.user_name || @expenses_justification.user_email %>
        </p>
      </div>
      <div class="flex flex-col items-end gap-2">
        <%= part.status_badge %>
        <% if @expenses_justification.approved? %>
          <%= part.paid_badge %>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Main content -->
  <div class="space-y-6">
    <!-- Competition Information -->
    <div class="bg-white shadow rounded-lg overflow-hidden">
      <div class="px-6 py-4 border-b border-gray-200 bg-gray-50">
        <h2 class="text-lg font-semibold text-gray-900">Competition Details</h2>
      </div>
      <div class="px-6 py-4">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-sm font-medium text-gray-700">Competition</p>
            <p class="mt-1 text-lg text-gray-900"><%= @expenses_justification.competition_name || "Competition ##{@expenses_justification.competition_id}" %></p>
          </div>
          <%= link_to "View Competition", admin_competition_path(@expenses_justification.competition_id), class: "text-sm text-blue-600 hover:text-blue-800" if @expenses_justification.competition_id %>
        </div>
      </div>
    </div>

    <!-- User Information -->
    <div class="bg-white shadow rounded-lg overflow-hidden">
      <div class="px-6 py-4 border-b border-gray-200 bg-gray-50">
        <h2 class="text-lg font-semibold text-gray-900">Submitted By</h2>
      </div>
      <div class="px-6 py-4">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-gray-700">User Name</label>
            <p class="mt-1 text-sm text-gray-900"><%= @expenses_justification.user_name %></p>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700">Email</label>
            <p class="mt-1 text-sm text-gray-900"><%= @expenses_justification.user_email %></p>
          </div>
        </div>
      </div>
    </div>

    <!-- Personal Information -->
    <div class="bg-white shadow rounded-lg overflow-hidden">
      <div class="px-6 py-4 border-b border-gray-200 bg-gray-50">
        <h2 class="text-lg font-semibold text-gray-900">Personal Information</h2>
      </div>
      <div class="px-6 py-4 space-y-4">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-gray-700">Name</label>
            <p class="mt-1 text-sm text-gray-900"><%= @expenses_justification.name %></p>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700">Identity Document Number</label>
            <p class="mt-1 text-sm text-gray-900"><%= @expenses_justification.identity_document_number %></p>
          </div>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700">Address</label>
          <p class="mt-1 text-sm text-gray-900 whitespace-pre-wrap"><%= @expenses_justification.address %></p>
        </div>
      </div>
    </div>

    <!-- Bank Information -->
    <div class="bg-white shadow rounded-lg overflow-hidden">
      <div class="px-6 py-4 border-b border-gray-200 bg-gray-50">
        <h2 class="text-lg font-semibold text-gray-900">Bank Information</h2>
      </div>
      <div class="px-6 py-4 space-y-4">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-gray-700">SWIFT/BIC</label>
            <p class="mt-1 text-sm text-gray-900 font-mono"><%= @expenses_justification.bank_swift %></p>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700">IBAN</label>
            <p class="mt-1 text-sm text-gray-900 font-mono"><%= @expenses_justification.bank_iban %></p>
          </div>
        </div>
      </div>
    </div>

    <!-- Trip Details -->
    <div class="bg-white shadow rounded-lg overflow-hidden">
      <div class="px-6 py-4 border-b border-gray-200 bg-gray-50">
        <h2 class="text-lg font-semibold text-gray-900">Trip Details</h2>
      </div>
      <div class="px-6 py-4 space-y-4">
        <div>
          <label class="block text-sm font-medium text-gray-700">Reason of Travel</label>
          <p class="mt-1 text-sm text-gray-900"><%= @expenses_justification.reason_of_travel %></p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <div>
            <label class="block text-sm font-medium text-gray-700">Charged Of</label>
            <p class="mt-1 text-sm text-gray-900"><%= @expenses_justification.charged_of || "N/A" %></p>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700">Place</label>
            <p class="mt-1 text-sm text-gray-900"><%= @expenses_justification.place || "N/A" %></p>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700">Country</label>
            <p class="mt-1 text-sm text-gray-900"><%= @expenses_justification.country || "N/A" %></p>
          </div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <div>
            <label class="block text-sm font-medium text-gray-700">Travel Start Date</label>
            <p class="mt-1 text-sm text-gray-900"><%= @expenses_justification.travel_start_date.strftime("%d/%m/%Y") %></p>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700">Travel End Date</label>
            <p class="mt-1 text-sm text-gray-900"><%= @expenses_justification.travel_end_date.strftime("%d/%m/%Y") %></p>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700">Days</label>
            <p class="mt-1 text-sm text-gray-900"><%= @expenses_justification.travel_days %></p>
          </div>
        </div>
      </div>
    </div>

    <!-- Total Amount -->
    <div class="bg-white shadow rounded-lg overflow-hidden">
      <div class="px-6 py-4 border-b border-gray-200 bg-gray-50">
        <h2 class="text-lg font-semibold text-gray-900">Total Amount</h2>
      </div>
      <div class="px-6 py-4">
        <div class="flex items-center justify-between">
          <span class="text-sm font-medium text-gray-700">Reimbursement Amount</span>
          <%= part.total_amount_badge %>
        </div>
      </div>
    </div>

    <!-- Invoices -->
    <div class="bg-white shadow rounded-lg overflow-hidden">
      <div class="px-6 py-4 border-b border-gray-200 bg-gray-50 flex items-center justify-between">
        <h2 class="text-lg font-semibold text-gray-900">Invoices & Receipts</h2>
        <%= part.invoice_count_badge %>
      </div>
      <div class="px-6 py-4">
        <% if @expenses_justification.invoices.present? && @expenses_justification.invoices.any? %>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            <% @expenses_justification.invoices.each do |invoice| %>
              <div class="border border-gray-200 rounded-lg p-4 hover:shadow-md transition-shadow">
                <div class="flex items-center justify-between mb-3">
                  <div class="flex items-center">
                    <svg class="h-10 w-10 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
                    </svg>
                  </div>
                </div>
                <p class="text-sm font-medium text-gray-900 truncate"><%= invoice.filename %></p>
                <p class="text-xs text-gray-500 mb-3"><%= number_to_human_size(invoice.byte_size) %></p>
                <div class="flex gap-2">
                  <%= link_to rails_blob_path(invoice, disposition: "inline"), target: "_blank", class: "text-xs text-blue-600 hover:text-blue-800 font-medium" do %>
                    View
                  <% end %>
                  <%= link_to rails_blob_path(invoice, disposition: "attachment"), class: "text-xs text-blue-600 hover:text-blue-800 font-medium" do %>
                    Download
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        <% else %>
          <p class="text-sm text-gray-500 text-center py-8">No invoices uploaded.</p>
        <% end %>
      </div>
    </div>

    <!-- Timeline -->
    <div class="bg-white shadow rounded-lg overflow-hidden">
      <div class="px-6 py-4 border-b border-gray-200 bg-gray-50">
        <h2 class="text-lg font-semibold text-gray-900">Timeline</h2>
      </div>
      <div class="px-6 py-4">
        <%= part.timeline_display %>
      </div>
    </div>

    <!-- Rejection Reason -->
    <% if @expenses_justification.rejected? && @expenses_justification.rejection_reason.present? %>
      <%= part.rejection_reason_display %>
    <% end %>

    <!-- Admin Actions -->
    <div class="bg-gray-50 border border-gray-200 rounded-lg p-6">
      <h3 class="text-lg font-semibold text-gray-900 mb-4">Admin Actions</h3>
      
      <% if @expenses_justification.sent? %>
        <!-- Approve/Reject actions -->
        <div class="space-y-3">
          <%= button_to "✓ Approve Expense Justification", 
              approve_admin_expenses_justification_path(@expenses_justification.id), 
              method: :patch,
              data: { turbo_confirm: "Are you sure you want to approve this expense justification? The user will be notified by email." },
              class: "w-full inline-flex items-center justify-center px-4 py-3 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-green-600 hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500" %>
          
          <!-- Reject form -->
          <div class="border border-gray-300 rounded-md p-4 bg-white">
            <%= form_with url: reject_admin_expenses_justification_path(@expenses_justification.id), method: :patch do |f| %>
              <label class="block text-sm font-medium text-gray-700 mb-2">Rejection Reason (required)</label>
              <%= text_area_tag :rejection_reason, nil, rows: 3, required: true, class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-red-500 focus:ring-red-500 mb-3", placeholder: "Please provide a reason for rejection..." %>
              <%= f.submit "✗ Reject Expense Justification", class: "w-full inline-flex items-center justify-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-red-600 hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500" %>
            <% end %>
          </div>
        </div>
      <% elsif @expenses_justification.approved? && !@expenses_justification.paid? %>
        <!-- Mark as paid action -->
        <%= button_to "💰 Mark as Paid", 
            mark_as_paid_admin_expenses_justification_path(@expenses_justification.id), 
            method: :patch,
            data: { turbo_confirm: "Mark this expense justification as paid?" },
            class: "w-full inline-flex items-center justify-center px-4 py-3 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" %>
      <% else %>
        <p class="text-sm text-gray-600">No actions available for this status.</p>
      <% end %>

      <!-- Edit/Delete always available -->
      <div class="mt-4 pt-4 border-t border-gray-200 flex gap-3">
        <%= link_to "Edit", edit_admin_expenses_justification_path(@expenses_justification.id), class: "flex-1 inline-flex items-center justify-center px-4 py-2 border border-gray-300 shadow-sm text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50" %>
        <%= button_to "Delete", admin_expenses_justification_path(@expenses_justification.id), method: :delete, data: { turbo_confirm: "Are you sure you want to delete this expense justification? This action cannot be undone." }, class: "flex-1 inline-flex items-center justify-center px-4 py-2 border border-red-300 shadow-sm text-sm font-medium rounded-md text-red-700 bg-white hover:bg-red-50" %>
      </div>
    </div>
  </div>
</div>

<%= turbo_stream_from "expenses_justifications" %>