<div class="space-y-6">
  <!-- Page header -->
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-bold text-ismf-navy">Expense Justifications</h1>
      <p class="mt-1 text-sm text-ismf-gray">Manage all expense reimbursement requests.</p>
    </div>
  </div>

  <!-- Status filter tabs -->
  <div class="card">
    <div class="p-4">
      <div class="flex items-center gap-2 overflow-x-auto">
        <%= link_to admin_expenses_justifications_path, 
            class: "px-4 py-2 text-sm font-medium rounded-lg transition-colors #{params[:status].blank? ? 'bg-ismf-blue text-white' : 'text-gray-600 hover:bg-gray-100'}" do %>
          All
          <span class="ml-1 text-xs opacity-75">(<%= @expenses_justifications.count %>)</span>
        <% end %>
        
        <%= link_to admin_expenses_justifications_path(status: 'draft'), 
            class: "px-4 py-2 text-sm font-medium rounded-lg transition-colors #{params[:status] == 'draft' ? 'bg-gray-100 text-gray-800' : 'text-gray-600 hover:bg-gray-100'}" do %>
          Drafts
          <span class="ml-1 text-xs opacity-75">(<%= @status_counts['draft'] || 0 %>)</span>
        <% end %>
        
        <%= link_to admin_expenses_justifications_path(status: 'sent'), 
            class: "px-4 py-2 text-sm font-medium rounded-lg transition-colors #{params[:status] == 'sent' ? 'bg-blue-100 text-blue-800' : 'text-gray-600 hover:bg-gray-100'}" do %>
          Pending Approval
          <span class="ml-1 text-xs opacity-75">(<%= @status_counts['sent'] || 0 %>)</span>
        <% end %>
        
        <%= link_to admin_expenses_justifications_path(status: 'approved'), 
            class: "px-4 py-2 text-sm font-medium rounded-lg transition-colors #{params[:status] == 'approved' ? 'bg-green-100 text-green-800' : 'text-gray-600 hover:bg-gray-100'}" do %>
          Approved
          <span class="ml-1 text-xs opacity-75">(<%= @status_counts['approved'] || 0 %>)</span>
        <% end %>
        
        <%= link_to admin_expenses_justifications_path(status: 'rejected'), 
            class: "px-4 py-2 text-sm font-medium rounded-lg transition-colors #{params[:status] == 'rejected' ? 'bg-red-100 text-red-800' : 'text-gray-600 hover:bg-gray-100'}" do %>
          Rejected
          <span class="ml-1 text-xs opacity-75">(<%= @status_counts['rejected'] || 0 %>)</span>
        <% end %>

        <% if @unpaid_count > 0 %>
          <div class="ml-auto px-3 py-1 bg-yellow-100 text-yellow-800 rounded-full text-xs font-medium">
            <%= @unpaid_count %> unpaid
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Expenses list -->
  <div id="expenses_justifications">
    <% if @expenses_justifications.any? %>
      <div class="space-y-4">
        <% @expenses_justifications.each do |expenses_justification| %>
          <% part = @parts_factory.wrap(expenses_justification) %>
          <div id="<%= part.dom_id %>" class="card hover:shadow-lg transition-shadow">
            <div class="p-6">
              <div class="flex items-start justify-between">
                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-3 mb-3">
                    <h3 class="text-lg font-semibold text-ismf-navy">
                      <%= expenses_justification.name %>
                    </h3>
                    <%= part.status_badge %>
                    <% if expenses_justification.approved? %>
                      <%= part.paid_badge %>
                    <% end %>
                  </div>

                  <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-sm text-gray-600">
                    <div class="flex items-center">
                      <svg class="flex-shrink-0 mr-1.5 h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
                      </svg>
                      <%= expenses_justification.competition_name || "Competition ##{expenses_justification.competition_id}" %>
                    </div>

                    <div class="flex items-center">
                      <svg class="flex-shrink-0 mr-1.5 h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                      </svg>
                      <%= expenses_justification.travel_period %>
                    </div>

                    <div class="flex items-center">
                      <svg class="flex-shrink-0 mr-1.5 h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                      </svg>
                      <%= expenses_justification.user_name || expenses_justification.user_email %>
                    </div>
                  </div>

                  <div class="mt-3 flex items-center gap-4">
                    <%= part.total_amount_badge %>
                    <%= part.invoice_count_badge %>
                    <% if expenses_justification.submitted_at.present? %>
                      <span class="text-xs text-gray-500">
                        Submitted <%= time_ago_in_words(expenses_justification.submitted_at) %> ago
                      </span>
                    <% end %>
                  </div>
                </div>

                <div class="ml-4 flex-shrink-0 flex items-center gap-2">
                  <%= link_to admin_expenses_justification_path(expenses_justification.id), class: "inline-flex items-center px-3 py-2 border border-gray-300 shadow-sm text-sm leading-4 font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50" do %>
                    View Details
                  <% end %>
                </div>
              </div>

              <!-- Quick actions for pending -->
              <% if expenses_justification.sent? %>
                <div class="mt-4 pt-4 border-t border-gray-200 flex gap-2">
                  <%= button_to "Approve", 
                      approve_admin_expenses_justification_path(expenses_justification.id), 
                      method: :patch,
                      data: { turbo_confirm: "Approve this expense justification?" },
                      class: "inline-flex items-center px-3 py-1.5 border border-transparent shadow-sm text-xs font-medium rounded text-white bg-green-600 hover:bg-green-700" %>
                  <%= link_to "Reject", 
                      admin_expenses_justification_path(expenses_justification.id),
                      class: "inline-flex items-center px-3 py-1.5 border border-gray-300 shadow-sm text-xs font-medium rounded text-gray-700 bg-white hover:bg-gray-50" %>
                </div>
              <% end %>

              <!-- Quick action for approved unpaid -->
              <% if expenses_justification.approved? && !expenses_justification.paid? %>
                <div class="mt-4 pt-4 border-t border-gray-200">
                  <%= button_to "Mark as Paid", 
                      mark_as_paid_admin_expenses_justification_path(expenses_justification.id), 
                      method: :patch,
                      data: { turbo_confirm: "Mark this expense as paid?" },
                      class: "inline-flex items-center px-3 py-1.5 border border-transparent shadow-sm text-xs font-medium rounded text-white bg-blue-600 hover:bg-blue-700" %>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <!-- Empty state -->
      <div class="card">
        <div class="text-center py-12">
          <svg class="mx-auto h-12 w-12 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          <h3 class="mt-2 text-sm font-medium text-ismf-navy">No expense justifications</h3>
          <p class="mt-1 text-sm text-ismf-gray">
            <% if params[:status].present? %>
              No expense justifications with status "<%= params[:status] %>".
            <% else %>
              No expense justifications have been submitted yet.
            <% end %>
          </p>
        </div>
      </div>
    <% end %>
  </div>
</div>

<%= turbo_stream_from "expenses_justifications" %>