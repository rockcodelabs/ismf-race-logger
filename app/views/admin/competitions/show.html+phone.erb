<%# frozen_string_literal: true %>
<% content_for :page_title, @competition.display_name %>

<% stage_order     = %w[qualification heat quarterfinal semifinal final] %>
<% normalize_stage = ->(s) { s&.downcase&.gsub("_", "") || "other" } %>
<% current_view    = params[:view].presence || "races" %>

<div class="h-screen overflow-hidden flex flex-col bg-gray-100">

  <%# ── Compact Header ──────────────────────────────────────────────────────── %>
  <div class="shrink-0 bg-ismf-navy px-3 pt-3 pb-2">
    <%# Row 1: Back + Name + Status %>
    <div class="flex items-center gap-2">
      <%= link_to admin_competitions_path, class: "p-1.5 -ml-1.5 text-white/70 active:text-white shrink-0" do %>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
      <% end %>

      <h1 class="flex-1 text-base font-bold text-white truncate"><%= @competition.display_name %></h1>

      <span class="shrink-0 px-2 py-0.5 text-[10px] font-bold rounded-full uppercase
        <%= case @competition.status
          when 'active'     then 'bg-green-400 text-green-900'
          when 'completed'  then 'bg-gray-400 text-gray-900'
          when 'cancelled'  then 'bg-red-400 text-red-900'
          else 'bg-blue-400 text-blue-900'
          end %>">
        <%= @competition.status.titleize %>
      </span>
    </div>

    <%# Row 2: Location + Date %>
    <p class="text-xs text-white/60 mt-1 truncate pl-7">
      <%= @competition.country_flag_emoji %> <%= @competition.place %>
      <% if @competition.short_date_range.present? %>
        · <%= @competition.short_date_range %>
      <% end %>
    </p>
  </div>

  <%# ── Tab Bar ─────────────────────────────────────────────────────────────── %>
  <div class="shrink-0 bg-white border-b border-gray-200 flex">
    <%= link_to admin_competition_path(@competition_record),
          class: "flex-1 py-2.5 text-center text-sm font-semibold transition-colors #{current_view == 'races' ? 'text-ismf-navy border-b-2 border-ismf-navy' : 'text-gray-400'}" do %>
      Races
    <% end %>
    <%= link_to admin_competition_path(@competition_record, view: "reports"),
          class: "flex-1 py-2.5 text-center text-sm font-semibold transition-colors #{current_view == 'reports' ? 'text-ismf-navy border-b-2 border-ismf-navy' : 'text-gray-400'}" do %>
      Reports
    <% end %>
  </div>

  <%# ── Scrollable body ─────────────────────────────────────────────────────── %>
  <div class="flex-1 overflow-y-auto">

    <% if current_view == "reports" %>

      <%# ══════════════════════════════════════════════════════════════════════ %>
      <%# REPORTS TAB                                                           %>
      <%# ══════════════════════════════════════════════════════════════════════ %>
      <div class="px-3 py-3 space-y-1">
        <% if @competition_reports&.any? %>
          <% @competition_reports.each do |report| %>
            <% video_url = @report_first_video_url&.dig(report.id) %>

            <div class="flex items-center gap-3 px-3 py-2.5 bg-white rounded-lg border border-gray-200">

              <%# Bib %>
              <span class="text-base font-bold text-ismf-navy shrink-0 w-12 text-center">
                <%= report.bib_number || "?" %>
              </span>

              <%# Name + Country %>
              <div class="flex-1 min-w-0">
                <p class="text-sm font-semibold text-ismf-navy truncate">
                  <%= report.athlete_name.presence || "Unknown" %>
                </p>
                <% if report.athlete_country.present? %>
                  <p class="text-xs text-gray-500"><%= report.athlete_country %></p>
                <% end %>
              </div>

              <%# Video play button (opens phone player directly) %>
              <% if video_url %>
                <button type="button"
                        onclick="event.stopPropagation(); openPhoneVideoPlayer('<%= video_url %>');"
                        class="shrink-0 w-12 h-12 flex items-center justify-center bg-blue-600 hover:bg-blue-700 active:scale-95 rounded-full text-white shadow-lg">
                  <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M8 5v14l11-7z"/>
                  </svg>
                </button>
              <% else %>
                <%# No video - show disabled state %>
                <span class="shrink-0 w-12 h-12 flex items-center justify-center bg-gray-200 rounded-full text-gray-400">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
                  </svg>
                </span>
              <% end %>

            </div>
          <% end %>
        <% else %>
          <%# Empty reports state %>
          <div class="flex flex-col items-center justify-center py-16 text-center">
            <div class="w-14 h-14 rounded-full bg-gray-200 flex items-center justify-center mb-3">
              <svg class="w-7 h-7 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
            </div>
            <h3 class="text-sm font-bold text-gray-700">No reports yet</h3>
            <p class="text-xs text-gray-500 mt-1">Reports will appear here when created.</p>
          </div>
        <% end %>
      </div>

    <% else %>

      <%# ══════════════════════════════════════════════════════════════════════ %>
      <%# RACES TAB (default)                                                   %>
      <%# ══════════════════════════════════════════════════════════════════════ %>
      <div class="px-3 py-3 space-y-2">

        <% if @races_by_type.any? %>

          <%# ── Determine active race ──────────────────────────────────────── %>
          <% all_races   = @races_by_type.values.flatten %>
          <% active_race = all_races.find(&:in_progress?) ||
                           all_races.select(&:upcoming?).min_by { |r| r.scheduled_at || Time.new(9999) } %>
          <% active_type = active_race&.race_type_name %>

          <%# ── Active race banner ─────────────────────────────────────────── %>
          <% if active_race %>
            <% is_live       = active_race.in_progress? %>
            <% border_bg     = is_live ? "border-green-500 bg-green-50"    : "border-orange-400 bg-orange-50/70" %>
            <% badge_class   = is_live ? "bg-green-500 text-white"         : "bg-orange-400 text-orange-900" %>
            <% badge_label   = is_live ? "Live"                            : "Next" %>
            <% name_color    = is_live ? "text-green-900"                  : "text-ismf-navy" %>
            <% meta_color    = is_live ? "text-green-700"                  : "text-ismf-gray" %>
            <% chevron_color = is_live ? "text-green-500"                  : "text-orange-400" %>

            <%= link_to admin_competition_race_path(active_race.competition_id, active_race),
                  class: "flex items-center gap-2.5 px-3 py-2 rounded-xl border border-gray-200 border-l-4 #{border_bg} shadow-sm active:scale-95 transition-transform" do %>

              <span class="px-2 py-0.5 text-[10px] font-bold rounded-full <%= badge_class %> uppercase shrink-0">
                <%= badge_label %>
              </span>

              <div class="flex-1 min-w-0">
                <p class="text-sm font-bold <%= name_color %> truncate"><%= active_race.name %></p>
                <p class="text-[10px] <%= meta_color %> flex items-center gap-1">
                  <% if active_race.scheduled_at.present? %>
                    <%= active_race.formatted_scheduled_time %> ·
                  <% end %>
                  <%= active_race.stage_display %> · <%= active_race.gender_category_display %>
                </p>
              </div>

              <svg class="w-5 h-5 <%= chevron_color %> shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            <% end %>
          <% end %>

          <%# ── Race type accordion sections ───────────────────────────────── %>
          <% @races_by_type.each do |race_type_name, races| %>
            <% is_open       = race_type_name == active_type %>
            <% sorted_all    = races.sort_by { |r| [stage_order.index(normalize_stage.(r.stage_type)) || 99, r.position] } %>
            <% stages_sorted = sorted_all.group_by { |r| normalize_stage.(r.stage_type) }
                                         .sort_by  { |stage, _| stage_order.index(stage) || 99 } %>

            <details <%= "open" if is_open %> class="rounded-xl border border-gray-200 overflow-hidden bg-white shadow-sm">

              <%# Summary ────────────────────────────────────────────────────── %>
              <summary class="px-3 py-2.5 bg-gray-50 active:bg-gray-100 cursor-pointer flex items-center gap-2.5 select-none">
                <div class="w-6 h-6 bg-purple-100 rounded-lg flex items-center justify-center shrink-0">
                  <% case race_type_name&.downcase %>
                  <% when "sprint" %>
                    <svg class="w-3.5 h-3.5 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                    </svg>
                  <% when "vertical" %>
                    <svg class="w-3.5 h-3.5 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18" />
                    </svg>
                  <% when "individual" %>
                    <svg class="w-3.5 h-3.5 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                    </svg>
                  <% when "relay", "mixed relay" %>
                    <svg class="w-3.5 h-3.5 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
                    </svg>
                  <% else %>
                    <svg class="w-3.5 h-3.5 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                  <% end %>
                </div>

                <div class="flex-1 min-w-0">
                  <span class="font-semibold text-ismf-navy text-sm"><%= race_type_name&.titleize || "Unknown" %></span>
                  <span class="text-[10px] text-gray-400 ml-1">(<%= races.count %>)</span>
                </div>

                <% if is_open && active_race %>
                  <span class="w-2 h-2 rounded-full <%= active_race.in_progress? ? 'bg-green-500 animate-pulse' : 'bg-orange-400' %> shrink-0"></span>
                <% end %>

                <svg class="w-4 h-4 text-gray-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </summary>

              <%# Stage sub-groups ───────────────────────────────────────────── %>
              <div class="divide-y divide-gray-100">
                <% stages_sorted.each do |stage, stage_races| %>
                  <% stage_has_active = stage_races.any? { |r| r.id == active_race&.id } %>

                  <details <%= "open" if stage_has_active %> class="group/stage">
                    <summary class="flex items-center justify-between px-3 py-2 cursor-pointer select-none active:bg-gray-50 list-none">
                      <span class="text-[10px] font-bold uppercase tracking-widest text-gray-400">
                        <%= stage_races.first.stage_name.presence || stage.titleize %>
                        <% if stage_races.count > 1 %>
                          <span class="font-normal opacity-60">(<%= stage_races.count %>)</span>
                        <% end %>
                      </span>
                      <svg class="w-3 h-3 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                      </svg>
                    </summary>

                    <div class="space-y-0.5 px-2 pb-2">
                      <% stage_races.each do |race| %>
                        <% is_active_row = race.id == active_race&.id %>
                        <% row_bg = is_active_row ? "bg-blue-50 active:bg-blue-100" : "active:bg-gray-100" %>
                        <% race_path = race.completed? ? admin_race_reports_path(race) : admin_competition_race_path(race.competition_id, race) %>

                        <%= link_to race_path,
                              class: "flex items-center gap-2 px-2 py-1.5 rounded-lg #{row_bg} transition-colors active:scale-95 min-h-[40px]" do %>

                          <% dot_class = case race.status
                                         when "in_progress" then "bg-green-500 animate-pulse"
                                         when "completed"   then "bg-gray-300"
                                         when "cancelled"   then "bg-red-400"
                                         else                    "bg-blue-400"
                                         end %>
                          <span class="w-1.5 h-1.5 rounded-full <%= dot_class %> shrink-0"></span>

                          <span class="flex-1 text-sm font-semibold text-ismf-navy truncate">
                            <%= race.name %>
                          </span>

                          <% if race.scheduled_at.present? %>
                            <span class="text-[10px] text-gray-400 shrink-0">
                              <%= race.formatted_scheduled_time %>
                            </span>
                          <% end %>

                          <% badge_text, badge_css = case race.status
                                                      when "in_progress" then ["Live",   "bg-green-100 text-green-800"]
                                                      when "completed"   then ["Done",   "bg-gray-100  text-gray-500"]
                                                      when "cancelled"   then ["X",      "bg-red-100   text-red-700"]
                                                      else                    ["Soon",   "bg-blue-100  text-blue-700"]
                                                      end %>
                          <span class="px-1.5 py-0.5 text-[9px] font-bold rounded-full <%= badge_css %> shrink-0">
                            <%= badge_text %>
                          </span>

                          <svg class="w-3 h-3 text-gray-300 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                          </svg>
                        <% end %>
                      <% end %>
                    </div>
                  </details>
                <% end %>
              </div>

            </details>
          <% end %>

        <% else %>

          <%# Empty races state %>
          <div class="flex flex-col items-center justify-center py-16 text-center">
            <div class="w-14 h-14 rounded-full bg-gray-200 flex items-center justify-center mb-3">
              <svg class="w-7 h-7 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            </div>
            <h3 class="text-sm font-bold text-gray-700">No races yet</h3>
            <p class="text-xs text-gray-500 mt-1">Races will appear here once added.</p>
          </div>

        <% end %>

      </div>

    <% end %>

  </div>
</div>