<%# frozen_string_literal: true %>
<% content_for :page_title, @competition.display_name %>

<div class="h-screen overflow-hidden flex flex-col bg-gray-100">

  <!-- Header -->
  <div class="shrink-0 bg-ismf-navy px-4 pt-4 pb-5">
    <!-- Back link -->
    <%= link_to admin_competitions_path, class: "inline-flex items-center gap-1.5 text-white/70 text-sm mb-3 active:text-white" do %>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
      </svg>
      Competitions
    <% end %>

    <!-- Competition name + status -->
    <div class="flex items-start justify-between gap-3">
      <h1 class="text-xl font-bold text-white leading-tight"><%= @competition.display_name %></h1>
      <span class="shrink-0 mt-0.5 px-2.5 py-1 text-xs font-bold rounded-full
        <%= case @competition.status
          when 'active'     then 'bg-green-400 text-green-900'
          when 'completed'  then 'bg-gray-400 text-gray-900'
          when 'cancelled'  then 'bg-red-400 text-red-900'
          else 'bg-blue-400 text-blue-900'
          end %>">
        <%= @competition.status.titleize %>
      </span>
    </div>

    <!-- Location + date -->
    <p class="text-sm text-white/70 mt-1">
      <%= @competition.country_flag_emoji %> <%= @competition.place %>, <%= @competition.country_name %>
      <% if @competition.short_date_range.present? %>
        &nbsp;·&nbsp;<%= @competition.short_date_range %>
      <% end %>
    </p>
  </div>

  <!-- Scrollable race list -->
  <div class="flex-1 overflow-y-auto px-4 py-4 space-y-5">

    <% if @races_by_type.any? %>
      <% @races_by_type.each do |race_type_name, races| %>
        <!-- Race type section -->
        <div>
          <!-- Section header -->
          <p class="text-xs font-bold text-gray-500 uppercase tracking-wider mb-2 px-1">
            <%= race_type_name.presence || "Other" %>
          </p>

          <div class="space-y-2">
            <% races.each do |race| %>
              <%
                live        = race.in_progress?
                card_border = live ? "border-green-400 bg-green-50" : "border-gray-200 bg-white"
              %>
              <%= link_to admin_competition_race_path(@competition_record, race),
                    class: "flex items-center gap-3 w-full px-4 py-3.5 rounded-xl border-2 #{card_border} active:scale-95 transition-transform shadow-sm" do %>

                <!-- Live pulse dot or status colour bar -->
                <% if live %>
                  <span class="shrink-0 w-2.5 h-2.5 rounded-full bg-green-500 animate-pulse"></span>
                <% else %>
                  <span class="shrink-0 w-2.5 h-2.5 rounded-full
                    <%= case race.status
                      when 'completed' then 'bg-gray-400'
                      when 'cancelled' then 'bg-red-400'
                      else 'bg-blue-400'
                      end %>">
                  </span>
                <% end %>

                <!-- Race info -->
                <div class="flex-1 min-w-0">
                  <!-- Name + live badge on same line -->
                  <div class="flex items-center gap-2 flex-wrap">
                    <span class="font-semibold text-ismf-navy text-sm leading-snug truncate">
                      <%= race.name %>
                    </span>
                    <% if live %>
                      <span class="inline-flex items-center gap-1 px-2 py-0.5 text-[11px] font-bold rounded-full bg-green-500 text-white shrink-0">
                        <span class="w-1.5 h-1.5 rounded-full bg-white animate-pulse"></span>
                        LIVE
                      </span>
                    <% end %>
                  </div>

                  <!-- Pills row -->
                  <div class="flex items-center gap-1.5 mt-1.5 flex-wrap">
                    <!-- Stage pill -->
                    <% if race.stage_name.present? %>
                      <span class="px-2 py-0.5 text-[11px] font-medium rounded-full bg-gray-100 text-gray-600">
                        <%= race.stage_name %>
                      </span>
                    <% end %>

                    <!-- Gender pill -->
                    <% if race.gender_category_display.present? %>
                      <span class="px-2 py-0.5 text-[11px] font-medium rounded-full bg-gray-100 text-gray-600">
                        <%= race.gender_category_display %>
                      </span>
                    <% end %>

                    <!-- Scheduled time -->
                    <% if race.scheduled_at.present? %>
                      <span class="inline-flex items-center gap-1 px-2 py-0.5 text-[11px] font-medium rounded-full bg-gray-100 text-gray-500">
                        <svg class="w-3 h-3 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                        <%= race.formatted_scheduled_time %>
                      </span>
                    <% end %>
                  </div>
                </div>

                <!-- Status badge + chevron -->
                <div class="shrink-0 flex flex-col items-end gap-2">
                  <span class="px-2 py-0.5 text-[11px] font-bold rounded-full
                    <%= case race.status
                      when 'in_progress' then 'bg-green-100 text-green-800'
                      when 'completed'   then 'bg-gray-100 text-gray-600'
                      when 'cancelled'   then 'bg-red-100 text-red-700'
                      else 'bg-blue-100 text-blue-700'
                      end %>">
                    <%= race.status.titleize %>
                  </span>
                  <svg class="w-4 h-4 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </div>

              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>

    <% else %>
      <!-- Empty state -->
      <div class="flex flex-col items-center justify-center py-20 px-6 text-center">
        <div class="w-16 h-16 rounded-full bg-gray-200 flex items-center justify-center mb-4">
          <svg class="w-8 h-8 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
        </div>
        <h3 class="text-base font-bold text-gray-700">No races yet</h3>
        <p class="text-sm text-gray-500 mt-1">Races will appear here once added.</p>
      </div>
    <% end %>

  </div>
</div>