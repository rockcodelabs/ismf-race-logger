<div class="space-y-6">
  <!-- Page header with back button -->
  <div class="flex items-center justify-between">
    <div class="flex items-center gap-4">
      <%= link_to admin_competitions_path, class: "inline-flex items-center justify-center w-10 h-10 rounded-lg text-gray-500 hover:text-ismf-blue hover:bg-blue-50 transition-all" do %>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
      <% end %>
      <div>
        <h1 class="text-2xl font-bold text-ismf-navy"><%= @competition.display_name %></h1>
        <p class="mt-1 text-sm text-ismf-gray">
          <%= @competition.country_flag_emoji %> <%= @competition.place %>, <%= @competition.country_name %>
        </p>
      </div>
    </div>
    <div class="flex items-center gap-2">
      <%= link_to edit_admin_competition_path(@competition), class: "btn-secondary" do %>
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
        </svg>
        Edit
      <% end %>
      <%= button_to admin_competition_path(@competition), method: :delete, class: "btn-danger", data: { turbo_confirm: "Are you sure you want to delete this competition?" } do %>
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
        </svg>
        Delete
      <% end %>
    </div>
  </div>

  <!-- Compact Competition Info Card -->
  <% all_races = @races_by_type.values.flatten %>
  <% ongoing_race = all_races.find { |r| r.in_progress? } %>
  <% is_ongoing = @competition.ongoing? %>
  
  <% if is_ongoing && ongoing_race %>
    <%= link_to admin_race_reports_path(ongoing_race), class: "block card border-2 border-green-400 bg-gradient-to-r from-green-50 to-emerald-50 hover:shadow-lg transition-all" do %>
      <div class="p-4">
        <div class="flex items-center gap-4">
          <div class="w-12 h-12 bg-green-400 rounded-full flex items-center justify-center animate-pulse">
            <svg class="w-7 h-7 text-green-900" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <div class="flex-1">
            <div class="flex items-center gap-3 mb-1">
              <span class="px-3 py-1 text-xs font-bold rounded-full bg-green-400 text-green-900 uppercase tracking-wide">
                Ongoing
              </span>
              <span class="text-sm text-green-800 font-medium">Click to view reports →</span>
            </div>
            <div class="flex items-center gap-4 text-sm text-ismf-gray flex-wrap">
              <span class="flex items-center gap-1">
                <svg class="w-4 h-4 text-ismf-blue shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
                <%= @competition.short_date_range %> • <%= @competition.duration_days %> day<%= 's' if @competition.duration_days != 1 %>
              </span>
              <span class="flex items-center gap-1">
                <svg class="w-4 h-4 text-ismf-blue shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
                <%= @competition.city %>, <%= @competition.place %>
              </span>
              <% if @competition.webpage_url.present? %>
                <span class="flex items-center gap-1">
                  <svg class="w-4 h-4 text-ismf-blue shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
                  </svg>
                  <span class="text-ismf-blue hover:text-ismf-red transition-colors">Website</span>
                </span>
              <% end %>
            </div>
            <% if @competition.description.present? %>
              <p class="text-sm text-ismf-gray mt-1 line-clamp-1"><%= @competition.description %></p>
            <% end %>
            <div class="mt-2 pt-2 border-t border-green-200">
              <div class="flex items-center gap-3">
                <span class="px-2 py-1 text-xs font-bold rounded-lg bg-green-400 text-green-900 uppercase">
                  Live Now
                </span>
                <span class="text-sm font-bold text-ismf-navy">
                  <%= ongoing_race.name %>
                </span>
                <span class="text-xs text-ismf-gray flex items-center gap-1">
                  <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  <%= ongoing_race.formatted_scheduled_time %>
                </span>
                <span class="text-xs text-ismf-gray">
                  <%= ongoing_race.stage_display %> • <%= ongoing_race.gender_category_display %>
                </span>
              </div>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  <% else %>
    <div class="card">
      <div class="p-4">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-4 flex-1">
            <div class="flex-1">
              <div class="flex items-center gap-3 mb-1">
                <span class="px-3 py-1 text-xs font-medium rounded-full <%= @competition.status_badge_class %>">
                  <%= @competition.status.titleize %>
                </span>
                <% if @competition.upcoming? %>
                  <span class="text-sm text-ismf-gray"><%= @competition.days_until_start %> days until start</span>
                <% elsif @competition.past? %>
                  <span class="text-sm text-ismf-gray">Ended <%= @competition.days_since_end %> days ago</span>
                <% end %>
              </div>
              <div class="flex items-center gap-4 text-sm text-ismf-gray">
                <span class="flex items-center gap-1">
                  <svg class="w-4 h-4 text-ismf-blue shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                  <%= @competition.short_date_range %> • <%= @competition.duration_days %> day<%= 's' if @competition.duration_days != 1 %>
                </span>
                <span class="flex items-center gap-1">
                  <svg class="w-4 h-4 text-ismf-blue shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                  <%= @competition.city %>, <%= @competition.place %>
                </span>
                <% if @competition.webpage_url.present? %>
                  <%= link_to @competition.webpage_url, target: "_blank", rel: "noopener", class: "flex items-center gap-1 text-ismf-blue hover:text-ismf-red transition-colors" do %>
                    <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
                    </svg>
                    <span>Website</span>
                  <% end %>
                <% end %>
              </div>
              <% if @competition.description.present? %>
                <p class="text-sm text-ismf-gray mt-1 line-clamp-1"><%= @competition.description %></p>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <!-- Races section -->
  <%= render "races/races" %>
</div>
