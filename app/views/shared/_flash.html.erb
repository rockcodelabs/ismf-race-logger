<%
  # Unified flash message partial for both notices and alerts
  # Works with regular page loads and Turbo Stream broadcasts
  #
  # Parameters:
  #   type: "notice" or "alert"
  #   message: The message text to display
  
  # Determine styling based on type
  if type == "notice"
    bg_class = "bg-green-100"
    border_class = "border-green-500"
    text_class = "text-green-900"
    button_class = "text-green-700 hover:text-green-900"
    icon_path = "M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
    dismiss_time = 3000
  else # alert
    bg_class = "bg-red-100"
    border_class = "border-red-500"
    text_class = "text-red-900"
    button_class = "text-red-700 hover:text-red-900"
    icon_path = "M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
    dismiss_time = 5000
  end
%>

<div id="flash-<%= SecureRandom.uuid %>" class="fixed left-1/2 -translate-x-1/2 z-9999 <%= bg_class %> border-2 <%= border_class %> <%= text_class %> px-4 py-3 rounded-xl flex items-center gap-3 shadow-lg max-w-sm transition-all duration-300" data-controller="flash" data-flash-dismiss-after-value="<%= dismiss_time %>" data-action="flash:removed->flash-stack#reposition" style="display: flex !important; visibility: visible !important; pointer-events: auto;">
  <svg class="w-6 h-6 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="<%= icon_path %>" />
  </svg>
  <span class="text-base font-semibold flex-1"><%= message %></span>
  <button type="button" class="<%= button_class %>" data-action="click->flash#dismiss">
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
    </svg>
  </button>
</div>
