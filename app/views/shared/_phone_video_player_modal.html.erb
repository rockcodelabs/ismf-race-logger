<div id="phone-video-player-modal"
     data-controller="phone-video-player"
     data-phone-video-player-loop-mode-value="true"
     style="display: none; position: fixed; inset: 0; z-index: 50; background: black;">

  <!-- Video uses position:fixed + viewport units — no containing block chain needed -->
  <video data-phone-video-player-target="video"
         data-action="ended->phone-video-player#handleEnded
                      timeupdate->phone-video-player#handleTimeUpdate
                      play->phone-video-player#updatePlayPauseButton
                      pause->phone-video-player#updatePlayPauseButton"
         preload="metadata"
         muted
         playsinline
         style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; object-fit: contain; z-index: 1; background: black;">
  </video>

  <!-- Top-right controls: mute + close -->
  <div style="position: absolute; top: 1rem; right: 1rem; z-index: 10;" class="flex items-center gap-2">
    <button type="button"
            data-action="click->phone-video-player#toggleMute"
            data-phone-video-player-target="muteBtn"
            class="p-3 bg-black/60 hover:bg-black/80 active:bg-black rounded-full text-white touch-manipulation">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
          d="M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z"/>
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2"/>
      </svg>
    </button>
    <button type="button"
            data-action="click->phone-video-player#close"
            class="p-3 bg-black/60 hover:bg-black/80 active:bg-black rounded-full text-white touch-manipulation">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Controls overlay (bottom, above video) -->
  <div style="position: absolute; bottom: 0; left: 0; right: 0; z-index: 10;"
       class="bg-gradient-to-t from-black via-black/80 to-transparent px-4 py-6 space-y-4">

    <!-- Progress bar -->
    <div class="relative h-1.5 bg-gray-700 rounded-full overflow-hidden cursor-pointer"
         data-action="click->phone-video-player#seek">
      <div data-phone-video-player-target="progressBar"
           class="absolute top-0 left-0 h-full bg-blue-500 rounded-full pointer-events-none"
           style="width: 0%"></div>
    </div>

    <!-- Main controls row -->
    <div class="flex items-center gap-3">
      <!-- Play/Pause -->
      <button data-action="click->phone-video-player#togglePlay"
              data-phone-video-player-target="playPauseBtn"
              class="flex items-center justify-center w-16 h-16 bg-blue-600 hover:bg-blue-700 active:scale-95 rounded-full text-white font-bold touch-manipulation transition-all shrink-0"
              type="button">
        <svg class="w-8 h-8" fill="currentColor" viewBox="0 0 24 24">
          <path d="M8 5v14l11-7z"/>
        </svg>
      </button>

      <!-- Speed selector -->
      <div class="flex-1">
        <label class="block text-xs text-gray-400 mb-1 font-semibold">Speed</label>
        <select data-phone-video-player-target="speedSelect"
                data-action="change->phone-video-player#changeSpeed"
                class="w-full px-4 py-3 bg-gray-800 border-2 border-gray-700 rounded-lg text-white text-center font-bold text-sm touch-manipulation active:border-blue-500">
          <option value="0.25">0.25x</option>
          <option value="0.5">0.5x (Slow)</option>
          <option value="0.75">0.75x</option>
          <option value="1" selected>1x (Normal)</option>
          <option value="1.25">1.25x</option>
          <option value="1.5">1.5x</option>
          <option value="2">2x</option>
        </select>
      </div>

      <!-- Loop / Full video toggle -->
      <button data-action="click->phone-video-player#toggleLoopMode"
              data-phone-video-player-target="loopModeBtn"
              class="px-4 py-3 bg-green-600 hover:bg-green-700 active:scale-95 rounded-lg text-white font-bold touch-manipulation transition-all text-sm shrink-0 whitespace-nowrap"
              type="button">
        Loop: ON
      </button>
    </div>

    <div class="text-center text-xs text-gray-500">
      Tap button to play • Adjust speed for slow motion • Toggle loop mode
    </div>
  </div>
</div>

<!-- Initialize phone video player when opening from thumbnail -->
<script type="module">
window.openPhoneVideoPlayer = function(videoUrl, videoBlobId) {
  const modal = document.getElementById('phone-video-player-modal');
  if (!modal) { console.error("openPhoneVideoPlayer: modal not found"); return; }

  modal.style.display = 'block';

  const controller = window.phoneVideoPlayerController;
  if (!controller) { console.error("openPhoneVideoPlayer: controller not found"); return; }

  controller.open(videoUrl, videoBlobId);
};
</script>