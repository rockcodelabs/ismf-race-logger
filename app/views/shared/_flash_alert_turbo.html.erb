<div id="flash-<%= SecureRandom.uuid %>" class="fixed top-24 left-4 right-4 z-[9999] bg-red-100 border-2 border-red-500 text-red-900 px-6 py-4 rounded-xl flex items-center gap-4 shadow-lg animate-slide-down" data-controller="flash" data-flash-dismiss-after-value="5000" style="display: flex !important; position: fixed !important; visibility: visible !important; pointer-events: auto;">
  <svg class="w-8 h-8 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
  </svg>
  <span class="text-xl font-semibold flex-1"><%= message %></span>
  <button type="button" class="text-red-700 hover:text-red-900" data-action="click->flash#dismiss">
    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
    </svg>
  </button>
</div>