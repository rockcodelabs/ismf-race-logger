<div id="video-player-modal"
     data-controller="video-player" 
     data-video-player-fps-value="30"
     class="hidden fixed inset-0 z-50 overflow-y-auto bg-black bg-opacity-90 items-center justify-center"
     data-video-player-target="modal"
     data-action="click->video-player#closeOnBackdrop">
  
  <div class="relative w-full max-w-7xl mx-auto p-4" data-action="click->video-player#closeOnBackdrop">
    <!-- Close button -->
    <button data-action="click->video-player#close" 
            class="absolute top-6 right-6 z-10 p-2 bg-black bg-opacity-50 hover:bg-opacity-70 rounded-full text-white transition-all"
            title="Close (ESC)">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <!-- Video container -->
    <div class="bg-black rounded-lg overflow-hidden shadow-2xl">
      <!-- Video element -->
      <div class="relative bg-black" style="aspect-ratio: 16/9;">
        <video data-video-player-target="video"
               data-action="loadedmetadata->video-player#handleLoadedMetadata
                           timeupdate->video-player#handleTimeUpdate
                           ended->video-player#handleEnded
                           play->video-player#updatePlayPauseButton
                           pause->video-player#updatePlayPauseButton
                           click->video-player#togglePlay"
               class="w-full h-full cursor-pointer"
               preload="metadata"
               muted>
          Your browser does not support the video tag.
        </video>
      </div>

      <!-- Controls -->
      <div class="bg-gray-900 text-white p-4 space-y-4">
        <!-- Progress bar with markers -->
        <div class="relative">
          <!-- Marker highlight (selected segment) -->
          <div data-video-player-target="markerHighlight"
               class="absolute top-0 h-2 bg-blue-500 bg-opacity-30 rounded hidden pointer-events-none"
               style="left: 0%; width: 0%;"></div>
          
          <!-- Progress bar -->
          <div data-video-player-target="progress"
               data-action="mousedown->video-player#startDrag"
               class="relative h-2 bg-gray-700 rounded-full cursor-pointer overflow-visible">
            <!-- Buffered/played bar -->
            <div data-video-player-target="progressBar"
                 class="absolute top-0 left-0 h-full bg-blue-500 rounded-full pointer-events-none"
                 style="width: 0%"></div>
            
            <!-- Start marker -->
            <div data-video-player-target="startMarker"
                 class="absolute top-1/2 -translate-y-1/2 w-3 h-6 bg-green-500 border-2 border-white rounded hidden cursor-pointer shadow-lg"
                 style="left: 0%; transform: translateX(-50%) translateY(-50%);"
                 title="Start marker (I)">
              <div class="absolute -top-6 left-1/2 -translate-x-1/2 bg-green-500 text-white text-xs px-1 py-0.5 rounded whitespace-nowrap">
                START
              </div>
            </div>
            
            <!-- End marker -->
            <div data-video-player-target="endMarker"
                 class="absolute top-1/2 -translate-y-1/2 w-3 h-6 bg-red-500 border-2 border-white rounded hidden cursor-pointer shadow-lg"
                 style="left: 0%; transform: translateX(-50%) translateY(-50%);"
                 title="End marker (O)">
              <div class="absolute -top-6 left-1/2 -translate-x-1/2 bg-red-500 text-white text-xs px-1 py-0.5 rounded whitespace-nowrap">
                END
              </div>
            </div>
          </div>
        </div>

        <!-- Time display and frame counter -->
        <div class="flex items-center justify-between text-sm">
          <div class="flex items-center gap-3">
            <span data-video-player-target="currentTime" class="font-mono">0:00.00</span>
            <span class="text-gray-500">/</span>
            <span data-video-player-target="duration" class="font-mono text-gray-400">0:00.00</span>
          </div>
          <div data-video-player-target="frameCount" class="text-gray-400 font-mono text-xs">
            Frame 0 / 0
          </div>
        </div>

        <!-- Main controls -->
        <div class="flex items-center justify-between gap-4">
          <!-- Left: Playback controls -->
          <div class="flex items-center gap-2">
            <!-- Previous frame -->
            <button data-action="click->video-player#previousFrame"
                    class="p-2 hover:bg-gray-800 rounded-lg transition-colors"
                    title="Previous frame (←)">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
              </svg>
            </button>

            <!-- Skip backward -->
            <button data-action="click->video-player#skipBackward"
                    class="p-2 hover:bg-gray-800 rounded-lg transition-colors"
                    title="Skip -5s (Shift+←)">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12.066 11.2a1 1 0 000 1.6l5.334 4A1 1 0 0019 16V8a1 1 0 00-1.6-.8l-5.333 4zM4.066 11.2a1 1 0 000 1.6l5.334 4A1 1 0 0011 16V8a1 1 0 00-1.6-.8l-5.334 4z" />
              </svg>
            </button>

            <!-- Play/Pause -->
            <button data-action="click->video-player#togglePlay"
                    data-video-player-target="playPauseBtn"
                    class="p-3 bg-blue-600 hover:bg-blue-700 rounded-full transition-colors"
                    title="Play/Pause (Space or K)">
              <svg data-video-player-target="playPauseIcon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </button>

            <!-- Skip forward -->
            <button data-action="click->video-player#skipForward"
                    class="p-2 hover:bg-gray-800 rounded-lg transition-colors"
                    title="Skip +5s (Shift+→)">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.933 12.8a1 1 0 000-1.6L6.6 7.2A1 1 0 005 8v8a1 1 0 001.6.8l5.333-4zM19.933 12.8a1 1 0 000-1.6l-5.333-4A1 1 0 0013 8v8a1 1 0 001.6.8l5.333-4z" />
              </svg>
            </button>

            <!-- Next frame -->
            <button data-action="click->video-player#nextFrame"
                    class="p-2 hover:bg-gray-800 rounded-lg transition-colors"
                    title="Next frame (→)">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </button>
          </div>

          <!-- Right: Time markers -->
          <div class="flex items-center gap-2">
            <button data-action="click->video-player#setStartMarker"
                    class="px-4 py-2 bg-green-600 hover:bg-green-700 rounded text-sm font-medium transition-colors"
                    title="Set start marker (I)">
              Start
            </button>
            <button data-action="click->video-player#setEndMarker"
                    class="px-4 py-2 bg-red-600 hover:bg-red-700 rounded text-sm font-medium transition-colors"
                    title="Set end marker (O)">
              End
            </button>
            <button data-action="click->video-player#toggleLoop"
                    data-video-player-target="loopBtn"
                    class="px-4 py-2 bg-gray-700 hover:bg-gray-600 rounded text-sm font-medium transition-colors"
                    title="Loop segment (L)">
              🔁 Loop
            </button>
            <button data-action="click->video-player#saveMarkers"
                    class="px-4 py-2 bg-blue-600 hover:bg-blue-700 rounded text-sm font-medium transition-colors"
                    title="Save markers">
              💾 Save
            </button>
            <button data-action="click->video-player#clearMarkers"
                    class="px-4 py-2 bg-gray-700 hover:bg-gray-600 rounded text-sm transition-colors"
                    title="Clear markers">
              Clear
            </button>
            <button data-action="click->video-player#close"
                    class="px-4 py-2 bg-gray-800 hover:bg-gray-700 rounded text-sm transition-colors"
                    title="Close player (Esc)">
              ✕ Close
            </button>
          </div>

          <!-- Right: Volume and speed -->
          <div class="flex items-center gap-3">
            <!-- Volume -->
            <div class="flex items-center gap-2">
              <button data-action="click->video-player#toggleMute"
                      data-video-player-target="muteBtn"
                      class="p-2 hover:bg-gray-800 rounded-lg transition-colors"
                      title="Mute (M)">
                <svg data-video-player-target="muteIcon" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z" />
                </svg>
              </button>
              <input type="range"
                     data-video-player-target="volumeSlider"
                     data-action="input->video-player#updateVolume"
                     min="0"
                     max="100"
                     value="100"
                     autocomplete="off"
                     class="w-20 h-1 bg-gray-700 rounded-lg appearance-none cursor-pointer slider">
            </div>

            <!-- Speed -->
            <select data-video-player-target="speedSelect"
                    data-action="change->video-player#changeSpeed"
                    class="px-2 py-1 bg-gray-800 border border-gray-700 rounded text-xs">
              <option value="0.25">0.25x</option>
              <option value="0.5">0.5x</option>
              <option value="1" selected>1x</option>
              <option value="1.5">1.5x</option>
              <option value="2">2x</option>
            </select>
          </div>
        </div>

        <!-- Marker info and jump controls -->
        <div class="flex items-center justify-between text-xs text-gray-400 pt-3 border-t border-gray-800">
          <div class="flex items-center gap-4">
            <div class="flex items-center gap-2">
              <span>Start:</span>
              <input data-video-player-target="startTimeInput"
                     type="text"
                     readonly
                     autocomplete="off"
                     class="w-20 px-2 py-1 bg-gray-800 rounded font-mono text-center"
                     value="0:00.00">
              <button data-action="click->video-player#jumpToStart"
                      class="px-2 py-1 bg-gray-800 hover:bg-gray-700 rounded transition-colors"
                      title="Jump to start marker">
                Go
              </button>
            </div>
            <div class="flex items-center gap-2">
              <span>End:</span>
              <input data-video-player-target="endTimeInput"
                     type="text"
                     readonly
                     autocomplete="off"
                     class="w-20 px-2 py-1 bg-gray-800 rounded font-mono text-center"
                     value="0:00.00">
              <button data-action="click->video-player#jumpToEnd"
                      class="px-2 py-1 bg-gray-800 hover:bg-gray-700 rounded transition-colors"
                      title="Jump to end marker">
                Go
              </button>
            </div>
          </div>
          <div class="text-gray-500">
            Shortcuts: Space/K=Play | ←/→=Frame | Shift+←/→=Skip | I=Start | O=End | L=Loop | M=Mute | 0-9=Jump | Esc=Close
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Global mouse event listeners for drag -->
<div data-action="mousemove@window->video-player#drag mouseup@window->video-player#stopDrag"></div>
