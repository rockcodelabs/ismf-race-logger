<%# frozen_string_literal: true %>
<%# Phone-optimized races view for competition show page %>
<%# Displays ongoing/closest race featured, then all others grouped by collapsible type %>

<div class="space-y-4">
  <div class="flex items-center justify-between mb-4">
    <div class="flex items-center gap-2">
      <h2 class="text-lg font-bold text-ismf-navy">Races</h2>
      <span class="text-xs text-ismf-gray">
        <%= @competition_record.races.count %> race<%= 's' if @competition_record.races.count != 1 %>
      </span>
    </div>
    <% if policy(Race).create? %>
      <%= link_to admin_competition_races_path(@competition_record), class: "btn-danger text-sm px-3 py-2" do %>
        <svg class="w-4 h-4 mr-1 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
        Manage
      <% end %>
    <% end %>
  </div>

  <% if @races_by_type.any? %>
    <%# Gather all races and categorize by priority %>
    <% all_races = @races_by_type.values.flatten %>
    <% ongoing_races = all_races.select { |r| r.in_progress? } %>
    <% upcoming_races = all_races.select { |r| r.upcoming? && !r.in_progress? } %>
    <% next_race = upcoming_races.min_by { |r| r.scheduled_at || Time.new(9999) } %>

    <%# === SECTION 1: ONGOING RACE === %>
    <% if ongoing_races.any? %>
      <% ongoing_races.each do |race| %>
        <%= link_to admin_competition_race_path(race.competition_id, race), class: "block p-4 rounded-lg border-2 border-green-400 bg-gradient-to-r from-green-50 to-emerald-50 active:scale-95 transition-transform" do %>
          <div class="flex items-start gap-3">
            <div class="w-10 h-10 bg-green-400 rounded-full flex items-center justify-center flex-shrink-0 animate-pulse">
              <svg class="w-6 h-6 text-green-900" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2 mb-1">
                <span class="px-2 py-1 text-xs font-bold rounded-full bg-green-400 text-green-900 uppercase tracking-wide">Live Now</span>
              </div>
              <h3 class="text-base font-bold text-ismf-navy truncate"><%= race.name %></h3>
              <div class="text-xs text-ismf-gray mt-1 space-y-0.5">
                <div class="flex items-center gap-1">
                  <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  <%= race.formatted_scheduled_time %>
                </div>
                <div><%= race.stage_display %> • <%= race.gender_category_display %></div>
              </div>
            </div>
          </div>
        <% end %>
      <% end %>

      <%# Show remaining races grouped by type with collapsible headers %>
      <% remaining_races = all_races.reject { |r| ongoing_races.include?(r) } %>
      <% remaining_by_type = remaining_races.group_by(&:race_type).sort %>
      
      <div class="space-y-2 mt-4">
        <% remaining_by_type.each do |race_type_name, races| %>
          <details class="rounded-lg border border-gray-200 overflow-hidden">
            <summary class="px-4 py-3 bg-gray-50 hover:bg-gray-100 cursor-pointer flex items-center justify-between font-semibold text-ismf-navy">
              <span class="flex items-center gap-2">
                <svg class="w-5 h-5 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <%= race_type_name&.titleize || 'Unknown' %>
              </span>
              <span class="text-xs text-gray-500"><%= races.count %></span>
            </summary>
            
            <div class="p-3 space-y-2 bg-gray-50/50">
              <% races.sort_by(&:position).each do |race| %>
                <%= link_to admin_competition_race_path(race.competition_id, race), class: "block p-3 rounded-lg border border-gray-200 bg-white hover:bg-blue-50 active:scale-95 transition-all" do %>
                  <div class="flex items-start justify-between gap-2">
                    <div class="flex-1 min-w-0">
                      <h4 class="text-sm font-bold text-ismf-navy truncate"><%= race.name %></h4>
                      <% if race.scheduled_at.present? %>
                        <div class="text-xs text-ismf-gray mt-1 flex items-center gap-1">
                          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                          </svg>
                          <%= race.scheduled_at.strftime("%b %d, %H:%M") %>
                        </div>
                      <% end %>
                    </div>
                    <% case race.status %>
                    <% when 'in_progress' %>
                      <span class="px-2 py-1 text-xs font-bold rounded-lg bg-green-100 text-green-800 border border-green-200 flex-shrink-0 whitespace-nowrap">Live</span>
                    <% when 'scheduled' %>
                      <span class="px-2 py-1 text-xs font-bold rounded-lg bg-blue-100 text-blue-800 border border-blue-200 flex-shrink-0 whitespace-nowrap">Upcoming</span>
                    <% when 'completed' %>
                      <span class="px-2 py-1 text-xs font-bold rounded-lg bg-gray-200 text-gray-600 border border-gray-300 flex-shrink-0 whitespace-nowrap">Done</span>
                    <% when 'cancelled' %>
                      <span class="px-2 py-1 text-xs font-bold rounded-lg bg-red-100 text-red-800 border border-red-200 flex-shrink-0 whitespace-nowrap">Cancelled</span>
                    <% else %>
                      <span class="px-2 py-1 text-xs font-bold rounded-lg bg-gray-100 text-gray-600 border border-gray-200 flex-shrink-0 whitespace-nowrap"><%= race.status.humanize %></span>
                    <% end %>
                  </div>
                <% end %>
              <% end %>
            </div>
          </details>
        <% end %>
      </div>

    <%# === SECTION 2: NEXT/CLOSEST RACE === %>
    <% elsif next_race.present? %>
      <%= link_to admin_competition_race_path(next_race.competition_id, next_race), class: "block p-4 rounded-lg border-2 border-orange-400 bg-gradient-to-r from-orange-50 to-yellow-50 active:scale-95 transition-transform" do %>
        <div class="flex items-start gap-3">
          <div class="w-10 h-10 bg-orange-400 rounded-full flex items-center justify-center flex-shrink-0">
            <svg class="w-6 h-6 text-orange-900" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-2 mb-1">
              <span class="px-2 py-1 text-xs font-bold rounded-full bg-orange-400 text-orange-900 uppercase tracking-wide">Next Up</span>
            </div>
            <h3 class="text-base font-bold text-ismf-navy truncate"><%= next_race.name %></h3>
            <div class="text-xs text-ismf-gray mt-1 space-y-0.5">
              <div class="flex items-center gap-1">
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <%= next_race.formatted_scheduled_time %>
              </div>
              <div><%= next_race.stage_display %> • <%= next_race.gender_category_display %></div>
            </div>
          </div>
        </div>
      <% end %>

      <%# Show remaining races grouped by type with collapsible headers %>
      <% remaining_races = all_races.reject { |r| r == next_race } %>
      <% remaining_by_type = remaining_races.group_by(&:race_type).sort %>
      
      <div class="space-y-2 mt-4">
        <% remaining_by_type.each do |race_type_name, races| %>
          <details class="rounded-lg border border-gray-200 overflow-hidden">
            <summary class="px-4 py-3 bg-gray-50 hover:bg-gray-100 cursor-pointer flex items-center justify-between font-semibold text-ismf-navy">
              <span class="flex items-center gap-2">
                <svg class="w-5 h-5 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <%= race_type_name&.titleize || 'Unknown' %>
              </span>
              <span class="text-xs text-gray-500"><%= races.count %></span>
            </summary>
            
            <div class="p-3 space-y-2 bg-gray-50/50">
              <% races.sort_by(&:position).each do |race| %>
                <%= link_to admin_competition_race_path(race.competition_id, race), class: "block p-3 rounded-lg border border-gray-200 bg-white hover:bg-blue-50 active:scale-95 transition-all" do %>
                  <div class="flex items-start justify-between gap-2">
                    <div class="flex-1 min-w-0">
                      <h4 class="text-sm font-bold text-ismf-navy truncate"><%= race.name %></h4>
                      <% if race.scheduled_at.present? %>
                        <div class="text-xs text-ismf-gray mt-1 flex items-center gap-1">
                          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                          </svg>
                          <%= race.scheduled_at.strftime("%b %d, %H:%M") %>
                        </div>
                      <% end %>
                    </div>
                    <% case race.status %>
                    <% when 'in_progress' %>
                      <span class="px-2 py-1 text-xs font-bold rounded-lg bg-green-100 text-green-800 border border-green-200 flex-shrink-0 whitespace-nowrap">Live</span>
                    <% when 'scheduled' %>
                      <span class="px-2 py-1 text-xs font-bold rounded-lg bg-blue-100 text-blue-800 border border-blue-200 flex-shrink-0 whitespace-nowrap">Upcoming</span>
                    <% when 'completed' %>
                      <span class="px-2 py-1 text-xs font-bold rounded-lg bg-gray-200 text-gray-600 border border-gray-300 flex-shrink-0 whitespace-nowrap">Done</span>
                    <% when 'cancelled' %>
                      <span class="px-2 py-1 text-xs font-bold rounded-lg bg-red-100 text-red-800 border border-red-200 flex-shrink-0 whitespace-nowrap">Cancelled</span>
                    <% else %>
                      <span class="px-2 py-1 text-xs font-bold rounded-lg bg-gray-100 text-gray-600 border border-gray-200 flex-shrink-0 whitespace-nowrap"><%= race.status.humanize %></span>
                    <% end %>
                  </div>
                <% end %>
              <% end %>
            </div>
          </details>
        <% end %>
      </div>

    <%# === NO ONGOING OR NEXT RACE - Show all by type === %>
    <% else %>
      <div class="space-y-2">
        <% @races_by_type.each do |race_type_name, races| %>
          <details class="rounded-lg border border-gray-200 overflow-hidden">
            <summary class="px-4 py-3 bg-gray-50 hover:bg-gray-100 cursor-pointer flex items-center justify-between font-semibold text-ismf-navy">
              <span class="flex items-center gap-2">
                <svg class="w-5 h-5 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <%= race_type_name&.titleize || 'Unknown' %>
              </span>
              <span class="text-xs text-gray-500"><%= races.count %></span>
            </summary>
            
            <div class="p-3 space-y-2 bg-gray-50/50">
              <% races.sort_by(&:position).each do |race| %>
                <%= link_to admin_competition_race_path(race.competition_id, race), class: "block p-3 rounded-lg border border-gray-200 bg-white hover:bg-blue-50 active:scale-95 transition-all" do %>
                  <div class="flex items-start justify-between gap-2">
                    <div class="flex-1 min-w-0">
                      <h4 class="text-sm font-bold text-ismf-navy truncate"><%= race.name %></h4>
                      <% if race.scheduled_at.present? %>
                        <div class="text-xs text-ismf-gray mt-1 flex items-center gap-1">
                          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                          </svg>
                          <%= race.scheduled_at.strftime("%b %d, %H:%M") %>
                        </div>
                      <% end %>
                    </div>
                    <% case race.status %>
                    <% when 'in_progress' %>
                      <span class="px-2 py-1 text-xs font-bold rounded-lg bg-green-100 text-green-800 border border-green-200 flex-shrink-0 whitespace-nowrap">Live</span>
                    <% when 'scheduled' %>
                      <span class="px-2 py-1 text-xs font-bold rounded-lg bg-blue-100 text-blue-800 border border-blue-200 flex-shrink-0 whitespace-nowrap">Upcoming</span>
                    <% when 'completed' %>
                      <span class="px-2 py-1 text-xs font-bold rounded-lg bg-gray-200 text-gray-600 border border-gray-300 flex-shrink-0 whitespace-nowrap">Done</span>
                    <% when 'cancelled' %>
                      <span class="px-2 py-1 text-xs font-bold rounded-lg bg-red-100 text-red-800 border border-red-200 flex-shrink-0 whitespace-nowrap">Cancelled</span>
                    <% else %>
                      <span class="px-2 py-1 text-xs font-bold rounded-lg bg-gray-100 text-gray-600 border border-gray-200 flex-shrink-0 whitespace-nowrap"><%= race.status.humanize %></span>
                    <% end %>
                  </div>
                <% end %>
              <% end %>
            </div>
          </details>
        <% end %>
      </div>
    <% end %>

  <% else %>
    <!-- No races empty state -->
    <div class="text-center py-8">
      <svg class="mx-auto h-10 w-10 text-gray-300 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
      </svg>
      <h3 class="text-sm font-medium text-ismf-navy">No races yet</h3>
      <p class="text-xs text-ismf-gray mt-1">Get started by creating the first race.</p>
      <% if policy(Race).create? %>
        <div class="mt-4">
          <%= link_to new_admin_competition_race_path(@competition_record), class: "btn-primary text-sm px-4 py-2 inline-flex" do %>
            <svg class="w-4 h-4 mr-1 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
            </svg>
            <span>Add Race</span>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>