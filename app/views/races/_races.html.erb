<%# frozen_string_literal: true %>
<%# Races section for competition show page - desktop %>
<%# Displays: compact active banner + race types as collapsible accordion with stage sub-groups %>
<%# Expects: @races_by_type (Hash), @competition_record (Competition AR model) %>

<div class="space-y-4">

  <%# ── Header ─────────────────────────────────────────────────────────────── %>
  <div class="flex items-center justify-between">
    <div class="flex items-center gap-3">
      <h2 class="text-xl font-bold text-ismf-navy">Races</h2>
      <span class="text-sm text-ismf-gray">
        <%= @competition_record.races.count %> race<%= 's' if @competition_record.races.count != 1 %>
      </span>
    </div>
    <% if policy(Race).create? %>
      <%= link_to admin_competition_races_path(@competition_record), class: "btn-danger" do %>
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
        Manage Races
      <% end %>
    <% end %>
  </div>

  <% if @races_by_type.any? %>

    <%# ── Determine active race ───────────────────────────────────────────── %>
    <% all_races      = @races_by_type.values.flatten %>
    <% active_race    = all_races.find(&:in_progress?) ||
                        all_races.select(&:upcoming?).min_by { |r| r.scheduled_at || Time.new(9999) } %>
    <% active_type    = active_race&.race_type_name %>

    <%# ── Active race banner ─────────────────────────────────────────────── %>
    <% if active_race %>
      <% is_live        = active_race.in_progress? %>
      <% border_bg      = is_live ? "border-green-500 bg-green-50"     : "border-orange-400 bg-orange-50/70" %>
      <% badge_class    = is_live ? "bg-green-500 text-white"          : "bg-orange-400 text-orange-900" %>
      <% badge_text     = is_live ? "Live Now"                         : "Next Up" %>
      <% name_color     = is_live ? "text-green-900"                   : "text-ismf-navy" %>
      <% meta_color     = is_live ? "text-green-700"                   : "text-ismf-gray" %>
      <% chevron_color  = is_live ? "text-green-500"                   : "text-orange-400" %>

      <%= link_to admin_competition_race_path(active_race.competition_id, active_race),
            class: "flex items-center gap-4 px-4 py-3 rounded-xl border border-gray-200 border-l-4 #{border_bg} shadow-sm hover:shadow-md transition-shadow" do %>

        <%# Status badge %>
        <span class="px-2.5 py-1 text-xs font-bold rounded-full <%= badge_class %> uppercase tracking-wide shrink-0">
          <%= badge_text %>
          <% if is_live %>
            <span class="inline-block w-1.5 h-1.5 rounded-full bg-white/80 animate-pulse ml-1 -mb-0.5"></span>
          <% end %>
        </span>

        <%# Race name + meta %>
        <div class="flex-1 min-w-0">
          <p class="text-sm font-bold <%= name_color %> truncate"><%= active_race.name %></p>
          <p class="text-xs <%= meta_color %> mt-0.5 flex items-center gap-1 flex-wrap">
            <% if active_race.scheduled_at.present? %>
              <svg class="w-3 h-3 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span><%= active_race.formatted_scheduled_time %></span>
              <span class="opacity-40">·</span>
            <% end %>
            <span><%= active_race.stage_display %></span>
            <span class="opacity-40">·</span>
            <span><%= active_race.gender_category_display %></span>
          </p>
        </div>

        <%# Chevron %>
        <svg class="w-5 h-5 <%= chevron_color %> shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>

      <% end %>
    <% end %>

    <%# ── Race type accordion sections ──────────────────────────────────── %>
    <div class="space-y-2">
      <% @races_by_type.each do |race_type_name, races| %>
        <%= render "races/race_type_group",
              race_type_name:  race_type_name,
              races:           races,
              open:            race_type_name == active_type,
              active_race_id:  active_race&.id %>
      <% end %>
    </div>

  <% else %>

    <%# ── Empty state ─────────────────────────────────────────────────────── %>
    <div class="card">
      <div class="text-center py-12">
        <svg class="mx-auto h-12 w-12 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
        </svg>
        <h3 class="mt-2 text-sm font-medium text-ismf-navy">No races yet</h3>
        <p class="mt-1 text-sm text-ismf-gray">Get started by creating the first race for this competition.</p>
        <% if policy(Race).create? %>
          <div class="mt-6">
            <%= link_to new_admin_competition_race_path(@competition_record), class: "btn-primary" do %>
              <svg class="w-5 h-5 mr-2 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
              </svg>
              <span>Add First Race</span>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>

  <% end %>
</div>