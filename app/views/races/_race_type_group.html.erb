<%# frozen_string_literal: true %>
<%# Race type group — collapsible <details> with stage sub-groups and compact race rows %>
<%# Locals: race_type_name (String), races (Array of Race structs), %>
<%#         open (Boolean, default false), active_race_id (Integer | nil) %>
<%# Uses @reports_count_by_race (Hash { race_id => count }) from controller %>

<% stage_order    = %w[qualification heat quarterfinal semifinal final] %>
<% normalize_stage = ->(s) { s&.downcase&.gsub("_", "") || "other" } %>
<% sorted_all     = races.sort_by { |r| [stage_order.index(normalize_stage.(r.stage_type)) || 99, r.position] } %>
<% stages_grouped = sorted_all.group_by { |r| normalize_stage.(r.stage_type) }
                               .sort_by  { |stage, _| stage_order.index(stage) || 99 } %>

<details <%= "open" if open %> class="card overflow-hidden">

  <%# ── Summary / clickable header ────────────────────────────────────────── %>
  <summary class="px-4 py-3 bg-gray-50 hover:bg-gray-100 cursor-pointer flex items-center gap-3 select-none">

    <%# Type icon %>
    <div class="w-8 h-8 bg-purple-100 rounded-lg flex items-center justify-center shrink-0">
      <% case race_type_name&.downcase %>
      <% when "sprint" %>
        <svg class="w-4 h-4 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
        </svg>
      <% when "vertical" %>
        <svg class="w-4 h-4 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18" />
        </svg>
      <% when "individual" %>
        <svg class="w-4 h-4 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
        </svg>
      <% when "relay", "mixed relay" %>
        <svg class="w-4 h-4 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
      <% else %>
        <svg class="w-4 h-4 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      <% end %>
    </div>

    <%# Name + race count %>
    <div class="flex-1 min-w-0">
      <span class="font-semibold text-ismf-navy"><%= race_type_name&.titleize || "Unknown" %></span>
      <span class="text-xs text-gray-400 ml-2">
        <%= races.count %> race<%= "s" if races.count != 1 %>
      </span>
    </div>

    <%# Active indicator: show if any race in this type is live or next %>
    <% has_active = races.any? { |r| r.in_progress? || r.id == active_race_id } %>
    <% if has_active %>
      <span class="w-2 h-2 rounded-full bg-green-500 animate-pulse shrink-0"></span>
    <% end %>

    <%# Type pill (hidden on small screens) %>
    <span class="px-2 py-0.5 text-xs font-medium rounded-full bg-purple-100 text-purple-700 shrink-0 hidden sm:inline">
      <%= race_type_name %>
    </span>

    <%# Chevron — rotates via application.css details[open] rule %>
    <svg class="w-4 h-4 text-gray-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
    </svg>
  </summary>

  <%# ── Stage sub-groups ───────────────────────────────────────────────────── %>
  <div class="divide-y divide-gray-100">
    <% stages_grouped.each do |stage, stage_races| %>
      <div class="px-4 pt-3 pb-2">

        <%# Stage label — use the first race's stage_name for human-readable display %>
        <p class="text-[10px] font-bold uppercase tracking-widest text-gray-400 mb-1.5 px-3">
          <%= stage_races.first.stage_name.presence || stage.titleize %>
          <% if stage_races.count > 1 %>
            <span class="font-normal opacity-60">(<%= stage_races.count %>)</span>
          <% end %>
        </p>

        <%# Race rows %>
        <div class="space-y-0.5">
          <% stage_races.each do |race| %>
            <% is_active_row = race.id == active_race_id %>
            <% row_bg = is_active_row ? "bg-blue-50 hover:bg-blue-100" : "hover:bg-gray-50" %>

            <%= link_to admin_competition_race_path(race.competition_id, race),
                  class: "flex items-center gap-3 px-3 py-2 rounded-lg #{row_bg} transition-colors group" do %>

              <%# Status dot %>
              <% dot_class = case race.status
                             when "in_progress" then "bg-green-500 animate-pulse"
                             when "completed"   then "bg-gray-300"
                             when "cancelled"   then "bg-red-400"
                             else                    "bg-blue-400"
                             end %>
              <span class="w-2 h-2 rounded-full <%= dot_class %> shrink-0"></span>

              <%# Race name %>
              <span class="flex-1 text-sm font-semibold text-ismf-navy truncate">
                <%= race.name %>
              </span>

              <%# Gender category %>
              <% if race.gender_category_display.present? %>
                <span class="text-xs text-gray-400 shrink-0 hidden sm:inline">
                  <%= race.gender_category_display %>
                </span>
              <% end %>

              <%# Scheduled time %>
              <% if race.scheduled_at.present? %>
                <span class="text-xs text-gray-400 shrink-0 flex items-center gap-1">
                  <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  <%= race.formatted_scheduled_time %>
                </span>
              <% end %>

              <%# Report count badge %>
              <% report_count = (@reports_count_by_race || {}).fetch(race.id, 0) %>
              <% if report_count > 0 %>
                <span class="inline-flex items-center gap-1 px-2 py-0.5 text-xs font-semibold rounded-full bg-amber-100 text-amber-800 shrink-0">
                  <svg class="w-3 h-3 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
                  </svg>
                  <%= report_count %>
                </span>
              <% end %>

              <%# Status badge %>
              <% badge_text, badge_css = case race.status
                                         when "in_progress" then ["Live",      "bg-green-100 text-green-800"]
                                         when "completed"   then ["Done",      "bg-gray-100  text-gray-500"]
                                         when "cancelled"   then ["Cancelled", "bg-red-100   text-red-700"]
                                         else                    ["Upcoming",  "bg-blue-100  text-blue-700"]
                                         end %>
              <span class="inline-flex items-center gap-1 px-2 py-0.5 text-xs font-bold rounded-full <%= badge_css %> shrink-0">
                <%= badge_text %>
                <% if race.in_progress? %>
                  <span class="w-1.5 h-1.5 rounded-full bg-green-600 animate-pulse"></span>
                <% end %>
              </span>

              <% if race.is_test %>
                <span class="px-1.5 py-0.5 text-[10px] font-bold rounded bg-orange-100 text-orange-700 border border-orange-200 uppercase shrink-0">
                  TEST
                </span>
              <% end %>

              <%# Row chevron %>
              <svg class="w-4 h-4 text-gray-300 shrink-0 group-hover:text-gray-400 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            <% end %>
          <% end %>
        </div>

      </div>
    <% end %>
  </div>

</details>