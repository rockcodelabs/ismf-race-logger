<% content_for :page_title, "Edit Profile" %>

<div class="h-screen flex flex-col overflow-hidden">
  <!-- Header -->
  <div class="shrink-0 bg-gradient-to-r from-ismf-navy to-ismf-blue px-6 py-4 shadow-lg">
    <%= link_to :back, class: "inline-flex items-center text-white/80 hover:text-white transition-colors mb-2", data: { turbo: false } do %>
      <svg class="w-6 h-6 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
      </svg>
      <span class="font-semibold text-lg">Back</span>
    <% end %>
    <h1 class="text-2xl font-bold text-white">Edit Profile</h1>
  </div>

  <!-- Content - Scrollable with keyboard padding -->
  <div class="flex-1 overflow-y-auto touch-scrollable">
    <div class="px-6 py-6 pb-96 space-y-6">
      
      <!-- Current User Info Card -->
      <div class="bg-white rounded-2xl shadow-lg p-6">
        <div class="flex items-center gap-4 mb-4">
          <div class="w-16 h-16 bg-ismf-primary/10 rounded-full flex items-center justify-center shrink-0">
            <svg class="w-8 h-8 text-ismf-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
          </div>
          <div>
            <h2 class="text-xl font-bold text-gray-800"><%= @user.name %></h2>
            <p class="text-sm text-gray-600"><%= @user.role&.name&.humanize || "No role" %></p>
          </div>
        </div>
      </div>

      <%= form_with url: profile_path, method: :patch, class: "space-y-6" do |form| %>
        
        <!-- Email Section -->
        <div class="bg-white rounded-2xl shadow-lg p-6">
          <h3 class="text-xl font-bold text-gray-800 mb-4 flex items-center">
            <svg class="w-6 h-6 mr-2 text-ismf-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            Email
          </h3>
          
          <div class="bg-gray-50 rounded-lg p-4 mb-4">
            <p class="text-sm text-gray-600">Current</p>
            <p class="font-semibold text-gray-800"><%= @user.email_address %></p>
          </div>
          
          <div>
            <label for="email" class="block text-base font-semibold text-gray-700 mb-2">New Email (optional)</label>
            <%= form.email_field :email, 
                class: "w-full px-4 py-4 text-lg border-2 border-gray-300 rounded-lg focus:border-ismf-primary focus:ring-2 focus:ring-ismf-primary/20 transition-colors",
                placeholder: "Leave blank to keep current" %>
            <% if @errors&.dig(:email) %>
              <p class="mt-2 text-sm text-red-600 font-medium"><%= @errors[:email].join(", ") %></p>
            <% end %>
          </div>
        </div>

        <!-- Password Section -->
        <div class="bg-white rounded-2xl shadow-lg p-6">
          <h3 class="text-xl font-bold text-gray-800 mb-4 flex items-center">
            <svg class="w-6 h-6 mr-2 text-ismf-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
            </svg>
            Password
          </h3>
          
          <div class="space-y-4">
            <div>
              <label for="password" class="block text-base font-semibold text-gray-700 mb-2">New Password (optional)</label>
              <%= form.password_field :password, 
                  class: "w-full px-4 py-4 text-lg border-2 border-gray-300 rounded-lg focus:border-ismf-primary focus:ring-2 focus:ring-ismf-primary/20 transition-colors",
                  placeholder: "Leave blank to keep current" %>
              <p class="mt-1 text-xs text-gray-500">Minimum 8 characters</p>
              <% if @errors&.dig(:password) %>
                <p class="mt-2 text-sm text-red-600 font-medium"><%= @errors[:password].join(", ") %></p>
              <% end %>
            </div>
            
            <div>
              <label for="password_confirmation" class="block text-base font-semibold text-gray-700 mb-2">Confirm Password</label>
              <%= form.password_field :password_confirmation, 
                  class: "w-full px-4 py-4 text-lg border-2 border-gray-300 rounded-lg focus:border-ismf-primary focus:ring-2 focus:ring-ismf-primary/20 transition-colors",
                  placeholder: "Re-enter new password" %>
              <% if @errors&.dig(:password_confirmation) %>
                <p class="mt-2 text-sm text-red-600 font-medium"><%= @errors[:password_confirmation].join(", ") %></p>
              <% end %>
            </div>
          </div>
        </div>

        <!-- PIN Section -->
        <div class="bg-white rounded-2xl shadow-lg p-6">
          <h3 class="text-xl font-bold text-gray-800 mb-4 flex items-center">
            <svg class="w-6 h-6 mr-2 text-ismf-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M7 20l4-16m2 16l4-16M6 9h14M4 15h14" />
            </svg>
            PIN Code
          </h3>
          
          <div class="bg-gray-50 rounded-lg p-4 mb-4">
            <p class="text-sm text-gray-600">
              <% if @user.pin_digest.present? %>
                ✓ PIN is currently set
              <% else %>
                No PIN set - add one for quick login
              <% end %>
            </p>
          </div>
          
          <div class="space-y-4">
            <div>
              <label for="pin" class="block text-base font-semibold text-gray-700 mb-2">New PIN (optional)</label>
              <%= form.text_field :pin, 
                  class: "w-full px-4 py-4 text-2xl border-2 border-gray-300 rounded-lg focus:border-ismf-primary focus:ring-2 focus:ring-ismf-primary/20 transition-colors font-mono text-center tracking-widest",
                  placeholder: "••••",
                  maxlength: 4,
                  inputmode: "numeric",
                  pattern: "[0-9]*" %>
              <p class="mt-1 text-xs text-gray-500">Must be exactly 4 digits</p>
              <% if @errors&.dig(:pin) %>
                <p class="mt-2 text-sm text-red-600 font-medium"><%= @errors[:pin].join(", ") %></p>
              <% end %>
            </div>
            
            <div>
              <label for="pin_confirmation" class="block text-base font-semibold text-gray-700 mb-2">Confirm PIN</label>
              <%= form.text_field :pin_confirmation, 
                  class: "w-full px-4 py-4 text-2xl border-2 border-gray-300 rounded-lg focus:border-ismf-primary focus:ring-2 focus:ring-ismf-primary/20 transition-colors font-mono text-center tracking-widest",
                  placeholder: "••••",
                  maxlength: 4,
                  inputmode: "numeric",
                  pattern: "[0-9]*" %>
              <% if @errors&.dig(:pin_confirmation) %>
                <p class="mt-2 text-sm text-red-600 font-medium"><%= @errors[:pin_confirmation].join(", ") %></p>
              <% end %>
            </div>
          </div>
        </div>

        <!-- Actions -->
        <div class="space-y-3">
          <%= form.submit "Save Changes", 
              class: "touch-btn touch-btn-primary w-full justify-center min-h-[80px] text-xl" %>
          <%= link_to "Cancel", :back, 
              class: "touch-btn touch-btn-secondary w-full justify-center min-h-[80px] text-xl",
              data: { turbo: false } %>
        </div>
      <% end %>
    </div>
  </div>
</div>