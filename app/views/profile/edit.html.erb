<% content_for :page_title, "Edit Profile" %>

<div class="min-h-screen bg-gradient-to-br from-ismf-navy via-ismf-blue to-ismf-navy py-6 px-4">
  <div class="max-w-4xl mx-auto">
    <!-- Header -->
    <div class="mb-4">
      <%= link_to root_path, class: "inline-flex items-center text-white/80 hover:text-white transition-colors mb-2" do %>
        <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        <span class="text-sm font-medium">Back</span>
      <% end %>
      
      <h1 class="text-2xl font-bold text-white">Edit Profile</h1>
      <p class="text-white/70 text-sm">Update your email, password, or PIN</p>
    </div>

    <!-- Profile Card -->
    <div class="bg-white rounded-xl shadow-2xl p-6">
      <!-- Current User Info -->
      <div class="mb-6 pb-4 border-b border-gray-200">
        <div class="flex items-center gap-3">
          <div class="w-12 h-12 bg-ismf-primary/10 rounded-full flex items-center justify-center">
            <svg class="w-6 h-6 text-ismf-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
          </div>
          <div>
            <h2 class="text-lg font-bold text-gray-800"><%= @user.name %></h2>
            <p class="text-xs text-gray-600"><%= @user.role&.name&.humanize || "No role" %></p>
          </div>
        </div>
      </div>

      <%= form_with url: profile_path, method: :patch, class: "space-y-5" do |form| %>
        <!-- Grid layout for compact view -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
          
          <!-- Email Section -->
          <div>
            <h3 class="text-base font-semibold text-gray-800 mb-3 flex items-center">
              <svg class="w-4 h-4 mr-2 text-ismf-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              Email Address
            </h3>
            
            <div class="bg-gray-50 rounded-lg p-3 mb-3">
              <p class="text-xs text-gray-600">Current:</p>
              <p class="text-sm font-semibold text-gray-800 truncate"><%= @user.email_address %></p>
            </div>
            
            <div>
              <label for="email" class="block text-xs font-medium text-gray-700 mb-1">New Email (optional)</label>
              <%= form.email_field :email, 
                  class: "w-full px-3 py-2 text-sm border-2 border-gray-300 rounded-lg focus:border-ismf-primary focus:ring-2 focus:ring-ismf-primary/20 transition-colors",
                  placeholder: "Leave blank to keep current" %>
              <% if @errors&.dig(:email) %>
                <p class="mt-1 text-xs text-red-600"><%= @errors[:email].join(", ") %></p>
              <% end %>
            </div>
          </div>

          <!-- Password Section -->
          <div>
            <h3 class="text-base font-semibold text-gray-800 mb-3 flex items-center">
              <svg class="w-4 h-4 mr-2 text-ismf-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
              </svg>
              Password
            </h3>
            
            <div class="space-y-3">
              <div>
                <label for="password" class="block text-xs font-medium text-gray-700 mb-1">New Password (optional)</label>
                <%= form.password_field :password, 
                    class: "w-full px-3 py-2 text-sm border-2 border-gray-300 rounded-lg focus:border-ismf-primary focus:ring-2 focus:ring-ismf-primary/20 transition-colors",
                    placeholder: "Min. 8 characters" %>
                <% if @errors&.dig(:password) %>
                  <p class="mt-1 text-xs text-red-600"><%= @errors[:password].join(", ") %></p>
                <% end %>
              </div>
              
              <div>
                <label for="password_confirmation" class="block text-xs font-medium text-gray-700 mb-1">Confirm Password</label>
                <%= form.password_field :password_confirmation, 
                    class: "w-full px-3 py-2 text-sm border-2 border-gray-300 rounded-lg focus:border-ismf-primary focus:ring-2 focus:ring-ismf-primary/20 transition-colors",
                    placeholder: "Re-enter password" %>
                <% if @errors&.dig(:password_confirmation) %>
                  <p class="mt-1 text-xs text-red-600"><%= @errors[:password_confirmation].join(", ") %></p>
                <% end %>
              </div>
            </div>
          </div>

          <!-- PIN Section -->
          <div>
            <h3 class="text-base font-semibold text-gray-800 mb-3 flex items-center">
              <svg class="w-4 h-4 mr-2 text-ismf-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 20l4-16m2 16l4-16M6 9h14M4 15h14" />
              </svg>
              PIN Code
            </h3>
            
            <div class="bg-gray-50 rounded-lg p-3 mb-3">
              <p class="text-xs text-gray-600">
                <% if @user.pin_digest.present? %>
                  ✓ PIN is set
                <% else %>
                  No PIN set
                <% end %>
              </p>
            </div>
            
            <div class="space-y-3">
              <div>
                <label for="pin" class="block text-xs font-medium text-gray-700 mb-1">New PIN (optional)</label>
                <%= form.text_field :pin, 
                    class: "w-full px-3 py-2 text-sm border-2 border-gray-300 rounded-lg focus:border-ismf-primary focus:ring-2 focus:ring-ismf-primary/20 transition-colors font-mono text-base tracking-widest",
                    placeholder: "••••",
                    maxlength: 4,
                    inputmode: "numeric",
                    pattern: "[0-9]*" %>
                <p class="mt-1 text-xs text-gray-500">4 digits</p>
                <% if @errors&.dig(:pin) %>
                  <p class="mt-1 text-xs text-red-600"><%= @errors[:pin].join(", ") %></p>
                <% end %>
              </div>
              
              <div>
                <label for="pin_confirmation" class="block text-xs font-medium text-gray-700 mb-1">Confirm PIN</label>
                <%= form.text_field :pin_confirmation, 
                    class: "w-full px-3 py-2 text-sm border-2 border-gray-300 rounded-lg focus:border-ismf-primary focus:ring-2 focus:ring-ismf-primary/20 transition-colors font-mono text-base tracking-widest",
                    placeholder: "••••",
                    maxlength: 4,
                    inputmode: "numeric",
                    pattern: "[0-9]*" %>
                <% if @errors&.dig(:pin_confirmation) %>
                  <p class="mt-1 text-xs text-red-600"><%= @errors[:pin_confirmation].join(", ") %></p>
                <% end %>
              </div>
            </div>
          </div>
        </div>

        <!-- Actions -->
        <div class="flex gap-3 pt-4 border-t border-gray-200">
          <%= form.submit "Save Changes", 
              class: "flex-1 btn-primary justify-center py-2.5 text-sm font-semibold" %>
          <%= link_to "Cancel", root_path, 
              class: "px-6 py-2.5 border-2 border-gray-300 text-gray-700 text-sm font-semibold rounded-lg hover:bg-gray-50 transition-colors" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
