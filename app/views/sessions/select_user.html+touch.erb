<% content_for :page_title, "Select User" %>

<div class="h-screen flex flex-col items-center justify-center touch-spacing overflow-hidden">
  <!-- User Selection Card -->
  <div class="w-full max-w-4xl bg-white rounded-3xl shadow-2xl touch-spacing-lg">
    <h2 class="text-3xl font-bold text-gray-800 mb-6 text-center">Select Your Profile</h2>
    
    <!-- User Grid -->
    <div class="grid grid-cols-2 gap-4 touch-scrollable-lg">
      <% @users.each do |user| %>
        <%= link_to select_user_session_path(user_id: user.id, redirect_to: params[:redirect_to]), 
            data: { turbo: false },
            class: "touch-btn touch-btn-secondary min-h-[120px] hover:bg-ismf-primary hover:text-white transition-colors" do %>
          <div class="w-16 h-16 bg-white/20 rounded-xl flex items-center justify-center shrink-0">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-10 h-10">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
          </div>
          <div class="flex flex-col items-start flex-1">
            <span class="text-xl font-bold"><%= user.name %></span>
            <span class="text-sm font-medium opacity-70 mt-1">
              <%= user.role&.name&.humanize || "No role" %>
            </span>
          </div>
          <svg class="w-8 h-8 shrink-0 opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
          </svg>
        <% end %>
      <% end %>
    </div>
    
    <!-- Back Button -->
    <div class="mt-6 pt-6 border-t border-gray-200">
      <%= link_to root_path, class: "touch-btn touch-btn-secondary w-full" do %>
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" style="width: 2rem; height: 2rem;">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        <span>Back to Home</span>
      <% end %>
    </div>
  </div>
</div>

<!-- PIN Entry Modal (hidden by default) -->
<% if params[:user_id].present? %>
  <% selected_user = User.find_by(id: params[:user_id]) %>
  <% if selected_user %>
    <div id="pin-modal" class="fixed inset-0 bg-black/50 flex items-center justify-center z-50" onclick="window.location.href='<%= params[:redirect_to].present? ? root_path : select_user_session_path %>'">
      <div class="bg-white rounded-2xl shadow-2xl p-6 w-full max-w-md mx-4" onclick="event.stopPropagation()">
        <h3 class="text-2xl font-bold text-gray-800 mb-1 text-center"><%= selected_user.name %></h3>
        <p class="text-base text-gray-600 mb-4 text-center"><%= selected_user.role&.name&.humanize || "No role" %></p>
        
        <%= form_with url: authenticate_pin_session_path, method: :post, class: "space-y-6", data: { controller: "pin-entry" } do |form| %>
          <%= form.hidden_field :user_id, value: selected_user.id %>
          <%= form.hidden_field :redirect_to, value: params[:redirect_to] if params[:redirect_to].present? %>
          <%= form.hidden_field :pin, value: "", data: { pin_entry_target: "input" } %>
          
          <!-- PIN Display -->
          <div class="mb-4">
            <label class="text-base font-semibold text-gray-700 text-center block mb-3">Enter Your PIN</label>
            <div class="flex justify-center gap-2 mb-4">
              <div class="w-12 h-12 border-3 border-gray-300 rounded-lg flex items-center justify-center bg-white">
                <span class="text-3xl font-bold text-gray-400" data-pin-entry-target="dot1">•</span>
              </div>
              <div class="w-12 h-12 border-3 border-gray-300 rounded-lg flex items-center justify-center bg-white">
                <span class="text-3xl font-bold text-gray-400" data-pin-entry-target="dot2">•</span>
              </div>
              <div class="w-12 h-12 border-3 border-gray-300 rounded-lg flex items-center justify-center bg-white">
                <span class="text-3xl font-bold text-gray-400" data-pin-entry-target="dot3">•</span>
              </div>
              <div class="w-12 h-12 border-3 border-gray-300 rounded-lg flex items-center justify-center bg-white">
                <span class="text-3xl font-bold text-gray-400" data-pin-entry-target="dot4">•</span>
              </div>
            </div>
          </div>
          
          <!-- Numeric Keypad -->
          <div class="grid grid-cols-3 gap-3 max-w-xs mx-auto mb-4">
            <% (1..9).each do |num| %>
              <button type="button" 
                      data-action="click->pin-entry#addDigit" 
                      data-digit="<%= num %>"
                      class="h-16 bg-gradient-to-b from-gray-100 to-gray-200 hover:from-ismf-primary hover:to-ismf-primary/90 hover:text-white border-2 border-gray-300 rounded-xl text-2xl font-bold transition-all duration-150 active:scale-95 shadow-lg">
                <%= num %>
              </button>
            <% end %>
            
            <!-- Empty space -->
            <div></div>
            
            <!-- Zero button -->
            <button type="button" 
                    data-action="click->pin-entry#addDigit" 
                    data-digit="0"
                    class="h-16 bg-gradient-to-b from-gray-100 to-gray-200 hover:from-ismf-primary hover:to-ismf-primary/90 hover:text-white border-2 border-gray-300 rounded-xl text-2xl font-bold transition-all duration-150 active:scale-95 shadow-lg">
              0
            </button>
            
            <!-- Backspace button -->
            <button type="button" 
                    data-action="click->pin-entry#deleteDigit"
                    class="h-16 bg-gradient-to-b from-red-100 to-red-200 hover:from-red-500 hover:to-red-600 hover:text-white border-2 border-red-300 rounded-xl text-xl font-bold transition-all duration-150 active:scale-95 shadow-lg flex items-center justify-center">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2M3 12l6.414 6.414a2 2 0 001.414.586H19a2 2 0 002-2V7a2 2 0 00-2-2h-8.172a2 2 0 00-1.414.586L3 12z" />
              </svg>
            </button>
          </div>
          
          <%= form.hidden_field :submit, value: "true", data: { pin_entry_target: "submit" } %>
        <% end %>
      </div>
    </div>
  <% end %>
<% end %>