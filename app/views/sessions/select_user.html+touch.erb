<% content_for :page_title, "Select User" %>

<div class="h-screen flex flex-col items-center justify-center overflow-hidden bg-gradient-to-br from-ismf-navy via-ismf-blue to-ismf-navy px-8">

  <!-- Header -->
  <div class="mb-8 text-center">
    <%= image_tag "ismf_official_logo.png", alt: "ISMF", class: "h-20 w-auto drop-shadow-xl mb-4" %>
    <h1 class="text-4xl font-bold text-white">Select Your Profile</h1>
  </div>

  <!-- User Grid - 2 columns, fits without scrolling -->
  <div class="w-full max-w-4xl grid grid-cols-2 gap-6 mb-8">
    <% @users.each do |user| %>
      <%= link_to select_user_session_path(user_id: user.id, redirect_to: params[:redirect_to]), 
          data: { turbo: false },
          class: "flex flex-col items-center justify-center p-6 bg-white rounded-2xl shadow-2xl hover:shadow-3xl hover:bg-gray-50 transition-all duration-200 active:scale-95 min-h-[140px]" do %>
        <div class="w-16 h-16 bg-ismf-primary/10 rounded-xl flex items-center justify-center mb-3">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-8 h-8 text-ismf-primary">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
          </svg>
        </div>
        <span class="text-xl font-bold text-gray-800 text-center mb-1"><%= user.name %></span>
        <span class="text-sm text-gray-600">
          <%= user.role&.name&.humanize || "No role" %>
        </span>
      <% end %>
    <% end %>
  </div>

  <!-- Back Button -->
  <%= link_to root_path, 
      class: "flex items-center justify-center gap-3 px-8 py-4 bg-white/20 border-2 border-white rounded-xl hover:bg-white/30 transition-all duration-200 active:scale-95" do %>
    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-6 h-6 text-white">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
    </svg>
    <span class="text-lg font-bold text-white">Back</span>
  <% end %>

  <!-- PIN Entry Modal -->
  <% if params[:user_id].present? %>
    <% selected_user = User.find_by(id: params[:user_id]) %>
    <% if selected_user %>
      <div id="pin-modal" class="fixed inset-0 bg-black/70 flex items-center justify-center z-50" onclick="window.location.href='<%= select_user_session_path(redirect_to: params[:redirect_to]) %>'">
        <div class="bg-white rounded-3xl shadow-2xl p-8 w-full max-w-2xl mx-4" onclick="event.stopPropagation()">
          
          <!-- User Info -->
          <div class="text-center mb-8">
            <div class="w-20 h-20 bg-ismf-primary/10 rounded-full flex items-center justify-center mx-auto mb-4">
              <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-10 h-10 text-ismf-primary">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
              </svg>
            </div>
            <h2 class="text-3xl font-bold text-gray-800 mb-1"><%= selected_user.name %></h2>
            <p class="text-lg text-gray-600"><%= selected_user.role&.name&.humanize || "No role" %></p>
          </div>

          <%= form_with url: authenticate_pin_session_path, method: :post, local: true, data: { controller: "pin-entry" } do |form| %>
            <%= form.hidden_field :user_id, value: selected_user.id %>
            <%= form.hidden_field :redirect_to, value: params[:redirect_to] if params[:redirect_to].present? %>
            <%= form.hidden_field :pin, value: "", data: { pin_entry_target: "input" } %>

            <!-- PIN Display -->
            <div class="mb-8">
              <label class="text-lg font-semibold text-gray-700 text-center block mb-4">Enter Your PIN</label>
              <div class="flex justify-center gap-3">
                <div class="w-16 h-16 border-3 border-gray-300 rounded-lg flex items-center justify-center bg-gray-50">
                  <span class="text-4xl font-bold text-gray-400" data-pin-entry-target="dot1">•</span>
                </div>
                <div class="w-16 h-16 border-3 border-gray-300 rounded-lg flex items-center justify-center bg-gray-50">
                  <span class="text-4xl font-bold text-gray-400" data-pin-entry-target="dot2">•</span>
                </div>
                <div class="w-16 h-16 border-3 border-gray-300 rounded-lg flex items-center justify-center bg-gray-50">
                  <span class="text-4xl font-bold text-gray-400" data-pin-entry-target="dot3">•</span>
                </div>
                <div class="w-16 h-16 border-3 border-gray-300 rounded-lg flex items-center justify-center bg-gray-50">
                  <span class="text-4xl font-bold text-gray-400" data-pin-entry-target="dot4">•</span>
                </div>
              </div>
            </div>

            <!-- Numeric Keypad -->
            <div class="grid grid-cols-3 gap-4 max-w-sm mx-auto mb-8">
              <% (1..9).each do |num| %>
                <button type="button" 
                        data-action="click->pin-entry#addDigit" 
                        data-digit="<%= num %>"
                        class="h-20 bg-gradient-to-b from-gray-100 to-gray-200 hover:from-ismf-primary hover:to-ismf-primary/90 hover:text-white border-2 border-gray-300 rounded-xl text-3xl font-bold transition-all duration-150 active:scale-95 shadow-lg">
                  <%= num %>
                </button>
              <% end %>

              <!-- Empty space -->
              <div></div>

              <!-- Zero button -->
              <button type="button" 
                      data-action="click->pin-entry#addDigit" 
                      data-digit="0"
                      class="h-20 bg-gradient-to-b from-gray-100 to-gray-200 hover:from-ismf-primary hover:to-ismf-primary/90 hover:text-white border-2 border-gray-300 rounded-xl text-3xl font-bold transition-all duration-150 active:scale-95 shadow-lg">
                0
              </button>

              <!-- Backspace button -->
              <button type="button" 
                      data-action="click->pin-entry#deleteDigit"
                      class="h-20 bg-gradient-to-b from-red-100 to-red-200 hover:from-red-500 hover:to-red-600 hover:text-white border-2 border-red-300 rounded-xl text-2xl font-bold transition-all duration-150 active:scale-95 shadow-lg flex items-center justify-center">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2M3 12l6.414 6.414a2 2 0 001.414.586H19a2 2 0 002-2V7a2 2 0 00-2-2h-8.172a2 2 0 00-1.414.586L3 12z" />
                </svg>
              </button>
            </div>

            <!-- Cancel Button -->
            <div class="pt-4">
              <%= link_to "Cancel", select_user_session_path(redirect_to: params[:redirect_to]), 
                  class: "block w-full text-center py-3 text-gray-600 hover:text-gray-800 font-semibold text-lg transition-colors" %>
            </div>

            <%= form.hidden_field :submit, value: "true", data: { pin_entry_target: "submit" } %>
          <% end %>
        </div>
      </div>
    <% end %>
  <% end %>

</div>