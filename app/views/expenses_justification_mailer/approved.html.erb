<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style>
    body {
      font-family: Arial, sans-serif;
      line-height: 1.6;
      color: #333;
      max-width: 600px;
      margin: 0 auto;
      padding: 20px;
    }
    .header {
      background-color: #059669;
      color: white;
      padding: 20px;
      text-align: center;
      border-radius: 5px 5px 0 0;
    }
    .header h1 {
      margin: 0;
      font-size: 24px;
    }
    .success-icon {
      font-size: 48px;
      margin-bottom: 10px;
    }
    .content {
      background-color: #f9fafb;
      padding: 30px;
      border: 1px solid #e5e7eb;
      border-top: none;
    }
    .info-box {
      background-color: white;
      border: 1px solid #e5e7eb;
      border-radius: 5px;
      padding: 15px;
      margin: 15px 0;
    }
    .info-row {
      display: flex;
      justify-content: space-between;
      padding: 8px 0;
      border-bottom: 1px solid #f3f4f6;
    }
    .info-row:last-child {
      border-bottom: none;
    }
    .label {
      font-weight: bold;
      color: #6b7280;
    }
    .value {
      color: #111827;
    }
    .amount {
      font-size: 1.5em;
      font-weight: bold;
      color: #059669;
      text-align: center;
      padding: 15px;
      background-color: #d1fae5;
      border-radius: 5px;
      margin: 20px 0;
    }
    .alert-success {
      background-color: #d1fae5;
      border-left: 4px solid #059669;
      padding: 15px;
      margin: 20px 0;
      border-radius: 5px;
    }
    .button {
      display: inline-block;
      background-color: #2563eb;
      color: white;
      text-decoration: none;
      padding: 12px 24px;
      border-radius: 5px;
      margin: 20px 0;
      text-align: center;
    }
    .footer {
      text-align: center;
      color: #6b7280;
      font-size: 0.875em;
      margin-top: 30px;
      padding-top: 20px;
      border-top: 1px solid #e5e7eb;
    }
    .bank-info {
      background-color: #fef3c7;
      border: 1px solid #fbbf24;
      border-radius: 5px;
      padding: 15px;
      margin: 20px 0;
    }
  </style>
</head>
<body>
  <div class="header">
    <div class="success-icon">✓</div>
    <h1>Expense Justification Approved</h1>
  </div>

  <div class="content">
    <p>Dear <%= @user.name %>,</p>

    <div class="alert-success">
      <strong>Good news!</strong> Your expense justification has been approved by ISMF staff.
    </div>

    <div class="info-box">
      <h3 style="margin-top: 0;">Expense Details</h3>
      <div class="info-row">
        <span class="label">Competition:</span>
        <span class="value"><%= @competition.name %></span>
      </div>
      <div class="info-row">
        <span class="label">Reason of Travel:</span>
        <span class="value"><%= @expenses_justification.reason_of_travel %></span>
      </div>
      <div class="info-row">
        <span class="label">Travel Period:</span>
        <span class="value">
          <%= @expenses_justification.travel_start_date.strftime("%d/%m/%Y") %> - 
          <%= @expenses_justification.travel_end_date.strftime("%d/%m/%Y") %>
        </span>
      </div>
      <div class="info-row">
        <span class="label">Approved By:</span>
        <span class="value"><%= @approved_by.name %></span>
      </div>
      <div class="info-row">
        <span class="label">Approved On:</span>
        <span class="value"><%= @expenses_justification.approved_at.strftime("%d/%m/%Y at %H:%M") %></span>
      </div>
    </div>

    <div class="amount">
      Approved Amount: € <%= number_with_precision(@expenses_justification.total_amount, precision: 2) %>
    </div>

    <div class="bank-info">
      <h4 style="margin-top: 0; color: #92400e;">💳 Payment Information</h4>
      <p style="margin: 0; color: #78350f;">
        The reimbursement will be transferred to your bank account:<br>
        <strong>IBAN:</strong> <%= @expenses_justification.bank_iban %><br>
        <strong>SWIFT:</strong> <%= @expenses_justification.bank_swift %>
      </p>
      <p style="margin-top: 10px; font-size: 0.875em; color: #78350f;">
        Please allow 5-10 business days for the payment to be processed and reflected in your account.
      </p>
    </div>

    <div style="text-align: center;">
      <%= link_to "View Expense Justification", 
          expenses_justification_url(@expenses_justification, host: ENV.fetch("APP_HOST", "localhost:3005")),
          class: "button" %>
    </div>

    <p style="margin-top: 30px; font-size: 0.875em; color: #6b7280;">
      <strong>What happens next?</strong><br>
      • Your expense justification has been approved and is now in the payment queue<br>
      • You will receive the reimbursement via bank transfer within 5-10 business days<br>
      • You can track the payment status in your dashboard<br>
      • If you have any questions, please contact ISMF administration
    </p>
  </div>

  <div class="footer">
    <p>
      This is an automated email from the ISMF Race Logger system.<br>
      If you have questions about your reimbursement, please contact ISMF administration.
    </p>
  </div>
</body>
</html>