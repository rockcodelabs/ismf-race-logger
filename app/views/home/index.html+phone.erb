<%# frozen_string_literal: true %>
<% content_for :page_title, "ISMF Race Logger" %>

<div class="h-screen overflow-hidden flex flex-col bg-gradient-to-br from-ismf-navy via-ismf-blue to-ismf-navy">
  
  <!-- Main Content - Centered -->
  <div class="flex-1 flex flex-col items-center justify-center px-6">
    
    <!-- Logo -->
    <div class="mb-8">
      <%= image_tag "ismf_official_logo.png", alt: "ISMF", class: "h-24 w-auto" %>
    </div>
    
    <!-- Title -->
    <h1 class="text-3xl font-bold text-white mb-2 text-center">
      Race Logger
    </h1>
    <p class="text-sm text-white/60 mb-12 text-center">
      Incident Management System
    </p>
    
    <!-- Action Buttons -->
    <div class="w-full max-w-sm flex flex-col gap-3">
      
      <!-- Competition Button (if available) -->
      <% if @closest_competition %>
        <% competition_path = admin_competition_path(@closest_competition.id) %>
        
        <%= link_to competition_path, class: "flex flex-col items-center justify-center bg-white text-ismf-navy rounded-xl px-6 py-4 active:scale-95 transition-transform shadow-lg font-bold" do %>
          <span class="text-lg"><%= @closest_competition.display_name %></span>
          <span class="text-xs font-semibold mt-1 text-ismf-blue">
            <% if @closest_competition.ongoing? %>
              🟢 Live Now
            <% else %>
              <%= @closest_competition.days_until_start %> days away
            <% end %>
          </span>
        <% end %>
      <% end %>
      
      <!-- All Competitions (Admin only) -->
      <% if Current.user&.admin? %>
        <%= link_to admin_competitions_path, class: "flex items-center justify-center bg-white/20 text-white rounded-xl px-6 py-3.5 active:scale-95 transition-transform border border-white/30 font-semibold" do %>
          All Competitions
        <% end %>
      <% end %>
      
      <!-- Sign In Button (if not signed in) -->
      <% unless Current.user %>
        <%= link_to new_session_path, class: "flex items-center justify-center bg-ismf-orange text-white rounded-xl px-6 py-3.5 active:scale-95 transition-transform shadow-lg font-semibold" do %>
          Sign In
        <% end %>
      <% end %>
      
    </div>
  </div>

</div>