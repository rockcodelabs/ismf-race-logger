<div class="h-screen overflow-hidden flex flex-col bg-gradient-to-br from-ismf-navy via-ismf-blue to-ismf-navy">
  
  <!-- Main Content - Centered -->
  <div class="flex-1 flex flex-col items-center justify-center px-6">
    
    <!-- Logo -->
    <div class="mb-6">
      <%= image_tag "ismf_official_logo.png", alt: "ISMF", class: "h-20 w-auto" %>
    </div>
    
    <!-- Title -->
    <h1 class="text-2xl font-bold text-white mb-1 text-center">
      ISMF Race Logger
    </h1>
    <p class="text-base text-white/70 mb-8 text-center">
      Race Incident Management
    </p>
    
    <!-- Action Buttons -->
    <div class="w-full max-w-sm flex flex-col gap-4">
      
      <!-- Competition Button (if available) -->
      <% if @closest_competition %>
        <% competition_path = admin_competition_path(@closest_competition.id) %>
        <% button_path = Current.user ? competition_path : select_user_session_path(redirect_to: competition_path) %>
        
        <%= link_to button_path, class: "flex flex-col items-center justify-center bg-white text-ismf-navy rounded-xl px-6 py-4 active:scale-95 transition-transform shadow-lg" do %>
          <span class="text-lg font-bold text-center"><%= @closest_competition.display_name %></span>
          <span class="text-sm font-semibold mt-1">
            <% if @closest_competition.ongoing? %>
              🟢 Live Now
            <% else %>
              <%= @closest_competition.days_until_start %> days away
            <% end %>
          </span>
        <% end %>
      <% end %>
      
      <!-- All Competitions (Admin only) -->
      <% if Current.user&.admin? %>
        <%= link_to admin_competitions_path, class: "flex items-center justify-center bg-white/20 text-white rounded-xl px-6 py-4 active:scale-95 transition-transform border border-white/30" do %>
          <span class="text-base font-semibold">All Competitions</span>
        <% end %>
      <% end %>
      
      <!-- Sign In Button (if not signed in) -->
      <% unless Current.user %>
        <%= link_to new_session_path, class: "flex items-center justify-center bg-ismf-orange text-white rounded-xl px-6 py-4 active:scale-95 transition-transform shadow-lg" do %>
          <span class="text-base font-semibold">Sign In</span>
        <% end %>
      <% end %>
      
    </div>
  </div>
  
  <!-- Footer -->
  <div class="shrink-0 px-6 pb-6">
    
    <!-- User Info & Sign Out (if signed in) -->
    <% if Current.user %>
      <div class="flex items-center justify-between bg-white/10 rounded-xl px-4 py-3 mb-4">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 bg-white/20 rounded-full flex items-center justify-center">
            <span class="text-white font-bold text-sm">
              <%= Current.user.name.to_s.chars.first&.upcase || "U" %>
            </span>
          </div>
          <div>
            <p class="text-white font-semibold text-sm"><%= Current.user.name %></p>
            <% if Current.user.admin? %>
              <p class="text-white/60 text-xs">Administrator</p>
            <% end %>
          </div>
        </div>
        <%= button_to session_path, method: :delete, class: "text-white/70 text-sm font-medium active:scale-95 transition-transform px-3 py-2" do %>
          Sign Out
        <% end %>
      </div>
    <% end %>
    
    <!-- Copyright -->
    <p class="text-white/40 text-xs text-center">
      ISMF © <%= Date.current.year %>
    </p>
    
  </div>
  
</div>