<!-- Trip Details -->
<div class="bg-white shadow rounded-lg overflow-hidden">
  <div class="px-6 py-4 border-b border-gray-200 bg-gray-50">
    <h2 class="text-lg font-semibold text-gray-900">Trip Details</h2>
  </div>
  <div class="px-6 py-4 space-y-4">
    <div>
      <%= f.label :reason_of_travel, "Reason of Travel (Race Name/Meeting)", class: "block text-sm font-medium text-gray-700" %>
      <%= f.text_field :reason_of_travel, 
          class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500", 
          placeholder: "WC Schladming 2024",
          required: true %>
      <p class="mt-1 text-xs text-gray-500">The name of the race or meeting you attended</p>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <div>
        <%= f.label :charged_of, "Charged Of (Role)", class: "block text-sm font-medium text-gray-700" %>
        <%= f.text_field :charged_of, 
            class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500", 
            placeholder: "VAR Referee" %>
        <p class="mt-1 text-xs text-gray-500">Your role at the event</p>
      </div>
      <div>
        <%= f.label :place, class: "block text-sm font-medium text-gray-700" %>
        <%= f.text_field :place, 
            class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500", 
            placeholder: "Schladming" %>
        <p class="mt-1 text-xs text-gray-500">City or venue</p>
      </div>
      <div>
        <%= f.label :country, class: "block text-sm font-medium text-gray-700" %>
        <%= f.text_field :country, 
            class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500", 
            placeholder: "Austria" %>
        <p class="mt-1 text-xs text-gray-500">Country</p>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <div>
        <%= f.label :travel_start_date, "Travel Start Date", class: "block text-sm font-medium text-gray-700" %>
        <%= f.date_field :travel_start_date, 
            class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500", 
            required: true %>
      </div>
      <div>
        <%= f.label :travel_end_date, "Travel End Date", class: "block text-sm font-medium text-gray-700" %>
        <%= f.date_field :travel_end_date, 
            class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500", 
            required: true %>
      </div>
      <div>
        <%= f.label :travel_days, "Number of Days", class: "block text-sm font-medium text-gray-700" %>
        <%= f.number_field :travel_days, 
            class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500", 
            min: 1,
            required: true %>
        <p class="mt-1 text-xs text-gray-500">Total days of travel</p>
      </div>
    </div>
  </div>
</div>