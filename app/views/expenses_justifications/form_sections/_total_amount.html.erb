<!-- Total Amount -->
<div class="bg-white shadow rounded-lg overflow-hidden">
  <div class="px-6 py-4 border-b border-gray-200 bg-gray-50">
    <h2 class="text-lg font-semibold text-gray-900">Total Amount</h2>
  </div>
  <div class="px-6 py-4">
    <div>
      <%= f.label :total_amount, "Total Amount (€)", class: "block text-sm font-medium text-gray-700" %>
      <div class="mt-1 relative rounded-md shadow-sm">
        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
          <span class="text-gray-500 sm:text-sm">€</span>
        </div>
        <%= f.number_field :total_amount, 
            step: 0.01, 
            min: 0,
            class: "pl-7 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500", 
            placeholder: "694.50",
            required: true %>
      </div>
      <p class="mt-1 text-xs text-gray-500">Enter the total reimbursement amount in Euros (e.g., 694.50)</p>
    </div>
  </div>
</div>