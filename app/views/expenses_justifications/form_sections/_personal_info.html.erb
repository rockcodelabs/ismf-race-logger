<!-- Personal Information -->
<div class="bg-white shadow rounded-lg overflow-hidden">
  <div class="px-6 py-4 border-b border-gray-200 bg-gray-50">
    <h2 class="text-lg font-semibold text-gray-900">Personal Information</h2>
    <p class="text-sm text-gray-600 mt-1">Auto-filled from your profile. You can modify if needed.</p>
  </div>
  <div class="px-6 py-4 space-y-4">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <%= f.label :name, class: "block text-sm font-medium text-gray-700" %>
        <%= f.text_field :name, 
            class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500", 
            required: true,
            placeholder: "Full Name" %>
      </div>
      <div>
        <%= f.label :identity_document_number, "Identity Document Number", class: "block text-sm font-medium text-gray-700" %>
        <%= f.text_field :identity_document_number, 
            class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500", 
            required: true,
            placeholder: "CAR636482" %>
      </div>
    </div>
    <div>
      <%= f.label :address, class: "block text-sm font-medium text-gray-700" %>
      <%= f.text_area :address, 
          rows: 3, 
          class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500", 
          required: true,
          placeholder: "Street Address, Postal Code, City, Country" %>
    </div>
  </div>
</div>