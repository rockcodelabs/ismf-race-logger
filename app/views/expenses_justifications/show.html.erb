<% part = @parts_factory.wrap(@expenses_justification) %>

<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <!-- Back button -->
  <div class="mb-6">
    <%= link_to expenses_justifications_path, class: "inline-flex items-center text-sm font-medium text-gray-700 hover:text-gray-900" do %>
      <svg class="mr-2 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
      </svg>
      Back to list
    <% end %>
  </div>

  <!-- Page header -->
  <div class="mb-8">
    <div class="flex items-start justify-between">
      <div>
        <h1 class="text-3xl font-bold text-gray-900">Expense Justification</h1>
        <p class="mt-2 text-sm text-gray-600">
          <%= @expenses_justification.competition_name || "Competition ##{@expenses_justification.competition_id}" %>
        </p>
      </div>
      <div class="flex flex-col items-end gap-2">
        <%= part.status_badge %>
        <% if @expenses_justification.approved? %>
          <%= part.paid_badge %>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Main content -->
  <div class="space-y-6">
    <!-- Personal Information -->
    <div class="bg-white shadow rounded-lg overflow-hidden">
      <div class="px-6 py-4 border-b border-gray-200 bg-gray-50">
        <h2 class="text-lg font-semibold text-gray-900">Personal Information</h2>
      </div>
      <div class="px-6 py-4 space-y-4">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-gray-700">Name</label>
            <p class="mt-1 text-sm text-gray-900"><%= @expenses_justification.name %></p>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700">Identity Document Number</label>
            <p class="mt-1 text-sm text-gray-900"><%= @expenses_justification.identity_document_number %></p>
          </div>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700">Address</label>
          <p class="mt-1 text-sm text-gray-900 whitespace-pre-wrap"><%= @expenses_justification.address %></p>
        </div>
      </div>
    </div>

    <!-- Bank Information -->
    <div class="bg-white shadow rounded-lg overflow-hidden">
      <div class="px-6 py-4 border-b border-gray-200 bg-gray-50">
        <h2 class="text-lg font-semibold text-gray-900">Bank Information</h2>
      </div>
      <div class="px-6 py-4 space-y-4">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-gray-700">SWIFT/BIC</label>
            <p class="mt-1 text-sm text-gray-900 font-mono"><%= @expenses_justification.bank_swift %></p>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700">IBAN</label>
            <p class="mt-1 text-sm text-gray-900 font-mono"><%= @expenses_justification.bank_iban %></p>
          </div>
        </div>
      </div>
    </div>

    <!-- Trip Details -->
    <div class="bg-white shadow rounded-lg overflow-hidden">
      <div class="px-6 py-4 border-b border-gray-200 bg-gray-50">
        <h2 class="text-lg font-semibold text-gray-900">Trip Details</h2>
      </div>
      <div class="px-6 py-4 space-y-4">
        <div>
          <label class="block text-sm font-medium text-gray-700">Reason of Travel</label>
          <p class="mt-1 text-sm text-gray-900"><%= @expenses_justification.reason_of_travel %></p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <div>
            <label class="block text-sm font-medium text-gray-700">Charged Of</label>
            <p class="mt-1 text-sm text-gray-900"><%= @expenses_justification.charged_of || "N/A" %></p>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700">Place</label>
            <p class="mt-1 text-sm text-gray-900"><%= @expenses_justification.place || "N/A" %></p>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700">Country</label>
            <p class="mt-1 text-sm text-gray-900"><%= @expenses_justification.country || "N/A" %></p>
          </div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <div>
            <label class="block text-sm font-medium text-gray-700">Travel Start Date</label>
            <p class="mt-1 text-sm text-gray-900"><%= @expenses_justification.travel_start_date.strftime("%d/%m/%Y") %></p>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700">Travel End Date</label>
            <p class="mt-1 text-sm text-gray-900"><%= @expenses_justification.travel_end_date.strftime("%d/%m/%Y") %></p>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700">Days</label>
            <p class="mt-1 text-sm text-gray-900"><%= @expenses_justification.travel_days %></p>
          </div>
        </div>
      </div>
    </div>

    <!-- Expenses Breakdown -->
    <div class="bg-white shadow rounded-lg overflow-hidden">
      <div class="px-6 py-4 border-b border-gray-200 bg-gray-50">
        <h2 class="text-lg font-semibold text-gray-900">Expenses Breakdown</h2>
      </div>
      <div class="px-6 py-4">
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-gray-200">
            <thead>
              <tr>
                <th class="px-3 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Category</th>
                <th class="px-3 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Description</th>
                <th class="px-3 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Amount</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200">
              <% if @expenses_justification.regular_transport.present? && @expenses_justification.regular_transport.any? %>
                <tr>
                  <td class="px-3 py-4 text-sm font-medium text-gray-900">Regular Transport</td>
                  <td class="px-3 py-4 text-sm text-gray-600"><%= @expenses_justification.regular_transport.to_json %></td>
                  <td class="px-3 py-4 text-sm text-gray-900 text-right">€ <%= number_with_precision(@expenses_justification.regular_transport['amount'] || 0, precision: 2) %></td>
                </tr>
              <% end %>
              <% if @expenses_justification.private_vehicle.present? && @expenses_justification.private_vehicle.any? %>
                <tr>
                  <td class="px-3 py-4 text-sm font-medium text-gray-900">Private Vehicle</td>
                  <td class="px-3 py-4 text-sm text-gray-600"><%= @expenses_justification.private_vehicle.to_json %></td>
                  <td class="px-3 py-4 text-sm text-gray-900 text-right">€ <%= number_with_precision(@expenses_justification.private_vehicle['amount'] || 0, precision: 2) %></td>
                </tr>
              <% end %>
              <% if @expenses_justification.car_rental.present? && @expenses_justification.car_rental.any? %>
                <tr>
                  <td class="px-3 py-4 text-sm font-medium text-gray-900">Car Rental</td>
                  <td class="px-3 py-4 text-sm text-gray-600"><%= @expenses_justification.car_rental.to_json %></td>
                  <td class="px-3 py-4 text-sm text-gray-900 text-right">€ <%= number_with_precision(@expenses_justification.car_rental['amount'] || 0, precision: 2) %></td>
                </tr>
              <% end %>
              <% if @expenses_justification.other_travelling.present? && @expenses_justification.other_travelling.any? %>
                <tr>
                  <td class="px-3 py-4 text-sm font-medium text-gray-900">Other Travelling</td>
                  <td class="px-3 py-4 text-sm text-gray-600"><%= @expenses_justification.other_travelling.to_json %></td>
                  <td class="px-3 py-4 text-sm text-gray-900 text-right">€ <%= number_with_precision(@expenses_justification.other_travelling['amount'] || 0, precision: 2) %></td>
                </tr>
              <% end %>
              <% if @expenses_justification.allowances.present? && @expenses_justification.allowances.any? %>
                <tr>
                  <td class="px-3 py-4 text-sm font-medium text-gray-900">Allowances</td>
                  <td class="px-3 py-4 text-sm text-gray-600"><%= @expenses_justification.allowances.to_json %></td>
                  <td class="px-3 py-4 text-sm text-gray-900 text-right">€ <%= number_with_precision(@expenses_justification.allowances['amount'] || 0, precision: 2) %></td>
                </tr>
              <% end %>
              <% if @expenses_justification.accommodation.present? && @expenses_justification.accommodation.any? %>
                <tr>
                  <td class="px-3 py-4 text-sm font-medium text-gray-900">Accommodation</td>
                  <td class="px-3 py-4 text-sm text-gray-600"><%= @expenses_justification.accommodation.to_json %></td>
                  <td class="px-3 py-4 text-sm text-gray-900 text-right">€ <%= number_with_precision(@expenses_justification.accommodation['amount'] || 0, precision: 2) %></td>
                </tr>
              <% end %>
              <% if @expenses_justification.special_expenses.present? && @expenses_justification.special_expenses.any? %>
                <tr>
                  <td class="px-3 py-4 text-sm font-medium text-gray-900">Special Expenses</td>
                  <td class="px-3 py-4 text-sm text-gray-600"><%= @expenses_justification.special_expenses.to_json %></td>
                  <td class="px-3 py-4 text-sm text-gray-900 text-right">€ <%= number_with_precision(@expenses_justification.special_expenses['amount'] || 0, precision: 2) %></td>
                </tr>
              <% end %>
            </tbody>
            <tfoot class="bg-gray-50">
              <tr>
                <td colspan="2" class="px-3 py-4 text-sm font-bold text-gray-900">Total Amount</td>
                <td class="px-3 py-4 text-sm font-bold text-gray-900 text-right"><%= part.total_amount_badge %></td>
              </tr>
            </tfoot>
          </table>
        </div>
      </div>
    </div>

    <!-- Invoices -->
    <div class="bg-white shadow rounded-lg overflow-hidden">
      <div class="px-6 py-4 border-b border-gray-200 bg-gray-50 flex items-center justify-between">
        <h2 class="text-lg font-semibold text-gray-900">Invoices</h2>
        <%= part.invoice_count_badge %>
      </div>
      <div class="px-6 py-4">
        <% if @expenses_justification.invoices.present? && @expenses_justification.invoices.any? %>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            <% @expenses_justification.invoices.each do |invoice| %>
              <div class="border border-gray-200 rounded-lg p-4 hover:shadow-md transition-shadow">
                <div class="flex items-center justify-between">
                  <div class="flex items-center">
                    <svg class="h-10 w-10 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
                    </svg>
                    <div class="ml-3">
                      <p class="text-sm font-medium text-gray-900 truncate"><%= invoice.filename %></p>
                      <p class="text-xs text-gray-500"><%= number_to_human_size(invoice.byte_size) %></p>
                    </div>
                  </div>
                </div>
                <div class="mt-4">
                  <%= link_to rails_blob_path(invoice, disposition: "attachment"), class: "text-xs text-blue-600 hover:text-blue-800 font-medium" do %>
                    Download
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        <% else %>
          <p class="text-sm text-gray-500 text-center py-8">No invoices uploaded yet.</p>
        <% end %>
      </div>
    </div>

    <!-- Timeline -->
    <div class="bg-white shadow rounded-lg overflow-hidden">
      <div class="px-6 py-4 border-b border-gray-200 bg-gray-50">
        <h2 class="text-lg font-semibold text-gray-900">Timeline</h2>
      </div>
      <div class="px-6 py-4">
        <%= part.timeline_display %>
      </div>
    </div>

    <!-- Rejection Reason -->
    <% if @expenses_justification.rejected? && @expenses_justification.rejection_reason.present? %>
      <%= part.rejection_reason_display %>
    <% end %>

    <!-- Actions -->
    <div class="flex flex-wrap gap-3">
      <% actions = part.action_buttons(current_user: Current.user, policy: policy(@expenses_justification_record)) %>
      
      <% if actions[:can_update] %>
        <%= link_to "Edit", 
            edit_expenses_justification_path(@expenses_justification.id), 
            class: "inline-flex items-center px-3 py-2 border border-gray-300 shadow-sm text-sm leading-4 font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" %>
      <% end %>
      
      <% if actions[:can_submit] %>
        <%= button_to "Submit for Approval", 
            submit_expenses_justification_path(@expenses_justification.id), 
            method: :patch,
            data: { turbo_confirm: "Are you sure you want to submit this expense justification for approval?" },
            class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" %>
      <% end %>
      
      <% if actions[:can_destroy] %>
        <%= button_to "Delete", 
            expenses_justification_path(@expenses_justification.id), 
            method: :delete,
            data: { turbo_confirm: "Are you sure you want to delete this expense justification?" },
            class: "inline-flex items-center px-3 py-2 border border-red-300 shadow-sm text-sm leading-4 font-medium rounded-md text-red-700 bg-white hover:bg-red-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500" %>
      <% end %>
    </div>
  </div>
</div>

<%= turbo_stream_from "expenses_justifications:user_#{Current.user.id}" %>