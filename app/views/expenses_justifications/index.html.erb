<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <!-- Page header -->
  <div class="mb-8">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-3xl font-bold text-gray-900">My Expense Justifications</h1>
        <p class="mt-2 text-sm text-gray-600">
          Manage your competition expense reimbursement requests
        </p>
      </div>
      <%= link_to new_expenses_justification_path, class: "inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" do %>
        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
        </svg>
        New Expense Justification
      <% end %>
    </div>
  </div>

  <!-- Status filter tabs -->
  <div class="mb-6">
    <div class="border-b border-gray-200">
      <nav class="-mb-px flex space-x-8">
        <%= link_to expenses_justifications_path, 
            class: "#{params[:status].blank? ? 'border-blue-500 text-blue-600' : 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300'} whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm" do %>
          All
          <span class="ml-2 py-0.5 px-2 rounded-full text-xs <%= params[:status].blank? ? 'bg-blue-100 text-blue-600' : 'bg-gray-100 text-gray-900' %>">
            <%= @expenses_justifications.count %>
          </span>
        <% end %>

        <%= link_to expenses_justifications_path(status: 'draft'), 
            class: "#{params[:status] == 'draft' ? 'border-gray-500 text-gray-600' : 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300'} whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm" do %>
          Drafts
          <span class="ml-2 py-0.5 px-2 rounded-full text-xs <%= params[:status] == 'draft' ? 'bg-gray-100 text-gray-900' : 'bg-gray-100 text-gray-900' %>">
            <%= @expenses_justifications.count { |ej| ej.status == 'draft' } %>
          </span>
        <% end %>

        <%= link_to expenses_justifications_path(status: 'sent'), 
            class: "#{params[:status] == 'sent' ? 'border-blue-500 text-blue-600' : 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300'} whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm" do %>
          Submitted
          <span class="ml-2 py-0.5 px-2 rounded-full text-xs <%= params[:status] == 'sent' ? 'bg-blue-100 text-blue-600' : 'bg-gray-100 text-gray-900' %>">
            <%= @expenses_justifications.count { |ej| ej.status == 'sent' } %>
          </span>
        <% end %>

        <%= link_to expenses_justifications_path(status: 'approved'), 
            class: "#{params[:status] == 'approved' ? 'border-green-500 text-green-600' : 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300'} whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm" do %>
          Approved
          <span class="ml-2 py-0.5 px-2 rounded-full text-xs <%= params[:status] == 'approved' ? 'bg-green-100 text-green-600' : 'bg-gray-100 text-gray-900' %>">
            <%= @expenses_justifications.count { |ej| ej.status == 'approved' } %>
          </span>
        <% end %>

        <%= link_to expenses_justifications_path(status: 'rejected'), 
            class: "#{params[:status] == 'rejected' ? 'border-red-500 text-red-600' : 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300'} whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm" do %>
          Rejected
          <span class="ml-2 py-0.5 px-2 rounded-full text-xs <%= params[:status] == 'rejected' ? 'bg-red-100 text-red-600' : 'bg-gray-100 text-gray-900' %>">
            <%= @expenses_justifications.count { |ej| ej.status == 'rejected' } %>
          </span>
        <% end %>
      </nav>
    </div>
  </div>

  <!-- Expenses list -->
  <div id="expenses_justifications" class="space-y-4">
    <% if @expenses_justifications.any? %>
      <% @expenses_justifications.each do |expenses_justification| %>
        <% part = @parts_factory.wrap(expenses_justification) %>
        <div id="<%= part.dom_id %>" class="bg-white shadow rounded-lg overflow-hidden hover:shadow-md transition-shadow">
          <div class="p-6">
            <div class="flex items-start justify-between">
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-3 mb-2">
                  <h3 class="text-lg font-semibold text-gray-900 truncate">
                    <%= expenses_justification.competition_name || "Competition ##{expenses_justification.competition_id}" %>
                  </h3>
                  <%= part.status_badge %>
                  <% if expenses_justification.approved? %>
                    <%= part.paid_badge %>
                  <% end %>
                </div>

                <div class="mt-2 flex items-center text-sm text-gray-600">
                  <svg class="flex-shrink-0 mr-1.5 h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                  </svg>
                  <%= expenses_justification.name %>
                </div>

                <div class="mt-1 flex items-center text-sm text-gray-600">
                  <svg class="flex-shrink-0 mr-1.5 h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                  <%= expenses_justification.travel_period %>
                  <span class="mx-2">•</span>
                  <%= expenses_justification.days_display %>
                </div>

                <div class="mt-1 flex items-center text-sm text-gray-600">
                  <svg class="flex-shrink-0 mr-1.5 h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  <%= part.total_amount_badge %>
                </div>

                <% if expenses_justification.rejected? && expenses_justification.rejection_reason.present? %>
                  <div class="mt-3 p-3 bg-red-50 border border-red-200 rounded-md">
                    <p class="text-sm text-red-800">
                      <span class="font-semibold">Rejection reason:</span>
                      <%= expenses_justification.rejection_reason %>
                    </p>
                  </div>
                <% end %>
              </div>

              <div class="ml-4 flex-shrink-0">
                <%= link_to expenses_justification_path(expenses_justification.id), class: "inline-flex items-center px-3 py-2 border border-gray-300 shadow-sm text-sm leading-4 font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" do %>
                  View Details
                  <svg class="ml-2 -mr-0.5 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                <% end %>
              </div>
            </div>

            <!-- Quick actions for drafts -->
            <% if expenses_justification.draft? %>
              <div class="mt-4 pt-4 border-t border-gray-200 flex gap-2">
                <%= link_to edit_expenses_justification_path(expenses_justification.id), class: "inline-flex items-center px-3 py-1.5 border border-gray-300 shadow-sm text-xs font-medium rounded text-gray-700 bg-white hover:bg-gray-50" do %>
                  <svg class="mr-1.5 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                  </svg>
                  Edit
                <% end %>
                <%= button_to submit_expenses_justification_path(expenses_justification.id), method: :patch, data: { turbo_confirm: "Submit this expense justification for approval?" }, class: "inline-flex items-center px-3 py-1.5 border border-transparent shadow-sm text-xs font-medium rounded text-white bg-blue-600 hover:bg-blue-700" do %>
                  <svg class="mr-1.5 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  Submit
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    <% else %>
      <!-- Empty state -->
      <div class="text-center py-12 bg-white rounded-lg shadow">
        <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
        <h3 class="mt-2 text-sm font-medium text-gray-900">No expense justifications</h3>
        <p class="mt-1 text-sm text-gray-500">
          Get started by creating a new expense justification.
        </p>
        <div class="mt-6">
          <%= link_to new_expenses_justification_path, class: "inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700" do %>
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
            </svg>
            New Expense Justification
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>

<%= turbo_stream_from "expenses_justifications:user_#{Current.user.id}" %>