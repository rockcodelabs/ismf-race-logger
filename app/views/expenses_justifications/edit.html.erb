<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <!-- Back button -->
  <div class="mb-6">
    <%= link_to expenses_justification_path(@expenses_justification.id), class: "inline-flex items-center text-sm font-medium text-gray-700 hover:text-gray-900" do %>
      <svg class="mr-2 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
      </svg>
      Back to expense
    <% end %>
  </div>

  <!-- Page header -->
  <div class="mb-8">
    <h1 class="text-3xl font-bold text-gray-900">Edit Expense Justification</h1>
    <p class="mt-2 text-sm text-gray-600">
      Update your expense reimbursement request details.
    </p>
  </div>

  <!-- Form -->
  <%= render "form", 
      expenses_justification: @expenses_justification,
      form_url: expenses_justification_path(@expenses_justification.id),
      form_method: :patch,
      submit_label: "Update Expense Justification" %>
</div>